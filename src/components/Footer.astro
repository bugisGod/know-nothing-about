---
import { SITE } from '../config';

const year = new Date().getFullYear();
const range = year > SITE.since ? `${SITE.since} – ${year}` : `${SITE.since}`;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span class="wordmark">{SITE.title}<span class="logo-dot" aria-hidden="true">.</span></span>
    <span class="footer-meta">© {range} {SITE.author}</span>
  </div>
</footer>

<style>
  .logo-dot {
    color: var(--accent);
  }
</style>
