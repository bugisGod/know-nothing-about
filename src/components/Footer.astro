---
import Icon from './Icon.astro';
import { SITE } from '../config';

const year = new Date().getFullYear();
const range = year > SITE.since ? `${SITE.since} – ${year}` : `${SITE.since}`;
const ICP = '苏ICP备2026841369678号';
---

<footer class="site-footer">
  <div class="container footer-inner">
    {
      SITE.socials.map((s) => (
        <a
          class="foot-social"
          href={s.url}
          target={s.url.startsWith('http') ? '_blank' : undefined}
          rel="noopener"
          aria-label={s.label}
          title={s.label}
        >
          <Icon name={s.icon} size={15} />
        </a>
      ))
    }
    <span class="foot-sep" aria-hidden="true">·</span>
    <span class="footer-meta">© {range} {SITE.author}</span>
    <span class="foot-sep" aria-hidden="true">·</span>
    <a
      class="footer-meta beian"
      href="https://beian.miit.gov.cn/"
      target="_blank"
      rel="noopener noreferrer"
    >
      {ICP}
    </a>
  </div>
</footer>

<style>
  .foot-social {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: var(--muted);
  }

  .foot-social:hover {
    color: var(--text);
  }

  .foot-sep {
    color: var(--muted);
  }

  .beian {
    text-decoration: none;
  }

  .beian:hover {
    color: var(--text);
  }
</style>
