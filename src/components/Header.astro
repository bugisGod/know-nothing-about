---
import { SITE } from '../config';

const nav = [
  { href: '/', label: '首页' },
  { href: '/notes/', label: '知识库' },
  { href: '/projects/', label: '项目' },
  { href: '/search/', label: '搜索' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/">{SITE.title}<span class="logo-dot" aria-hidden="true">.</span></a>
    <nav>
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class:list={[{ active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .logo-dot {
    color: var(--accent);
  }
</style>
