---
interface Props {
  compact?: boolean;
  reading?: boolean;
}
const { compact = false, reading = false } = Astro.props;
---

<header class:list={["sky-band", { compact, reading }]}>
  <div class="container">
    <slot />
  </div>
</header>
<style>
  .sky-band {
    padding: 68px 0 42px;
  }
  .sky-band.compact {
    padding-top: 48px;
  }
  .sky-band.reading .container {
    max-width: 1040px;
  }
  .sky-band :global(h1) {
    max-width: 740px;
    /* ★ 与知识库页标题同一标准（无衬线粗体大字号），全站页头一致 */
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.1;
    margin: 14px 0 18px;
    letter-spacing: 0.04em;
    text-wrap: balance;
  }
  .sky-band :global(.page-desc) {
    margin-bottom: 0;
  }
  @media (max-width: 760px) {
    .sky-band,
    .sky-band.compact {
      padding: 32px 0 24px;
    }
    .sky-band :global(h1) {
      font-size: 28px;
      text-wrap: initial;
    }
  }
</style>
