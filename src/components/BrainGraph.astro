          galaxySpin.rotation.z -= dt * 0.014 * spinRate;
          spinOuter.rotation.z -= dt * 0.0084 * spinRate;
        }
        // 星云漂浮：只保留正弦微移（★ 相对自转已删——星云入自转系后若再异向慢转，
        // 数分钟内又会滑回星团上方，避让失效）
        nebCloud.position.x = Math.sin(t * 0.013) * 0.22;
        nebDust.position.y = Math.cos(t * 0.011) * 0.18;
      }
      // ===== P2 镜头推拉：相机深入 + 星系平移，把目标星团送到画面中心 =====
      focusT += ((focusIdx >= 0 ? 1 : 0) - focusT) * Math.min(1, dt * 2.4);
      // ★ 「深入度」信号 = exploreT + focusT 封顶 1（2026-10-14 修「拉近后抖一下」）。
      //   原用 max(exploreT, focusT)：探索态退出比聚焦拉起快 → 中途两者都不高，max 塌一个坑，
      //   实测光斑直径 2.98→2.64→2.99、浓度 0.468→0.408→0.464 —— 团色「缩一下再涨回来」= 那下抖。
      //   改成相加封顶：过渡期恒为 1，全程单调，不再有回弹。
      // ★ deepT 单调防塌坑（2026-10-17 用户「拉近后银河像抽动一下」实测定位）：
      //   探索退出(exploreT dt×0.9 慢) 与聚焦上升(focusT dt×2.4 快) 速率不匹配，
      //   点击瞬间两者之和先跌后升 = 尘带亮度 V 形翻转（35→32.8→39.2→43.7，80ms 帧实锤）
      //   = 「抽动一下」的视觉本体。修：deepT 取历史最大值（只升不降直到完全退出），
      //   过渡期恒 1，亮度单调
      // 单调包络：深入只升不降（防过渡塌坑）；完全退出（和值≈0）时才回落
      const deepSum = Math.min(1, exploreT + focusT);
      deepT = deepSum < 0.02 ? Math.min(deepT, deepSum) : Math.max(deepT, deepSum);
      if (focusIdx >= 0) lastFocusIdx = focusIdx;
      if (pendingListK >= 0 && focusT > 0.5) { showList(pendingListK); pendingListK = -1; }
      if (focusT > 0.0005) {
        // ★ 拉满到位 + 五次曲线（2026-10-17 用户「只拉近一点点有啥意义」）：
        //   柔和放在曲线（e³ 起步/收尾加速度均为 0）和自转缓刹上，不牺牲距离——
        //   视野里就是这个星团占主体（原 FOCUS_DIST 全量）；「抽动」的根源
        //   （速度阶跃+视差横扫）已由 spinRate 缓刹 + 缓动曲线解决
        const e = focusT * focusT * focusT * (focusT * (focusT * 6 - 15) + 10);
        const rel = focusRel ?? new THREE.Vector3();
        const baseX = 0, baseY = 5.5, targetY = 0.5;
        galaxyTilt.position.x = baseX - rel.x * e;
        galaxyTilt.position.y = baseY + (targetY - baseY - rel.y) * e;
        // 相机停在「星团实际世界 z」前方 FOCUS_DIST 处（rel.z = 星团相对 tilt 的局部 z）
        const clusterCamZ = galaxyTilt.position.z + rel.z + FOCUS_DIST;
