---
// 知识图谱「夜空星图」：深空面板 + 发光星点 + 雾化纵深
// 节点 = 页面（笔记暖白 / 项目琥珀），边 = 共享标签
// 交互：拖拽旋转 / 滚轮缩放 / 点击进入；支持 prefers-reduced-motion
interface GraphNode {
  id: string;
  title: string;
  url: string;
  kind: string;
  group: string;
  tags: string[];
  /** 分类锚星（星域中心） */
  anchor?: boolean;
  /** 域色（恒星色温系） */
  color?: string;
  /** 悬停信息卡里的一句话描述 */
  desc?: string;
  /** 星域内的文章数（仅锚星） */
  count?: number;
}

interface Props {
  nodes: GraphNode[];
  /** [i, j, weight] */
  edges: [number, number, number][];
  /** 夜空模式：去掉面板边框与底色，融入外部深色区块 */
  bare?: boolean;
  /** 整个星系在竖直方向的偏移（负值 = 下沉），hero 文字悬浮时给上方让出净空 */
  offsetY?: number;
  /** 图下方的说明文字（默认「拖拽 · 点击星体探索」） */
  caption?: string;
  /** 说明文字下的第二行小字提示 */
  captionHint?: string;
}

const { nodes, edges, bare = false, offsetY = 0, caption, captionHint } = Astro.props;
const dataJson = JSON.stringify({ nodes, edges }).replace(/</g, '\\u003c');
---

<section class="graph-sec" id="graph">
  <div class:list={['graph-frame', { bare }]}>
    <div id="brain-graph" class="graph-canvas" role="img" aria-label="三维知识图谱：每个节点对应一篇文章，连线表示共享标签。下方列表提供相同的导航。"></div>
    <div id="graph-tip" class="graph-tip" aria-hidden="true">
      <p class="tip-title"></p>
      <p class="tip-meta"></p>
      <p class="tip-go">再点一次进入 →</p>
    </div>
  </div>
  <p class="graph-caption">
    <span class="cap-main">{caption ?? '拖拽 · 点击星体探索'}</span>
    {captionHint && <span class="cap-sub">{captionHint}</span>}
  </p>
  <details class="graph-list">
    <summary>文章索引</summary>
    <ul>
      {nodes.filter((n) => !n.anchor).map((n) => (
        <li><a href={n.url}>{n.title}</a></li>
      ))}
    </ul>
  </details>
  <script type="application/json" id="graph-data" set:html={dataJson} />
</section>

<style>
  /* 深空面板：两种主题下都是夜空底片 */
  .graph-frame {
    position: relative;
    margin-top: 14px;
    height: 500px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background:
      radial-gradient(52% 42% at 18% 24%, rgba(96, 118, 255, 0.13), transparent 70%),
      radial-gradient(46% 40% at 78% 72%, rgba(168, 122, 255, 0.1), transparent 72%),
      radial-gradient(120% 90% at 50% 0%, #131524 0%, #0b0c15 58%, #07080e 100%);
  }

  .graph-canvas {
    position: absolute;
    inset: 0;
    cursor: grab;
    touch-action: pan-y; /* 手机竖向滑动交给页面滚动，横向拖拽仍可旋转 */
  }

  /* 夜空模式：无框无底，融入外部深色区块并铺满全宽 */
  .graph-frame.bare {
    border: none;
    border-radius: 0;
    background: transparent;
    height: clamp(480px, 62vh, 660px);
    margin-inline: calc(50% - 50vw);
  }

  .graph-sec {
    margin-top: 40px;
  }

  .graph-list {
    max-width: 720px;
    margin: 10px auto 0;
    font-size: 13px;
  }

  .graph-list summary {
    cursor: pointer;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--muted);
    text-align: center;
    list-style: none;
  }

  .graph-list summary::-webkit-details-marker {
    display: none;
  }

  .graph-list ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    columns: 2;
  }

  .graph-list a {
    color: var(--text-2);
    line-height: 1.9;
  }

  .graph-list a:hover {
    color: var(--accent);
  }

  .graph-canvas.grabbing {
    cursor: grabbing;
  }

  .graph-canvas.pointing {
    cursor: pointer;
  }

  .graph-tip {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, calc(-100% - 14px));
    background: rgba(18, 20, 32, 0.92);
    border: 1px solid rgba(129, 140, 190, 0.35);
    border-radius: 8px;
    padding: 9px 13px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.12s ease;
    max-width: 250px;
    text-align: center;
    backdrop-filter: blur(4px);
  }

  .graph-tip.show {
    opacity: 1;
  }

  /* 触屏选中态：卡片可点按进入 */
  .graph-tip.tap {
    pointer-events: auto;
    cursor: pointer;
  }

  .tip-go {
    display: none;
    margin: 7px 0 0;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: #ffc46b;
  }

  .graph-tip.tap .tip-go {
    display: block;
  }

  .tip-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 15px;
    line-height: 1.4;
    color: #f2efe6;
  }

  .tip-meta {
    margin: 3px 0 0;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: #8d95b8;
  }

  .graph-frame :global(.star-label) {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0.9;
    text-shadow: 0 1px 6px rgba(7, 8, 14, 0.9);
    will-change: transform;
    transition: opacity 0.45s ease; /* 转入背面淡出、漂回正面淡入 */
  }

  .graph-caption {
    text-align: center;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 14px 0 0;
  }

  .cap-main {
    color: rgba(232, 230, 223, 0.6);
    letter-spacing: 0.2em;
  }

  .cap-sub {
    display: block;
    margin-top: 7px;
    font-size: 10px;
    letter-spacing: 0.14em;
    opacity: 0.72;
  }

  @media (max-width: 640px) {
    .graph-frame {
      height: 58vh;
      min-height: 360px;
    }
  }
</style>

<script>
  // 懒加载：图进入视口（含 300px 预加载余量）才拉取 three.js；
  // prefers-reduced-motion 直接渲染静态一帧，跳过动画
  const bootEl = document.getElementById('brain-graph');
  const bootData = document.getElementById('graph-data');
  if (bootEl && bootData && bootEl.parentElement) {
    const boot = () =>
      init(bootEl as HTMLElement, bootData, bootEl.parentElement as HTMLElement).catch(() => {});
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      boot();
    } else {
      const spy = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            spy.disconnect();
            boot();
          }
        },
        { rootMargin: '300px' }
      );
      spy.observe(bootEl);
    }
  }

  async function init(mount: HTMLElement, dataEl: HTMLElement, frame: HTMLElement) {
  const THREE = await import('three');

  type GraphNode = {
    id: string;
    title: string;
    url: string;
    kind: string;
    group: string;
    tags: string[];
    anchor?: boolean;
    color?: string;
    desc?: string;
    count?: number;
    parent?: number;
  };

  const tip = document.getElementById('graph-tip') as HTMLElement;

  if (mount && dataEl && frame) {
    const { nodes, edges } = JSON.parse(dataEl.textContent!) as {
      nodes: GraphNode[];
      edges: [number, number, number][];
    };

    // 固定种子：每次加载布局一致
    const mulberry32 = (a: number) => () => {
      a |= 0;
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
    const rand = mulberry32(20260912);

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    } catch {
      mount.remove();
      throw new Error('WebGL unavailable');
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    // 画布就绪后淡入：懒加载完成不再突然弹出
    renderer.domElement.style.opacity = '0';
    renderer.domElement.style.transition = 'opacity 0.6s ease';
    mount.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    // 雾化纵深：远处的星沉入夜空（密度偏高 → 深邃感）
    scene.fog = new THREE.FogExp2(0x0b0c12, 0.062); // 与页面底色一致

    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 200);
    // 窄屏自动拉远相机，保证星系完整可见；用户手动缩放后不再干预
    const fitZ = () => {
      const aspect = mount.clientWidth / Math.max(mount.clientHeight, 1);
      return aspect < 0.75 ? 14.2 : aspect < 1.1 ? 12.6 : 11.2;
    };
    let camZ = fitZ();
    let camZTarget = camZ;
    let userZoomed = false;
    camera.position.set(0, 0, camZ);

    const group = new THREE.Group();
    group.position.y = 0.55; // 星群整体上移，拉近与 hero 文字的距离
    scene.add(group);

    // ===== 初始位置：锚星布在球面（彼此远离），成员星落在锚星近旁 =====
    const N = nodes.length;
    const pos = new Float32Array(N * 3);
    const vel = new Float32Array(N * 3);
    const R0 = 2.7;
    const golden = Math.PI * (3 - Math.sqrt(5));
    const anchorIdx = nodes.map((n, i) => (n.anchor ? i : -1)).filter((i) => i >= 0);
    anchorIdx.forEach((ai, k) => {
      const M = Math.max(anchorIdx.length, 1);
      const y = M === 1 ? 0.2 : 1 - (k / (M - 1)) * 1.6;
      const r = Math.sqrt(Math.max(1 - y * y, 0));
      const th = golden * k * 2;
      pos[ai * 3] = Math.cos(th) * r * R0;
      pos[ai * 3 + 1] = y * R0;
      pos[ai * 3 + 2] = Math.sin(th) * r * R0;
    });
    let fib = 0;
    for (let i = 0; i < N; i++) {
      if (nodes[i].anchor) continue;
      const p = nodes[i].parent;
      if (p !== undefined && p >= 0) {
        // 成员星：锚星近旁成团
        pos[i * 3] = pos[p * 3] + (rand() - 0.5) * 1.7;
        pos[i * 3 + 1] = pos[p * 3 + 1] + (rand() - 0.5) * 1.7;
        pos[i * 3 + 2] = pos[p * 3 + 2] + (rand() - 0.5) * 1.7;
      } else {
        // 游离星（如项目）：球面散布
        const y = 1 - (fib / Math.max(N - 1, 1)) * 2;
        const r = Math.sqrt(1 - y * y);
        const th = golden * fib * 3;
        fib++;
        pos[i * 3] = Math.cos(th) * r * R0 + (rand() - 0.5) * 0.8;
        pos[i * 3 + 1] = y * R0 + (rand() - 0.5) * 0.8;
        pos[i * 3 + 2] = Math.sin(th) * r * R0 + (rand() - 0.5) * 0.8;
      }
    }

    // ===== 贴图：发光星点 / 柔和圆点 / 圆环 =====
    function glowTexture(stops: [number, string][]) {
      const c = document.createElement('canvas');
      c.width = c.height = 128;
      const g = c.getContext('2d')!;
      const grad = g.createRadialGradient(64, 64, 0, 64, 64, 64);
      for (const [o, col] of stops) grad.addColorStop(o, col);
      g.fillStyle = grad;
      g.fillRect(0, 0, 128, 128);
      return new THREE.CanvasTexture(c);
    }
    const starTex = glowTexture([
      [0, '#ffffff'],
      [0.12, '#ffffff'],
      [0.2, 'rgba(255,255,255,0.65)'],
      [0.38, 'rgba(255,255,255,0.12)'],
      [1, 'rgba(255,255,255,0)'],
    ]);
    const dotTex = glowTexture([
      [0, '#ffffff'],
      [0.5, 'rgba(255,255,255,0.6)'],
      [1, 'rgba(255,255,255,0)'],
    ]);
    const ringTex = (() => {
      const c = document.createElement('canvas');
      c.width = c.height = 96;
      const g = c.getContext('2d')!;
      g.strokeStyle = '#ffffff';
      g.lineWidth = 3.5;
      g.beginPath();
      g.arc(48, 48, 34, 0, Math.PI * 2);
      g.stroke();
      return new THREE.CanvasTexture(c);
    })();

    // ===== 节点：发光星点（分类锚星带域色，成员星染淡色）=====
    const degree = new Array(N).fill(0);
    for (const [a, b] of edges) degree[a]++, degree[b]++;

    const white = new THREE.Color(0xf3efe2);
    const amber = new THREE.Color(0xffc46b);
    const nodeColor: THREE.Color[] = [];
    for (let i = 0; i < N; i++) {
      const n = nodes[i];
      if (n.anchor) {
        nodeColor.push(new THREE.Color(n.color || '#f3efe2'));
      } else if (n.kind === '项目') {
        nodeColor.push(amber.clone());
      } else {
        // 成员星：域色调淡，融入夜空
        nodeColor.push(new THREE.Color(n.color || '#f3efe2').lerp(white, 0.55));
      }
    }

    const sprites: THREE.Sprite[] = [];
    const baseScale: number[] = [];
    for (let i = 0; i < N; i++) {
      const mat = new THREE.SpriteMaterial({
        map: starTex, color: nodeColor[i], transparent: true, fog: true, depthWrite: false,
      });
      const s = nodes[i].anchor
        ? 0.5 + Math.min(degree[i], 6) * 0.04
        : (nodes[i].kind === '项目' ? 0.4 : 0.3) + Math.min(degree[i], 5) * 0.045 + rand() * 0.06;
      const sp = new THREE.Sprite(mat);
      sp.position.set(pos[i * 3], pos[i * 3 + 1], pos[i * 3 + 2]);
      sp.scale.setScalar(s);
      baseScale.push(s);
      group.add(sp);
      sprites.push(sp);
    }

    // 锚星名字标签（HTML 覆盖层，跟随投影位置）；w 供标签避让算屏宽
    const _lv = new THREE.Vector3();
    const labels: { el: HTMLDivElement; i: number; w: number }[] = [];
    nodes.forEach((n, i) => {
      if (!n.anchor) return;
      const el = document.createElement('div');
      el.className = 'star-label';
      el.textContent = n.title;
      if (n.color) el.style.color = n.color;
      frame.appendChild(el);
      labels.push({ el, i, w: el.offsetWidth });
    });

    // ===== 边：星尘轨迹（点连线，全图只有光点、没有笔画）=====
    // 星尘：每条弧线按长度布点，两端渐隐、微微闪烁
    const dotsPerEdge = new Int16Array(edges.length);
    let totalDots = 0;
    for (let e = 0; e < edges.length; e++) {
      const [a, b] = edges[e];
      const len = Math.hypot(
        pos[b * 3] - pos[a * 3],
        pos[b * 3 + 1] - pos[a * 3 + 1],
        pos[b * 3 + 2] - pos[a * 3 + 2]
      );
      dotsPerEdge[e] = Math.max(4, Math.min(16, Math.round(len / 0.33)));
      totalDots += dotsPerEdge[e];
    }
    const dotOffsets = new Int32Array(edges.length + 1);
    for (let e = 0; e < edges.length; e++) dotOffsets[e + 1] = dotOffsets[e] + dotsPerEdge[e];

    const dustGeo = new THREE.BufferGeometry();
    const dustPos = new Float32Array(totalDots * 3);
    const dustCol = new Float32Array(totalDots * 3);
    dustGeo.setAttribute('position', new THREE.BufferAttribute(dustPos, 3));
    dustGeo.setAttribute('color', new THREE.BufferAttribute(dustCol, 3));
    const dust = new THREE.Points(
      dustGeo,
      new THREE.PointsMaterial({
        map: dotTex, size: 0.095, sizeAttenuation: true, vertexColors: true,
        transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, fog: true,
      })
    );
    group.add(dust);

    const dimColor = new THREE.Color(0x39446e);
    const hiColor = new THREE.Color(0xffc46b);
    // 每条边的基色：连到锚星的边继承域色（压暗避免光污染），跨域边用暗蓝
    const edgeBase = edges.map(([a, b]) => {
      const src = nodes[a].anchor ? nodes[a] : nodes[b].anchor ? nodes[b] : null;
      return src?.color
        ? new THREE.Color(src.color).multiplyScalar(0.55)
        : dimColor.clone();
    });

    // 每条边固定相位（形态稳定），弓起幅度随时间轻微呼吸
    const edgePhase = new Float32Array(edges.length);
    for (let e = 0; e < edges.length; e++) edgePhase[e] = rand() * Math.PI * 2;
    const ctrl = new Float32Array(edges.length * 3); // 二次贝塞尔控制点

    const _d = new THREE.Vector3(), _mid = new THREE.Vector3(),
      _centroid = new THREE.Vector3(), _out = new THREE.Vector3(), _p = new THREE.Vector3();

    function updateCtrl(t) {
      // 全图质心：所有弧线统一向外弓 → 饱满的有机形态（不会内凹）
      _centroid.set(0, 0, 0);
      for (let i = 0; i < N; i++) {
        _centroid.x += pos[i * 3]; _centroid.y += pos[i * 3 + 1]; _centroid.z += pos[i * 3 + 2];
      }
      _centroid.multiplyScalar(1 / Math.max(N, 1));

      for (let e = 0; e < edges.length; e++) {
        const [a, b] = edges[e];
        _mid.set((pos[a * 3] + pos[b * 3]) / 2, (pos[a * 3 + 1] + pos[b * 3 + 1]) / 2, (pos[a * 3 + 2] + pos[b * 3 + 2]) / 2);
        _out.copy(_mid).sub(_centroid);
        if (_out.lengthSq() < 1e-6) _out.set(Math.sin(e * 2.3), Math.cos(e * 1.7), 0.3);
        _out.normalize();
        const mag = Math.min(_d.set(pos[b * 3] - pos[a * 3], pos[b * 3 + 1] - pos[a * 3 + 1], pos[b * 3 + 2] - pos[a * 3 + 2]).length() * 0.13, 0.7)
          * (1 + 0.2 * Math.sin(t * 0.35 + edgePhase[e]));
        ctrl[e * 3] = _mid.x + _out.x * mag;
        ctrl[e * 3 + 1] = _mid.y + _out.y * mag;
        ctrl[e * 3 + 2] = _mid.z + _out.z * mag;
      }
    }

    // 二次贝塞尔取点
    function bez(out, e, t01) {
      const [a, b] = edges[e];
      const u = 1 - t01;
      const w0 = u * u, w1 = 2 * u * t01, w2 = t01 * t01;
      out.x = w0 * pos[a * 3] + w1 * ctrl[e * 3] + w2 * pos[b * 3];
      out.y = w0 * pos[a * 3 + 1] + w1 * ctrl[e * 3 + 1] + w2 * pos[b * 3 + 1];
      out.z = w0 * pos[a * 3 + 2] + w1 * ctrl[e * 3 + 2] + w2 * pos[b * 3 + 2];
    }

    function syncCurves(t, hovered) {
      updateCtrl(t);
      for (let e = 0; e < edges.length; e++) {
        const [a, b] = edges[e];
        const active = hovered >= 0 && (a === hovered || b === hovered);
        const base = dotOffsets[e], n = dotsPerEdge[e];
        for (let k = 0; k < n; k++) {
          const u = (k + 0.5) / n;
          bez(_p, e, 0.08 + 0.84 * u); // 两端留白，不顶到星星
          const i = (base + k) * 3;
          dustPos[i] = _p.x; dustPos[i + 1] = _p.y; dustPos[i + 2] = _p.z;
          const endFade = Math.sin(Math.PI * u); // 两端渐隐
          const shimmer = 0.9 + 0.1 * Math.sin(t * 1.4 + edgePhase[e] + k * 0.9);
          const c = active ? hiColor : edgeBase[e];
          const f = endFade * shimmer * (active ? 1 : 0.38);
          dustCol[i] = c.r * f; dustCol[i + 1] = c.g * f; dustCol[i + 2] = c.b * f;
        }
      }
      dustGeo.attributes.position.needsUpdate = true;
      dustGeo.attributes.color.needsUpdate = true;
    }

    // ===== 悬停圆环 =====
    const ring = new THREE.Sprite(
      new THREE.SpriteMaterial({ map: ringTex, color: 0xffc46b, transparent: true, depthWrite: false })
    );
    ring.scale.setScalar(1.15);
    ring.visible = false;
    group.add(ring);

    // ===== 远景星野（视差层）：多而细、暗而不喧，只作纵深 =====
    // 「余下皆是未知」：已知星被大片无名暗星包围，越密越显已知之少
    const starField = (() => {
      const M = 700;
      const arr = new Float32Array(M * 3);
      for (let i = 0; i < M; i++) {
        const u = rand() * 2 - 1, th = rand() * Math.PI * 2, rr = 26 + rand() * 30;
        const s = Math.sqrt(1 - u * u);
        arr[i * 3] = Math.cos(th) * s * rr;
        arr[i * 3 + 1] = u * rr;
        arr[i * 3 + 2] = Math.sin(th) * s * rr;
      }
      const g = new THREE.BufferGeometry();
      g.setAttribute('position', new THREE.BufferAttribute(arr, 3));
      const pts = new THREE.Points(
        g,
        new THREE.PointsMaterial({
          map: dotTex, color: 0x9aa6d8, size: 0.38, sizeAttenuation: true,
          transparent: true, opacity: 0.3, depthWrite: false, fog: false,
        })
      );
      scene.add(pts);
      return pts;
    })();

    // ===== 力导向模拟（带边界钳制）=====
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let alpha = 1;
    const BOUND = 3.9;
    // 每条边的自然长度与劲度：归属边（连着锚星）短而强 → 成员凝聚成团；标签边松而弱
    const isAnchorEdge = (e: number) => {
      const [a, b] = edges[e];
      return !!(nodes[a].anchor || nodes[b].anchor);
    };
    const restOf = (e: number) => (isAnchorEdge(e) ? 1.5 : 2.2);
    const stiffOf = (e: number) => (isAnchorEdge(e) ? 0.055 : 0.03);
    function tick(t) {
      for (let i = 0; i < N; i++)
        for (let j = i + 1; j < N; j++) {
          let dx = pos[i * 3] - pos[j * 3],
            dy = pos[i * 3 + 1] - pos[j * 3 + 1],
            dz = pos[i * 3 + 2] - pos[j * 3 + 2];
          let d2 = dx * dx + dy * dy + dz * dz;
          if (d2 < 1e-4) d2 = 1e-4;
          const f = (12 / d2) * alpha;
          const d = Math.sqrt(d2);
          dx /= d; dy /= d; dz /= d;
          vel[i * 3] += dx * f; vel[i * 3 + 1] += dy * f; vel[i * 3 + 2] += dz * f;
          vel[j * 3] -= dx * f; vel[j * 3 + 1] -= dy * f; vel[j * 3 + 2] -= dz * f;
        }
      for (let e = 0; e < edges.length; e++) {
        const [a, b, w] = edges[e];
        let dx = pos[b * 3] - pos[a * 3],
          dy = pos[b * 3 + 1] - pos[a * 3 + 1],
          dz = pos[b * 3 + 2] - pos[a * 3 + 2];
        const d = Math.sqrt(dx * dx + dy * dy + dz * dz) || 1e-4;
        const f = (d - restOf(e)) * stiffOf(e) * w * alpha;
        dx /= d; dy /= d; dz /= d;
        vel[a * 3] += dx * f; vel[a * 3 + 1] += dy * f; vel[a * 3 + 2] += dz * f;
        vel[b * 3] -= dx * f; vel[b * 3 + 1] -= dy * f; vel[b * 3 + 2] -= dz * f;
      }
      for (let i = 0; i < N; i++) {
        const ix = i * 3, iy = i * 3 + 1, iz = i * 3 + 2;
        vel[ix] -= pos[ix] * 0.032;
        vel[iy] -= pos[iy] * 0.032;
        vel[iz] -= pos[iz] * 0.032;
        for (const idx of [ix, iy, iz]) {
          vel[idx] *= 0.86;
          pos[idx] += Math.max(-0.35, Math.min(0.35, vel[idx]));
        }
        const r = Math.sqrt(pos[ix] ** 2 + pos[iy] ** 2 + pos[iz] ** 2);
        if (r > BOUND) {
          const s = BOUND / r;
          pos[ix] *= s; pos[iy] *= s; pos[iz] *= s;
          vel[ix] *= 0.7; vel[iy] *= 0.7; vel[iz] *= 0.7;
        }
        sprites[i].position.set(pos[ix], pos[iy], pos[iz]);
      }
      alpha = Math.max(alpha * 0.9943, reduced ? 0 : 0.04);
      syncCurves(t, hovered);
    }

    // ===== 交互 =====
    let rotX = 0.2, rotY = 0.5, tRotX = rotX, tRotY = rotY;
    let dragging = false, moved = 0, lastX = 0, lastY = 0, hovered = -1;
    const tmp = new THREE.Vector3();

    function pick(cx: number, cy: number): number {
      const rect = mount.getBoundingClientRect();
      let best = -1, bestD = Infinity;
      for (let i = 0; i < N; i++) {
        const thresh = nodes[i].anchor ? 34 : 26; // 锚星更大，拾取半径放宽
        tmp.set(pos[i * 3], pos[i * 3 + 1], pos[i * 3 + 2]).applyMatrix4(group.matrixWorld).project(camera);
        const sx = (tmp.x * 0.5 + 0.5) * rect.width + rect.left;
        const sy = (-tmp.y * 0.5 + 0.5) * rect.height + rect.top;
        const dx = sx - cx, dy = sy - cy, d = dx * dx + dy * dy;
        if (d < thresh * thresh && d < bestD) { bestD = d; best = i; }
      }
      return best;
    }

    function showTip(i: number) {
      const rect = mount.getBoundingClientRect();
      tmp.set(pos[i * 3], pos[i * 3 + 1], pos[i * 3 + 2]).applyMatrix4(group.matrixWorld).project(camera);
      const sx = (tmp.x * 0.5 + 0.5) * rect.width;
      const sy = (-tmp.y * 0.5 + 0.5) * rect.height;
      tip.style.transform = `translate(${sx}px, ${sy}px) translate(-50%, calc(-100% - 12px))`;
      (tip.querySelector('.tip-title') as HTMLElement).textContent = nodes[i].title;
      const n = nodes[i];
      const meta = n.anchor
        ? `${n.desc || n.group} · ${n.count ?? ''} 篇`
        : `${n.kind} · ${n.group}${n.desc ? ' — ' + n.desc : ''}`;
      (tip.querySelector('.tip-meta') as HTMLElement).textContent = meta;
      tip.classList.add('show');
    }

    mount.addEventListener('pointerdown', (e) => {
      dragging = true; moved = 0; lastX = e.clientX; lastY = e.clientY;
      mount.classList.add('grabbing');
      mount.setPointerCapture(e.pointerId);
    });
    mount.addEventListener('pointermove', (e) => {
      if (dragging) {
        const dx = e.clientX - lastX, dy = e.clientY - lastY;
        moved += Math.abs(dx) + Math.abs(dy);
        tRotY += dx * 0.0052;
        tRotX = Math.max(-1.2, Math.min(1.2, tRotX + dy * 0.0042));
        lastX = e.clientX; lastY = e.clientY;
      } else if (e.pointerType === 'mouse') {
        hovered = pick(e.clientX, e.clientY);
        mount.classList.toggle('pointing', hovered >= 0);
        ring.visible = hovered >= 0;
        if (hovered >= 0) showTip(hovered); else tip.classList.remove('show');
      }
    });
    // 触屏两段式：首点选中并弹卡，再点（或点卡片）进入；鼠标保持点击直达
    let selected = -1;
    function clearSelection() {
      selected = -1;
      tip.classList.remove('show', 'tap');
    }
    mount.addEventListener('pointerup', (e) => {
      dragging = false;
      mount.classList.remove('grabbing');
      if (moved >= 8) return;
      const i = pick(e.clientX, e.clientY);
      if (e.pointerType === 'mouse') {
        if (i >= 0 && nodes[i].url) location.href = nodes[i].url;
        return;
      }
      if (i >= 0) {
        if (i === selected) {
          if (nodes[i].url) location.href = nodes[i].url;
        } else {
          selected = i;
          hovered = i;
          ring.visible = true;
          showTip(i);
          tip.classList.add('tap');
        }
      } else {
        clearSelection();
        ring.visible = false;
      }
    });
    tip.addEventListener('click', () => {
      if (selected >= 0 && nodes[selected].url) location.href = nodes[selected].url;
    });
    mount.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') {
        hovered = -1; ring.visible = false; tip.classList.remove('show');
        mount.classList.remove('pointing');
      }
    });
    mount.addEventListener('wheel', (e) => {
      // 普通滚轮放行给页面滚动；Ctrl/Cmd + 滚轮才缩放
      if (!e.ctrlKey && !e.metaKey) return;
      e.preventDefault();
      userZoomed = true;
      camZTarget = Math.max(7.2, Math.min(16, camZTarget + e.deltaY * 0.006));
    }, { passive: false });

    // ===== 尺寸与可见性 =====
    function resize() {
      const w = mount.clientWidth, h = mount.clientHeight;
      renderer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      if (!userZoomed) camZTarget = fitZ();
    }
    new ResizeObserver(resize).observe(mount);
    resize();

    // 滚出视口或切走标签页时暂停渲染循环，滚动性能零损耗
    let inView = true, rafId = 0;
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (inView && !rafId) loop();
    }).observe(mount);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { cancelAnimationFrame(rafId); rafId = 0; }
      else if (inView && !rafId) loop();
    });

    // ===== 主循环：多轴漂移 + 呼吸，制造纵深 =====
    // 预跑模拟到收敛（alpha 衰减至下限）：首帧即成形星座，
    // 每次跳回主页不再看到星星从散点「快速复位」地乱飞
    for (let i = 0; i < 700; i++) tick(0);
    const t0 = performance.now();
    function loop() {
      rafId = requestAnimationFrame(loop);
      if (!inView) { cancelAnimationFrame(rafId); rafId = 0; return; }
      const t = (performance.now() - t0) * 0.001;
      if (!reduced) tick(t);
      if (!dragging) tRotY += 0.0018;
      const wob = reduced ? 0 : Math.sin(t * 0.22) * 0.05; // 轻微俯仰呼吸
      rotX += (tRotX - rotX) * 0.07;
      rotY += (tRotY - rotY) * 0.07;
      camZ += (camZTarget - camZ) * 0.1;
      group.rotation.set(rotX + wob, rotY, 0);
      camera.position.z = camZ;
      starField.rotation.y = -rotY * 0.25; // 远景反向缓转 → 视差
      starField.rotation.x = -rotX * 0.2;

      if (ring.visible && hovered >= 0)
        ring.position.set(pos[hovered * 3], pos[hovered * 3 + 1], pos[hovered * 3 + 2]);

      // 锚星标签：只亮视深最靠前的 K 个（2 颗→1、6 颗→2、封顶 4），
      // 星空缓转时排名自然轮换 → 「漂到正面才显示」；再叠屏幕避让，锚星再多不叠罗汉
      if (labels.length) {
        const w = mount.clientWidth, h = mount.clientHeight;
        const K = Math.min(4, Math.max(1, Math.round(labels.length / 3)));
        const order = labels
          .map((L) => {
            _lv.set(pos[L.i * 3], pos[L.i * 3 + 1], pos[L.i * 3 + 2]).applyMatrix4(group.matrixWorld);
            return { L, z: _lv.z };
          })
          .sort((a, b) => b.z - a.z);
        const taken: { x: number; y: number; w: number }[] = [];
        order.forEach(({ L, z }, rank) => {
          tmp.set(pos[L.i * 3], pos[L.i * 3 + 1], pos[L.i * 3 + 2])
            .applyMatrix4(group.matrixWorld)
            .project(camera);
          const x = (tmp.x * 0.5 + 0.5) * w;
          const y = (-tmp.y * 0.5 + 0.5) * h;
          const lit = rank < K && z > -1 && tmp.z < 1;
          const busy = lit && taken.some((r) => Math.abs(x - r.x) < (r.w + L.w) / 2 + 10 && Math.abs(y - r.y) < 18);
          if (lit && !busy) taken.push({ x, y, w: L.w });
          L.el.style.transform = `translate(${x}px, ${y}px) translate(-50%, 16px)`;
          L.el.style.opacity = !lit || busy ? '0' : '';
        });
      }
      renderer.render(scene, camera);
    }
    if (!rafId) loop();
  }
  }
</script>
