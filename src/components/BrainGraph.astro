      galaxySpin.add(new THREE.Points(geo, mat));
      }
    }

    // （P3 新星脉冲环已删除：用户「文章星的圈，加这些干嘛」—— 星本体已经是团色光点，套圈是多余装饰）

    // ===== P3 亮星光晕：置顶 / 精选文章的外圈淡晕（方案图「亮星」：大亮晕）=====
    // 颜色跟随所属星团域色
    const pinnedHalos: { sp: THREE.Sprite; base: number; ph: number }[] = [];
    stars.forEach((s, i) => {
