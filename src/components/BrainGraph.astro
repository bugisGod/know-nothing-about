    });
    tip.addEventListener('click', () => {
      // 星团卡上的「进入分类」：探索态 → 页内拉近聚焦；默认态 → 直接进分类页（不位移相机）
      if (hitKind === 'cluster') {
        if (exploreMode) { flyTo(hitIdx); return; }
        const u = targetUrl(hitKind, hitIdx);
        if (u) location.href = u;
        return;
      }
      if (hitKind === 'star') { openArticle(hitIdx); return; } // 文章卡 → 直接进文章页
      const url = targetUrl(hitKind, hitIdx);
      if (url) location.href = url;
    });
    mount.addEventListener('pointercancel', (e) => {
      activePtr.delete(e.pointerId);
      if (activePtr.size < 2) pinchDist = 0;
      dragging = false;
      mount.classList.remove('grabbing');
    });
    mount.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') {
