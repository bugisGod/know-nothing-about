</style>

<script>
  // 懒加载：图进入视口（含 300px 预加载余量）才拉取 three.js；
  // prefers-reduced-motion 直接渲染静态一帧，跳过动画
  const bootEl = document.getElementById('brain-graph');
  const bootData = document.getElementById('graph-data');
  if (bootEl && bootData && bootEl.parentElement) {
    // 任何 boot 失败（three.js 模块 404 / WebGL 失败 / 初始化异常）都不静默：
    // rebuild 后哈希变化，旧页面引用旧 chunk 404 是「星图消失」的主因之一
    const showBootError = () => {
      const mount0 = bootEl as HTMLElement;
      if (mount0.querySelector('.galaxy-retry')) return;
      const box = document.createElement('div');
      box.className = 'galaxy-retry';
      box.innerHTML =
        '<p>星空加载失败（页面版本已更新）</p>' +
        '<button type="button">重新加载星空</button>';
      box.querySelector('button').addEventListener('click', () => location.reload());
      mount0.appendChild(box);
    };
    const boot = () => {
      (window as any).__m = ((window as any).__m || []).concat(['boot']).slice(-8);
      return init(bootEl as HTMLElement, bootData, bootEl.parentElement as HTMLElement)
        .catch((e) => {
          console.error('[BrainGraph] init failed:', e);
          (window as any).__m = ((window as any).__m || []).concat(['FAIL:' + String(e && (e.stack || e.message) || e).split(String.fromCharCode(10)).join(' ~ ').slice(0, 700)].slice(-2));
          showBootError();
        })
        .then(() => {
          (window as any).__m = ((window as any).__m || []).concat(['init-done']).slice(-8);
        });
    };
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      boot();
    } else {
      const spy = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            spy.disconnect();
            boot();
          }
        },
        { rootMargin: '300px' }
      );
      spy.observe(bootEl);
    }
  }

  async function init(mount: HTMLElement, dataEl: HTMLElement, frame: HTMLElement) {
  const THREE = await import('three');
  const tip = document.getElementById('graph-tip') as HTMLElement;

  if (mount && dataEl && frame) {
    const { clusters, stars, links = [] } = JSON.parse(dataEl.textContent!) as {
      clusters: ClusterDef[];
      stars: StarDef[];
      links?: LinkDef[];
    };

    // 固定种子：每次加载布局一致
    const mulberry32 = (a: number) => () => {
      a |= 0;
      a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
    const rand = mulberry32(20260912);

    // WebGL 失败/上下文丢失的降级层：保留容器、给出原因与重试入口（而不是静默黑屏）
    const showRetry = () => {
      if (mount.querySelector('.galaxy-retry')) return;
      const box = document.createElement('div');
      box.className = 'galaxy-retry';
      box.innerHTML =
        '<p>星空渲染暂不可用（浏览器 WebGL 资源不足，常见于开启过多标签页）</p>' +
        '<button type="button">重新加载星空</button>';
      box.querySelector('button').addEventListener('click', () => location.reload());
      mount.appendChild(box);
    };

    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    } catch {
      // WebGL 上下文创建失败（多标签抢占/资源驱逐）：不再删容器静默吞错——
      // 保留容器，显示可重试的降级层（用户此前「星团消失」即此路径无提示）
      showRetry();
      return;
    }
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    // 上下文丢失监听：标签抢占导致运行中丢上下文时，给出重试入口而不是永久黑屏
    renderer.domElement.addEventListener('webglcontextlost', (e) => {
      e.preventDefault();
      showRetry();
    });
    // 画布就绪后淡入：懒加载完成不再突然弹出
    renderer.domElement.style.opacity = '0';
    renderer.domElement.style.transition = 'opacity 0.6s ease';
    mount.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    // 雾化纵深：远处的星沉入夜空（密度偏高 → 深邃感）
    scene.fog = new THREE.FogExp2(0x060709, 0.062); // 与页面底色一致

    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 200);
    // 相机按视口【对角线】取距：环长轴（投影半长 ~30.5）两端伸向画面角部，贯穿整条对角线；
    // 距离钳制 [38,46]：过近会挤爆主角星图，过窄屏装不下整环（弧段贯穿）
    const fitZ = () => {
      const T = Math.tan((45 / 2) * Math.PI / 180);
      // 俯瞰圆盘：直径占视口高 ~92%（圆盘各向同宽，竖屏自然出画成弧带）
      const dist = (21 * 2) / 0.98 / (2 * T);
      return Math.max(6, Math.min(dist, 54) - 30); // ~92% 视口高：全屏不再糊脸
    };
    // 环长轴屏幕角对齐视口对角线角：tan(屏幕角)=tan(rz)·cos(rx) → 解出 rz 基角
    let rzBase = 0.58;
    const fitRZ = () => {
      const aspect = mount.clientWidth / Math.max(mount.clientHeight, 1);
      rzBase = Math.atan(1 / (aspect * Math.cos(0.75)));
    };
    let camZ = fitZ();
    let camZTarget = camZ;
    let userZoomed = false;
    // P1 EXPLORE 自由漫游态（声明提前：主循环 camZ 收敛速率用到）
    let exploreMode = false;
    let exploreT = 0;
    // ★ 状态真值（2026-10-27 审查）：聚焦某团是「探索态内部的相机状态」，不是退出探索。
    //   原实现在 flyTo 里调 exitExplore(true) 把 exploreMode 清成 false，只为了保住探索层
    //   外观 —— 于是所有按 exploreMode 分支的逻辑（相机速率/自转/标签禁区/按钮行为）在
    //   聚焦态全部拿到假值，底部那颗「EXIT EXPLORE」因此变成「点了反而重新进入探索」。
    //   现在 exploreMode 全程如实，「漫游态」单独派生：探索中 且 未聚焦任何团。
    const roam = () => exploreMode && focusIdx < 0;
    camera.position.set(0, 0, camZ);

    // 滚动进度：星空是整个页面的铺底，环随页面滚动沿对角线缓缓转动下沉
    let scrollP = 0, scrollPSmooth = 0;
    const readScroll = () => {
      const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      scrollP = Math.min(1, Math.max(0, (window.scrollY || 0) / max));
    };
    addEventListener('scroll', readScroll, { passive: true });
    readScroll();

    // ===== 贴图：发光星点 / 柔和圆点 / 圆环 =====
    function glowTexture(stops: [number, string][]) {
      const c = document.createElement('canvas');
      c.width = c.height = 128;
      const g = c.getContext('2d')!;
      const grad = g.createRadialGradient(64, 64, 0, 64, 64, 64);
      for (const [o, col] of stops) grad.addColorStop(o, col);
      g.fillStyle = grad;
      g.fillRect(0, 0, 128, 128);
      return new THREE.CanvasTexture(c);
    }
    // ★ 设计规范：亮度 ≠ 尺寸。文章星 = 「小而锐利的光点」，不是「大而发光的圆球」。
    //   ┌ Core ── 2~3px 固定，极锐（只负责「这里有一个明确的星」）
    //   └ Halo ── 12~24px 独立 sprite，透明度极低（只负责「这颗星很亮」）
    //   想让星更亮 → 调 halo 的 opacity/尺寸与 core 的白度，**绝不调 core 的 size**：
    //   把 core 调大 = 整页从「知识银河」塌成「几个大圆点」。
    const starTex = glowTexture([
      [0, '#ffffff'],
      [0.1, '#ffffff'],
      [0.17, 'rgba(255,255,255,0.62)'],
      [0.24, 'rgba(255,255,255,0.1)'],
      [1, 'rgba(255,255,255,0)'],
    ]);
    // 文章星核心：core 只有 2~3px，实核必须占大头 —— 否则 3px 里没有几个白像素，
    // 反而变暗。0~0.45 纯白 + 边缘极快衰减 = 「锐」的观感来源（比单纯调亮度更有效）。
    const coreTex = glowTexture([
      [0, '#ffffff'],
      [0.45, '#ffffff'],
      [0.62, 'rgba(255,255,255,0.5)'],
      [0.82, 'rgba(255,255,255,0.08)'],
      [1, 'rgba(255,255,255,0)'],
    ]);
    const dotTex = glowTexture([
      [0, '#ffffff'],
      [0.5, 'rgba(255,255,255,0.6)'],
      [1, 'rgba(255,255,255,0)'],
    ]);
    // 锐点纹理（用户：全屏粒子蒙蒙的不清晰）：亮核平台 + 快速衰减，粒子是「星点」不是「光斑」
    const crispTex = glowTexture([
      [0, '#ffffff'],
      [0.32, '#ffffff'],
      [0.52, 'rgba(255,255,255,0.5)'],
      [0.75, 'rgba(255,255,255,0.12)'],
      [1, 'rgba(255,255,255,0)'],
    ]);
    // 环形发光纹理（用户：中心核要中空）：中心透、中环最亮、外缘渐隐
    const ringGlowTex = (() => {
      const c = document.createElement('canvas');
      c.width = c.height = 128;
      const g = c.getContext('2d')!;
      const grad = g.createRadialGradient(64, 64, 0, 64, 64, 64);
      grad.addColorStop(0, 'rgba(255,255,255,0.02)');
      grad.addColorStop(0.35, 'rgba(255,255,255,0.08)');
      grad.addColorStop(0.52, 'rgba(255,255,255,0.45)');
      grad.addColorStop(0.62, 'rgba(255,255,255,0.95)');
      grad.addColorStop(0.72, 'rgba(255,255,255,0.35)');
      grad.addColorStop(0.85, 'rgba(255,255,255,0.06)');
      grad.addColorStop(1, 'rgba(255,255,255,0)');
      g.fillStyle = grad;
      g.fillRect(0, 0, 128, 128);
      return new THREE.CanvasTexture(c);
    })();
    // （星芒贴图已删：用户对照视觉图明确「文章星就是明亮的圆点，没有星芒」——锐核短晕的 starTex 即正确形态）
    const ringTex = (() => {
      const c = document.createElement('canvas');
      c.width = c.height = 96;
      const g = c.getContext('2d')!;
      g.strokeStyle = '#ffffff';
      g.lineWidth = 3.5;
      g.beginPath();
      g.arc(48, 48, 34, 0, Math.PI * 2);
      g.stroke();
      return new THREE.CanvasTexture(c);
    })();

    // Halo 专用贴图（规范给的径向渐变：100% / 50% / 20% / 5% / 0%）：
    // 亮区集中在前 40%，尾部迅速归零 —— 「小星看起来亮」而不是「一团雾」
    const glowHaloTex = glowTexture([
      [0, '#ffffff'],
      [0.18, 'rgba(255,255,255,0.5)'],
      [0.4, 'rgba(255,255,255,0.18)'],
      [0.7, 'rgba(255,255,255,0.04)'],
      [1, 'rgba(255,255,255,0)'],
    ]);
    // 星团光晕贴图：极淡的大范围柔光（星团的「空间范围」的可见化）
    // 中心不实心、边缘长尾衰减 —— 读作「一团雾状光晕」而不是「一颗大星」
    const haloTex = glowTexture([
      [0, 'rgba(255,255,255,0.42)'],
      [0.22, 'rgba(255,255,255,0.22)'],
      [0.5, 'rgba(255,255,255,0.07)'],
      [1, 'rgba(255,255,255,0)'],
    ]);
    // ★ 星团「范围雾」专用贴图：平滑高斯型衰减（中心明确、外围柔和渐隐）。
    //   试过「平台区 + 后段渐隐」——中心到 60% 几乎均匀，看起来是一块有硬边的圆盘，
    //   均匀提亮还压住了银河星点，观感发灰发脏（用户反馈）。现在每 20% 就掉一档，
    //   没有硬边界，读起来是「这片空间里星更密」而不是「贴了一张膜」。
    const clusFogTex = glowTexture([
      [0, 'rgba(255,255,255,0.85)'],
      [0.28, 'rgba(255,255,255,0.5)'],
      [0.5, 'rgba(255,255,255,0.26)'],
      [0.72, 'rgba(255,255,255,0.1)'],
      [1, 'rgba(255,255,255,0)'],
    ]);
    // 文章星的光晕贴图：峰值 1.0、快速衰减 —— haloTex 峰值只有 0.42，
    // 是「光晕怎么调都不亮」的元凶（opacity 1.0 也只能加 42% 的色光）
    const bloomTex = glowTexture([
      [0, 'rgba(255,255,255,1)'],
      [0.18, 'rgba(255,255,255,0.72)'],
      [0.42, 'rgba(255,255,255,0.26)'],
      [1, 'rgba(255,255,255,0)'],
    ]);

    // ===== 远景银河：一个缓缓自转的螺旋星系 =====
    // 分两级 group：tilt 掌「视角姿态」（倾角 / 对角线），spin 掌「自转」。
    // 必须分开 —— 自转要绕盘自身的法线（局部 z）转；若直接转外层 z，会变成「甩Albania盘子」而不是自转。
    const dustMats = [];
    let linkBreath: THREE.ShaderMaterial | null = null; // 星际连线（呼吸明暗）
    const galaxyTilt = new THREE.Group();
    const galaxySpin = new THREE.Group();
    // 分层差速：每层是刚体点云各自转（比例取方案文档 核心:内盘:外盘 = 0.05:0.10:0.06），
    // 层间转速差产生前后景视差 —— 星系「活着」的最低成本线索，也不会有真差速的缠绕问题
    const spinCore = new THREE.Group(); spinCore.name = 'spinCore';
    const spinOuter = new THREE.Group(); spinOuter.name = 'spinOuter';
    galaxySpin.name = 'spinInner';
    galaxyTilt.name = 'galaxyTilt';
    galaxyTilt.add(galaxySpin);
    galaxyTilt.add(spinCore);
    galaxyTilt.add(spinOuter);
    // x: 盘面后仰 → 椭圆透视；z: 长轴摆到左下→右上对角
    galaxyTilt.rotation.set(-0.6, 0, 0.58); // 俯瞰 + 34°：星系顶边向屏幕深处倾倒（往里倒的感觉），椭圆透视
    // 星系中心压到画面中线以下：上半留给标语/标题，黑得多才「深邃」
    galaxyTilt.position.set(0, 5.5, -30); // 银河中心在画面上 1/3（方案图布局：银河在上、标语沉底）
    scene.add(galaxyTilt);


    // ===== 螺旋星系布点 =====
    // 窄屏密度降级：同样的星挤进小画面，单位面积密度会暴涨（手机端是桌面的 4 倍）→
    // 要维持与桌面相同的疏密观感，星数须接近等比缩小（指数取 0.85）
    // ★ 用「屏幕」而不是「当前窗口」做基准：粒子在初始化时按当时视口算死、resize 不重建，
    //   若在小窗口打开再最大化，密度会按小窗口算 → 全屏必然稀疏。按屏幕面积预留，最大化后也对。
    const scrA = (window.screen?.width || mount.clientWidth) * (window.screen?.height || mount.clientHeight);
    const areaK = Math.max(mount.clientWidth * mount.clientHeight, scrA * 0.8) / (1440 * 900);
    // ★ 上限 1 → 2.2：原来 1440×900 就封顶，屏幕再大也不加星 → 密度掉 19%、颗粒变粗 42%
    //   （实测 1280×800 grain 3.09px² → 2560×1440 4.40px²）。大屏要的是【更多的星】，不是【更大的星】。
    const DN = Math.max(0.25, Math.min(2.2, Math.pow(areaK, 0.85))); // 375×812 → 0.29；2560×1440 → 2.2
    // 竖屏上盘会横向撑破画面。缩放盘本身而非拉远相机（拉远会把前景星座一起缩小）
    const aspect0 = mount.clientWidth / Math.max(mount.clientHeight, 1);
    const gScale = 0.42 + 0.58 * Math.min(1, aspect0 / 1.6);

    // 形态 = ① 指数盘：密度向中心集中  ② 对数螺旋 θ = 分支基角 + sweep·(r/R)
    //        ③ 厚度 ∝ exp(-r/rs)：中心鼓、外盘薄 —— 斜视时中央是「一团」、外围是「一张极薄的片」，
    //           这个厚薄反差就是纵深感最强的线索  ④ 独立核球星团（暖色）
    const GR = 24 * gScale;   // 盘半径（世界单位）：俯视圆盘直径铺满画面高度
    const SWEEP = 5.0;        // 旋臂缠绕量（rad）：≈ 0.8 圈/臂，多臂辐射、臂间留隙（方案图多臂涡旋）
    const ARMS = 4;          // 四条旋臂辐射：多条悬臂 + 臂间间隙（方案图多臂结构）
    const gj = () => (rand() + rand() + rand() - 1.5) * 2; // 近似标准正态

    function galaxyMat(size, opacity, maxPx, opt = {}) {
      const mat = new THREE.ShaderMaterial({
        uniforms: {
          uTime: { value: 0 }, uTex: { value: crispTex },
          uSize: { value: size }, uOpacity: { value: opacity },
          uScale: { value: 450 }, uMax: { value: maxPx },
          uDrift: { value: opt.drift || 0 },   // 个体星相对图案的角速度（>0 = 恒星在自己的轨道上跑）
          uChurn: { value: opt.churn || 0 },   // 切向涌动幅度（rad）：星海「活着」但不累积变形
          uWarp: { value: opt.warp || 0 },     // 翘曲幅度：盘外缘在 z 上的起伏
          uDw: { value: opt.dw || 0 },         // 密度波亮度调制强度
          uArms: { value: ARMS }, uSweep: { value: SWEEP }, uGR: { value: GR },
          uMouse: { value: new THREE.Vector2(9999, 9999) },
          uMouseK: { value: 0 },
          uFadeLo: { value: opt.fadeLo ?? 0.55 }, // 远端亮度下限：内容层（星团/文章星）调高，远侧不被空气透视吞掉
          uSteady: { value: opt.steady || 0 }, // 闪烁压缩：文章星=1.0（亮度必须恒定在白热，不能随呼吸暗下去）
          uArmK: { value: new THREE.Vector2(opt.armMinor ?? 1, opt.armMajor ?? 1) }, // ★ 主次臂亮度系数（银河系现代模型：2 主臂接棒端 + 2 次臂）
          uSparseCut: { value: 2.0 }, // ★ 换色粒子稀疏阈值：2=全显（远看团色明显）；0.3=只显 30%（凑近散开）
        },
        vertexShader: `
          attribute vec3 aColor;
          attribute float aSize;
          attribute float aPhase;
          uniform float uTime;
          uniform float uScale;
          uniform float uSize;
          uniform float uMax;
          uniform float uFadeLo;
          uniform float uSteady;
          uniform vec2 uArmK;
          uniform float uSparseCut;
          uniform float uClusterDim;
          attribute float aSparse;
          uniform float uDrift;
          uniform float uChurn;
          uniform float uWarp;
          uniform float uDw;
          uniform float uArms;
          uniform float uSweep;
          uniform float uGR;
          uniform vec2 uMouse;
          uniform float uMouseK;
          varying vec3 vColor;
          varying float vTw;
          varying float vFade;
          void main() {
            vColor = aColor;
            vTw = 0.72 + 0.28 * sin(uTime * (0.30 + fract(aPhase * 7.31) * 0.65) + aPhase * 41.0); // 呼吸：周期 8-21s、亮度 ±28% —— 肉眼可感知的「吸气/呼气」
            vTw = mix(vTw, 0.95, uSteady); // 文章星（uSteady=1）：恒定高位亮度——快周期微闪已删（2026-10-16 用户：聚焦近景亮度抖动；大星核上 ±10% 闪烁可感知）
            float r = length(position.xy);
            // ★ 自转的正确呈现：图案整体刚性转（在 JS 的 galaxySpin 里），个体星在自己的
            //   轨道上另有相对运动。二者的差 = 恒星穿越旋臂。
            float th = atan(position.y, position.x)
              + uDrift * uTime
              + uChurn * sin(uTime * 0.11 + aPhase * 3.7);
            // 密度波：旋臂是「驻留的波形」（θ = branch·2π/ARMS + SWEEP·r/R），只有图案在转；
            //   恒星从波峰流入流出 → 亮度随之胀落。这是真实星系结构永存的机制（林家翘-Shu）。
            float dw = 0.5 + 0.5 * cos(uArms * (th - uSweep * r / uGR));
            vTw *= mix(1.0, 0.42 + 0.58 * pow(dw, 2.0), uDw); // 谷底 0.32→0.42：臂隙保留底光，不压成纯黑（团跨出臂脊时不割裂）
            // ★ 主次臂：半频余弦区分偶臂（棒端，主）与奇臂（次）——银河系现代模型（NASA/JPL 2008）
            vTw *= mix(uArmK.x, uArmK.y, 0.5 + 0.5 * cos(uArms * 0.5 * (th - uSweep * r / uGR)));
            // ★ 换色粒子 LOD 稀疏化：uSparseCut 远看 2（全显）、探索/凑近 0.3（只留 30%）——
            //   aSparse≥cut 的粒子平滑淡出；非换色粒子 aSparse=2 恒全显
            float sparseK = 1.0;
            if (aSparse < 1.5) {
              // 团色粒子（0~1）：远看全显，探索/聚焦只留 6%
              sparseK = smoothstep(aSparse, aSparse + 0.12, uSparseCut);
              vTw *= sparseK;
            } else if (aSparse < 2.8) {
              // 团内银粒（2.0~2.5）：探索/聚焦时隐藏 —— 团区只剩主星+文章星+稀疏绿粒，无雾无坨
              vTw *= 1.0 - uClusterDim;
            }
            // aSparse ≥ 2.8（团外银尘）：恒全显
            // 翘曲：盘外缘沿 z 起伏，旋转时边缘此起彼伏 —— 最省成本的立体运动线索
            float warp = uWarp * pow(clamp(r / uGR, 0.0, 1.0), 2.5) * sin(th - 0.6);
            vec2 pxy = vec2(cos(th) * r, sin(th) * r);
            // Explore 态鼠标引力：靠近鼠标的星尘被轻微吸引（银河开始「回应你」）
            vec2 dm = pxy - uMouse;
            float dl = max(length(dm), 1.4);
            pxy -= (dm / dl) * (uMouseK / dl) * 4.0;
            vec4 mv = modelViewMatrix * vec4(pxy.x, pxy.y, position.z + warp, 1.0);
            // 远暗近亮 ≈ 2.3:1：立体感主要靠【大小梯度】，亮度对比过强会把远半的旋臂压没
            vFade = clamp(1.85 - (-mv.z) * 0.018, uFadeLo, 1.3);
            float s = uSize * aSize * (uScale / -mv.z) * (0.84 + 0.16 * vTw);
            // 存留颗粒保持锐利小点（放大软点=雾）
            gl_PointSize = uMax * s / (uMax + s); // 软钳：保留近远梯度，又不炸成光斑
            gl_Position = projectionMatrix * mv;
          }`,
        fragmentShader: `
          uniform sampler2D uTex;
          uniform float uOpacity;
          varying vec3 vColor;
          varying float vTw;
          varying float vFade;
          void main() {
            vec4 tex = texture2D(uTex, gl_PointCoord);
            // 空气透视：越远越沉入夜空冷色 —— 深邃感的第二条线索
            // 空气透视：蓝味从 (0.60,0.70,0.94)×0.45 降到 (0.74,0.80,0.90)×0.34 —— 远处沉入夜色但不发蓝
            vec3 col = mix(vColor, vec3(0.74, 0.80, 0.90), clamp((1.0 - vFade) * 0.34, 0.0, 0.16));
            gl_FragColor = vec4(col * tex.rgb, tex.a * uOpacity * vTw * vFade);
          }`,
        transparent: true, depthWrite: false,
      });
      dustMats.push(mat);
      mat.userData.baseMax = maxPx;
      mat.userData.baseChurn = opt.churn || 0;
      return mat;
    }

    // 核球暖色（老年星族）：盘心银白星尘按 r^-0.6 累积会糊成一个【中性白团】——
    // 实测核心饱和度只有 0.043（近乎纯白）。用色相把它染成琥珀（站点 --accent #d9a920 同系），
    // 中心就变成「暖核」而不是「白饼」；比 cull 掉中心更好——既去白，又不挖空。
    const cWarmCore = new THREE.Color(0xffd98a);
    // 臂隙淡蓝填充（用户指定：臂隙中间填淡淡的蓝色）
    const cGapWarm = new THREE.Color(0xcabfa8); // ★ 臂隙改暖中性（原淡蓝反了：真实星系臂脊蓝/臂隙老年偏黄）
    // 内臂紫金（用户：红框内旋臂太淡，加紫金色、向外慢慢过渡回银）——
    // 色相同源中心彩色微尘的紫金盘。★ 紫调偏蓝一档：#b892e8 的 R=184 偏高，
    //   与暖核的琥珀叠加后 R、B 双高 → 读作「粉」（用户：偏粉色了）。
    //   0x9488e8：饱和度 0.42 的蓝紫（R-G 仅 12、B-G 96）——亮度越高越不翻粉，连接段可见度靠它。
    //   ★ 金已完全撤出这一层（用户：粉还是重）——金交给暖核表达，紫金区不再掺金。
    const cVioletArm = new THREE.Color(0x9488e8);
    const cVioletIn = new THREE.Color(0xb09ad8);  // 暖紫：金→紫的中间站，避免金紫硬碰
    // ★ 0.30GR → 0.18GR：琥珀染到 0.30GR 时，紫金区（0.15~0.55GR）的紫是叠在琥珀上的
    //   → R、B 双高读作「粉」（用户：偏粉）。琥珀只守核周，紫金区交还给紫。
    // ★ 强度 0.8 → 0.4：金色已由核球粒子海（cAmber 渐变）承担，盘星再染一遍会和紫撞色
    //   （用户：金色和外面的紫色过渡不自然）。
    const coreWarmMix = (rr: number) => Math.min(1, Math.max(0, 1 - (rr / GR) / 0.10)); // ★ 暖圈收窄（原 0.18 外溢把中心区染脏，用户：脏脏的）

    // 盘星（含旋臂调制）：spread 越小 → 越贴臂线，旋臂越清晰
    function makeDisk(count, spread, size, opacity, maxPx, warmMix, bright, opt = {}) {
      const arr = new Float32Array(count * 3);
      const col = new Float32Array(count * 3);
      const sz = new Float32Array(count);
      const pha = new Float32Array(count);
      // 银白色调（用户：过于偏蓝，要银白感）—— 冷色去饱和成银白、外盘换成银灰蓝
      // ★ 真·银白：原 0xdde1ea 的 B-R=13，本身就偏蓝（实测盘内亮像素 44% 偏蓝）。
      //   0xe3e5e7 的 B-R 仅 4 —— 中性银，把色相留给「暖核 ↔ 银灰外盘」的梯度去表达。
      const cCool = new THREE.Color(0xe3e5e7);   // 银（近中性，B-R=4）
      const cWarm = new THREE.Color(0xfff0d2);
      const cOuter = new THREE.Color(0xa7aeb6);  // 外盘银灰（饱和度 0.29→0.08，不再发蓝）
      const cGiant = new THREE.Color(0xffb070); // 橙红巨星：参考图里的橙色主角星
      const cYoung = new THREE.Color(0xc9d6ea); // 冷银白年轻星（原 0xa9c8ff 饱和度 0.34→0.14）
      for (let i = 0; i < count; i++) {
        const u = rand();
        // ★ barStart = 旋臂起始半径（占 GR 比例）：棒旋的臂从【棒端】长出，不再从盘心发散。
        //   相位同步改为 SWEEP·((r0-rIn)/GR)，这样在 r0=rIn 处 th 正好等于 branch·2π/ARMS
        //   = 0 / π/2 / π / 3π/2 —— 第 0、2 条臂的起点正对棒的 ansae（长轴两端）。
        const rIn = (opt.barStart || 0) * GR;
        const r0 = rIn + Math.pow(u, opt.barStart ? 0.55 : 0.72) * (GR - rIn); // 有棒时臂根加权：臂从棒端长出时是亮的，不留暗隙
        const branch = Math.floor(rand() * ARMS);
        // armShift：整层粒子的臂相位偏移——π/4 = 正好落在 ARMS=4 的臂间空隙（臂间丝带用）
        const th = branch * ((Math.PI * 2) / ARMS) + (opt.armShift || 0) + SWEEP * ((r0 - rIn) / GR) + gj() * (spread * (0.35 + 0.9 * r0 / GR));
        const rr = Math.max(Math.max(0.2, rIn * 0.9), r0 + gj() * (spread * GR * (0.25 + 0.75 * r0 / GR)));
        arr[i * 3] = Math.cos(th) * rr;
        arr[i * 3 + 1] = Math.sin(th) * rr;
        // 厚度：中心鼓包 + 外盘薄 —— 斜视下的「纵深感」几乎全来自这一行
        // ★ 用户：带宽宽一点 —— 薄盘基底 0.16→0.30、整体 ×1.15（只加宽盘带，核球不跟着鼓胀）
        const bulge = Math.exp(-Math.pow(Math.min(rr / (GR * 0.24), 20), 1.4));
        // ★ 中心加厚项 2.2→0.7：原来盘心粒子沿法线散布 ±2.9 世界单位（尾巴 ±8.6），
        //   倾斜视角下投影成一根竖直的「粒子柱」——看起来像有人往核里插了条竖线。
        //   外盘不受影响（bulge≈0，厚度仍是 1.15×0.30）。
        // 厚度在盘心归零（zRamp）：r→0 处盘面内没有粒子，任何 z 散布都会投影成一条竖线；
        //   那里本来就有核心 sprite 挡着，不需要粒子厚度。
        const zRamp = Math.min(1, rr / (GR * 0.14));
        arr[i * 3 + 2] = gj() * 1.15 * (0.30 + 0.7 * bulge) * zRamp;
        // 内暖外冷（真实的星族渐变）：中心呼应站点的琥珀，外围是冷蓝夜
        const warm = Math.min(1, Math.max(0, 1 - (rr / GR) * 1.6)) * (rand() * 0.6 + 0.4) * warmMix;
        // 外盘渐入冷蓝：让盘有「内暖外冷」的色阶，而不是整片同色的灰白
        const outK = Math.min(1, Math.max(0, (rr / GR - 0.42) / 0.58)) * 0.5; // 0.6→0.5：外盘冷化减弱
        // 星族点缀：主角星（橙红巨星/蓝白年轻星）—— 用户反馈红粒偏多：橙巨星概率 1.2%→0.5%
        // ★ 主臂脊恒星形成区（NASA/SDSS）：蓝白星份额 ×2.2、0.5% 淡粉 HII 结（稍大）——只在本团臂脊
        const onMajorRidge = opt.starKnots
          ? (0.5 + 0.5 * Math.cos(ARMS * (th - SWEEP * rr / GR))) * (0.5 + 0.5 * Math.cos(ARMS * 0.5 * (th - SWEEP * rr / GR)))
          : 0;
        // ★ 次臂也有星星工厂（BeSSeL：气体/年轻星示踪四臂，恒星质量集中双主臂）：40% 密度
        const onMinorRidge = opt.starKnots
          ? (0.5 + 0.5 * Math.cos(ARMS * (th - SWEEP * rr / GR))) * (1 - (0.5 + 0.5 * Math.cos(ARMS * 0.5 * (th - SWEEP * rr / GR))))
          : 0;
        const youngBoost = onMajorRidge > 0.62 ? 2.2 : onMinorRidge > 0.62 ? 1.25 : 1;
        const pinkK = opt.starKnots && rand() < (onMajorRidge > 0.72 ? 0.005 : onMinorRidge > 0.72 ? 0.002 : 0);
        const giantK = rand();
        let c;
        if (pinkK) c = new THREE.Color(0xd89ab4);
        else if (giantK < 0.004) c = cGiant.clone();
        else if (giantK < 0.02 * youngBoost) c = cYoung.clone();
        else c = cCool.clone().lerp(cWarm, warm).lerp(cOuter, outK);
        if (opt.coolShift) c = c.clone().lerp(cYoung, opt.coolShift); // 臂层冷色温：年轻星族
        const cwK = coreWarmMix(rr);
        if (cwK > 0) c = c.clone().lerp(cWarmCore, cwK * 0.4); // 核球暖化：去白（0.8→0.4：金交给核球海，避免与紫撞色）
        // 臂隙淡蓝：臂脊（dw≈1）不动，臂隙（dw≈0）染淡蓝 —— 臂/隙之间多一层色温与色相差。
        //   臂星基本都落在 dw 高处，所以这层只作用于臂隙的散星。
        const gapK = (1 - (0.5 + 0.5 * Math.cos(ARMS * (th - SWEEP * rr / GR))))
          * 0.8 * Math.min(1, Math.max(0, (rr / GR - 0.30) / 0.20));
        if (gapK > 0.01) c = c.clone().lerp(cGapWarm, gapK);
        // 内臂紫金渐变（opt.vg = 强度 0~1）：
        //   径向——0.15GR 全量 → 0.55GR 归零（核区留给暖核 sprite，外盘归还银灰）；
        //   角向——只染臂脊（dw 高处），臂隙的淡蓝不被紫金污染；
        //   色相——内端偏金（呼应暖核）、外端偏紫，正好接住「暖核 → 银外盘」的中间段。
        //   ★ 同时给一点尺寸增益：内臂粒子本来就又小又暗，低亮度下色相差读不出来
        //     （实测只染色不可见）——亮度抬起来，紫金才「存在」。
        let vgT = 0;
        if (opt.vg) {
          const vgR = rr / GR;
          // ★ 硬切 → 宽渐变（用户：金色和外面的紫色过渡不自然）：
          //   原 0.15GR 直接全量、0.55GR 归零，而琥珀染到 0.18GR —— 紫压在还没退场的琥珀上，生硬。
          //   改为：0.08GR 起爬 → 0.30GR 满 → 0.38~0.72GR 衰减回银，宽度翻倍。
          const vgK = Math.min(1, Math.min(Math.max(0, (vgR - 0.08) / 0.22),
            1 - Math.max(0, (vgR - 0.38) / 0.34)));
          if (vgK > 0.01) {
            const dwv2 = 0.5 + 0.5 * Math.cos(ARMS * (th - SWEEP * rr / GR));
            const t = vgK * opt.vg * Math.min(1, dwv2 * 1.4);
            if (t > 0.01) {
              vgT = t;
              // 紫也分内外：内端暖紫（接得上金）→ 外端蓝紫（接得上银），中间自然过渡
              const vgCol = cVioletIn.clone().lerp(cVioletArm, Math.min(1, Math.max(0, (vgR - 0.10) / 0.35)));
              c = c.clone().lerp(vgCol, t * (0.35 + 0.65 * vgR));
            }
          }
        }
        // ★ 颜色写入必须在 cullK 之后：gl_PointSize 有 1px 下限，被 cull 的粒子尺寸缩到 0
        //   仍会以 1px、全亮度写进画面。盘心处 Math.max(0.2,...) 把大量粒子钳到同一半径，
        //   这些「已裁掉」的粒子叠在一起 → 就是核里残留的金色亮点。
        //   把 cullK 同时乘进颜色，裁掉 = 真的消失（尺寸 × 亮度双重衰减）。
        // 粒度幂律：海量 1px 级微星融成连续星海，极少数大星 —— 深邃 = 大小跨度，不是星星多
        // 美化②⑤：内盘粒子稍大（叠加成光）、盘外缘渐隐（四周收进黑夜）
        // gapCull：臂间隙清理——离臂脊最暗带的散点直接隐没（用户：臂间隙杂星尘乱）
        let cullK = 1;
        if (opt.gapCull) {
          const dwv = 0.5 + 0.5 * Math.cos(ARMS * (th - SWEEP * rr / GR));
          if (dwv < opt.gapCull) cullK = 0.12; // 近零：视觉上清走，密度/相位体系不动
        }
        // ★ 原 bug：这段被嵌在 if (opt.gapCull) 里 → 没传 gapCull 的层（galArms）的
        //   centerClean 完全不生效，盘心因此堆满臂星（coreWarmMix 把它们染成琥珀 →
        //   就是用户看到的「核里的金色粒子」）；且硬编码 0.32/0.46，参数传了也不读。
        //   现改为独立块并读参数：内界 = opt.centerClean。
        // ★ 羽化 0.14→0.10 且改 sqrt 爬升（用户：旋臂与核球连接的那一圈太淡/发空）。
        //   实测 r=40~90px 有一圈「护城河」：mean 7.7、亮像素仅 1%，而臂区是 13~14.6 / 17~20%——
        //   旋臂根本没接到核上。线性羽化要爬到 0.26GR 才恢复亮度，把连接段整个压暗了；
        //   sqrt 羽化在羽化带 25% 处就回到 0.5 亮度，臂能贴着核长出来，同时核心仍清到近零。
        if (opt.centerClean) {
          const c0 = opt.centerClean, c1 = c0 + 0.10, cr = rr / GR;
          if (cr < c0) cullK = Math.min(cullK, 0.02);                                  // 核心区：清到近零
          else if (cr < c1) cullK = Math.min(cullK, 0.02 + Math.sqrt((cr - c0) / 0.10) * 0.98); // 羽化：sqrt 快恢复
        }
        col[i * 3] = c.r * cullK; col[i * 3 + 1] = c.g * cullK; col[i * 3 + 2] = c.b * cullK;
        // 地板 0.35→0.46、幂次 4→3.2：中位粒子变大变亮（银河带面亮度的主要来源），尾部巨星不动
        sz[i] = (0.52 + 0.48 * Math.pow(rand(), 3.0)) * bright * cullK * (1.12 - 0.12 * (rr / GR)) * Math.max(0.3, 1 - Math.max(0, rr / GR - 0.85) / 0.15 * 0.7) * (1 + vgT * 0.65); // 紫金区粒子放大：色相要亮度才可读（0.5→0.65：琥珀撤出后连接段偏暗，补一档）
        if (giantK < 0.009) sz[i] *= 1.7 + rand() * 0.8; // 主角星收敛：亮点不抢戏
        if (pinkK) sz[i] *= 1.6; // HII 结稍大：臂上的「星星工厂」
        pha[i] = rand() * Math.PI * 2;
      }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(arr, 3));
      geo.setAttribute('aColor', new THREE.BufferAttribute(col, 3));
      geo.setAttribute('aSize', new THREE.BufferAttribute(sz, 1));
      geo.setAttribute('aPhase', new THREE.BufferAttribute(pha, 1));
      geo.boundingSphere = new THREE.Sphere(new THREE.Vector3(), GR * 1.7);
      const pts = new THREE.Points(geo, galaxyMat(size, opacity, maxPx, opt));
      (opt.parent ?? galaxySpin).add(pts);
      return pts;
    }

    // 核球：扁椭球星海，暖色、密集 —— 星系的视觉锚点
    // ★ 重新启用（用户：银河系中心不是一颗星辰，是旋臂的交汇）。
    //   「交汇处」的正确做法是用【粒子海堆出延展亮区】，不是画一颗 sprite 亮星：
    //   粒子堆积自带密度涨落 → 读作「无数星的叠加」；sprite 只是「一颗星」，与星海质感断裂。
    function makeBulge(count, size = 0.30, opacity = 0.92, maxPx = 9, szMul = 0.7, parent = galaxySpin) {
      const arr = new Float32Array(count * 3);
      const col = new Float32Array(count * 3);
      const sz = new Float32Array(count);
      const pha = new Float32Array(count);
      const cHot = new THREE.Color(0xffeec8);   // 核心：暖白（白只占极小核心，不糊成一团白饼）
      const cAmber = new THREE.Color(0xe0a860); // 核球外缘：琥珀，衔接内臂紫金
      for (let i = 0; i < count; i++) {
        // 径向：指数面亮度轮廓 Σ(r)∝e^(-r/h) → 面元权重 r·e^(-r/h) → 两个指数分布之和（Gamma(2)）
        //   h=0.05GR：均半径 ~0.1GR、尾巴铺到 ~0.3GR，正好是参考图那种「尘埃围着核、向外渐隐」。
        //   ★ +0.05GR 内界（用户：参考图的核是近似透明的）：挖空最中心，尘埃只从环外长出来——
        //   透明核的「洞」由粒子海留白，sprite 只描一圈半透明环。
        //   h 0.05→0.062、粒数下调（用户：金色颗粒再散一点、别这么密集）
        const rb = Math.min(GR * 0.45, GR * 0.05
          + -(Math.log(1 - rand() * 0.999) + Math.log(1 - rand() * 0.999)) * GR * 0.062);
        const tb = rand() * Math.PI * 2;
        arr[i * 3] = Math.cos(tb) * rb;
        arr[i * 3 + 1] = Math.sin(tb) * rb * 0.85;
        // z 厚度：① 必须小于盘倾角下的投影短轴，否则核球在斜视时拉成「竖条」；
        //   ② 在 r→0 处归零（同盘层 zRamp 的教训）：盘心没有面内尺度，任何 z 散布都会投影成一条竖线。
        arr[i * 3 + 2] = gj() * GR * 0.030 * Math.min(1, rb / (GR * 0.06));
        const t = Math.min(1, rb / (GR * 0.22));
        const c = cHot.clone().lerp(cAmber, t);
        col[i * 3] = c.r; col[i * 3 + 1] = c.g; col[i * 3 + 2] = c.b;
        // 尺寸：不再放大中心（过曝感已由 sprite 环接管），保持均匀颗粒
        sz[i] = (0.35 + 0.65 * Math.pow(rand(), 3)) * szMul;
        pha[i] = rand() * Math.PI * 2;
      }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(arr, 3));
      geo.setAttribute('aColor', new THREE.BufferAttribute(col, 3));
      geo.setAttribute('aSize', new THREE.BufferAttribute(sz, 1));
      geo.setAttribute('aPhase', new THREE.BufferAttribute(pha, 1));
      geo.boundingSphere = new THREE.Sphere(new THREE.Vector3(), GR * 0.4);
      const pts = new THREE.Points(geo, galaxyMat(size, opacity, maxPx));
      parent.add(pts);
      return pts;
    }

    // 核心光晕：少量大尺寸低透明暖点叠在核球上 —— 概念图里的「暖核辉光」。
    // 没有它，核球只是一团离散小点，星系没有可辨识的中心，整体读作「两条弧线」。
    function makeCoreGlow(count, radius, size, opacity, maxPx, parent = galaxySpin) {
      const arr = new Float32Array(count * 3);
      const col = new Float32Array(count * 3);
      const sz = new Float32Array(count);
      const pha = new Float32Array(count);
      const cCore = new THREE.Color(0xfff3dc);
      for (let i = 0; i < count; i++) {
        const rb = Math.abs(gj()) * radius;
        const tb = rand() * Math.PI * 2;
        arr[i * 3] = Math.cos(tb) * rb;
        arr[i * 3 + 1] = Math.sin(tb) * rb * 0.85;
        arr[i * 3 + 2] = gj() * radius * 0.4;
        col[i * 3] = cCore.r; col[i * 3 + 1] = cCore.g; col[i * 3 + 2] = cCore.b;
        sz[i] = 0.5 + rand() * 0.5;
        pha[i] = rand() * Math.PI * 2;
      }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(arr, 3));
      geo.setAttribute('aColor', new THREE.BufferAttribute(col, 3));
      geo.setAttribute('aSize', new THREE.BufferAttribute(sz, 1));
      geo.setAttribute('aPhase', new THREE.BufferAttribute(pha, 1));
      geo.boundingSphere = new THREE.Sphere(new THREE.Vector3(), GR * 0.4);
      const pts = new THREE.Points(geo, galaxyMat(size, opacity, maxPx));
      parent.add(pts);
      return pts;
    }

    // ===== 棒（棒旋星系的「棒」）=====
    // 物理：棒 = 老年星族的椭球状密度过剩；两条主臂从棒端（ansae）长出。
    // ★ 必须挂 galaxySpin（与旋臂同一图案速度）：挂 spinCore（0.007 vs 盘层 0.014）会让
    //   旋臂在几十秒内从棒端滑走——棒和臂是一个 m=2 模式，不能差速。
    // ★ 配色：棒 = 老年星族（琥珀），臂 = 年轻星族（银/淡紫）—— 与站点「金核→银盘」色阶同源。
    const BAR_A = GR * 0.26, BAR_B = GR * 0.095; // 半长轴/半短轴（★ 银河系实测：棒全长 2.7 万光年/盘径 10 万 ≈ 0.26；轴比 ≈ 2.7:1）
    function makeBar(count, size = 0.45, opacity = 0.82, maxPx = 12, szMul = 0.62, parent = galaxySpin) {
      const arr = new Float32Array(count * 3);
      const col = new Float32Array(count * 3);
      const sz = new Float32Array(count);
      const pha = new Float32Array(count);
      const cBarIn = new THREE.Color(0xf6d29a); // 内侧：亮暖琥珀（接核球金尘）
      const cBarOut = new THREE.Color(0xe2ab60); // 外侧：深琥珀（接臂的银）
      for (let i = 0; i < count; i++) {
        // 椭圆坐标采样：u = rand^0.75 → 面密度 ∝ u^(-2/3)，略向中心集中（棒内侧更亮）
        const u = Math.pow(rand(), 0.85);
        const tb = rand() * Math.PI * 2;
        let x = Math.cos(tb) * BAR_A * u;
        let y = Math.sin(tb) * BAR_B * u;
        const jit = (0.004 + 0.012 * (1 - u)) * GR; // 边缘软化：不留硬边（0.02→0.012：棒形要立得住）
        x += gj() * jit; y += gj() * jit;
        arr[i * 3] = x;
        arr[i * 3 + 1] = y;
        const rEll = Math.hypot(x / BAR_A, y / BAR_B);
        // 厚度：棒是盘内结构，比盘薄；rEll→0 处归零（竖线教训同盘层 zRamp）
        // ★ 花生形（SHAO/ESO 盒状-花生核球）：厚度包络在 |x|≈0.35A 两侧隆起 —— 倾斜侧视时
        //   棒剪影呈花生腰身（俯瞰无感，结构性彩蛋）
        const peanut = 1 + 1.3 * Math.exp(-Math.pow(Math.abs(x) / BAR_A - 0.35, 2) / 0.09);
        arr[i * 3 + 2] = gj() * GR * 0.018 * Math.min(1, rEll) * peanut;
        const c = cBarIn.clone().lerp(cBarOut, Math.min(1, rEll));
        // ansa（棒端把手）：真实棒两端常有一对增亮结 —— 也是旋臂的起点
        const ansa = Math.max(0, (Math.abs(x) / BAR_A - 0.62) / 0.38);
        const f = 1 + Math.pow(ansa, 1.5) * 0.7;
        col[i * 3] = c.r * f; col[i * 3 + 1] = c.g * f; col[i * 3 + 2] = c.b * f;
        sz[i] = (0.3 + 0.7 * Math.pow(rand(), 3)) * szMul * f;
        pha[i] = rand() * Math.PI * 2;
      }
      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(arr, 3));
      geo.setAttribute('aColor', new THREE.BufferAttribute(col, 3));
      geo.setAttribute('aSize', new THREE.BufferAttribute(sz, 1));
      geo.setAttribute('aPhase', new THREE.BufferAttribute(pha, 1));
      geo.boundingSphere = new THREE.Sphere(new THREE.Vector3(), GR * 0.5);
      const pts = new THREE.Points(geo, galaxyMat(size, opacity, maxPx));
      parent.add(pts);
      return pts;
    }

    // 七层。每层的「运动角色」不同 —— 自转看起来对不对，全在这七行的 opt 上：
    //   churn = 涌动（短周期摆动，让星海不死板，且永不累积变形）
    //   drift = 真正的个体漂移（只在 tracer 层给，数量少，长期变形不可见）
    //   dw    = 密度波亮度调制（0 = 亮度与臂无关；1 = 完全由「是否在臂上」决定亮度）
    //   warp  = 盘外缘翘曲：旋转时边缘此起彼伏，是「三维空间中的运动」最强的廉价线索
    // ★ 旋臂「展宽」而非「压黑臂隙」：亮区半宽要接近星团尺度（团雾 ~110px、团成员云 ~52px），
    //   否则团的外围必然跨出臂脊伸进暗隙，读起来像「贴在一根细线上」。
    //   spread 0.055→0.10 / 0.085→0.14（亮区半宽 ~20px → ~40px），dw 略降让臂隙留住底光。
    //   ★ 展宽必须同步加量：光是加宽 spread 会把同样的粒子摊薄，脊峰反而变暗（实测 bandLum 9.6→9.0）。
    //     粒数按展宽倍数补：20000→32000（×1.6）、9000→14000（×1.55）。
    const galDisk  = makeDisk(Math.round(24000 * DN), 0.10, 0.24, 0.72, 9, 0.62, 1, // ★ 减密（用户：背景星星太多） // size 0.27：颗粒细化（用户：全屏大颗粒粗糙）
      // vg 0.32：紫金渐变强度。★ 不要再改这里的旋臂径向结构（barStart 已废，见 makeBar 注释）
      { churn: 0.012, warp: 0.6, dw: 0.62, gapCull: 0.12, centerClean: 0.055, vg: 0.32 });
    const galArms  = makeDisk(Math.round(11000 * DN), 0.14, 0.38, 0.9, 12, 0.35, 1.5, // ★ 减密 // 臂脊银星加量+细化
      { churn: 0.014, warp: 0.6, dw: 0.78, centerClean: 0.055, coolShift: 0.22, armMinor: 0.62, armMajor: 1.3, starKnots: true }); // ★ 主次臂分级 + 恒星形成区
    // 臂隙填充（用户：旋臂中间别那么空）：dw=0 的均匀银尘层——不受密度波调制，
    // 淡淡铺满整个盘面（含臂隙），旋臂亮、臂隙淡，不再「臂外全黑」
    let galFill: THREE.Points;
    {
      // 絮状填充（用户：絮状 = 顺流向拉长的短弧丝，不是圆球团）：
      // 短弧丝（总量 30000×DN），每条沿旋臂流向弯曲、切向拉长，粒数 8~33，疏密随机；
      // 角度分槽+抖动：丝缕覆盖所有方位角，抹平臂隙的整片空区；亮度均值上调更可见
      const N_TOTAL = Math.round(15500 * DN); // ★ 减密（原 21000） // 16000→21000：臂隙填充需要真材实料，光染色看不出来 // 减半：清澈=絮间见纯黑（略加：絮层是天然的「盘底光」，dw=0 与臂无关，专治臂隙纯黑）
      const arrF = new Float32Array(N_TOTAL * 3);
      const colF = new Float32Array(N_TOTAL * 3);
      const szF = new Float32Array(N_TOTAL);
      const phaF = new Float32Array(N_TOTAL);
      const cFill = new THREE.Color(0xe3e5e7); // 银（与盘基色一致）
      const rngF = mulberry32(774411);
      let w = 0;
      let slot = 0;
      let thTint: THREE.Color | null = null; // 当前丝的微色温
      const NSLOTS = 24;
      while (w < N_TOTAL) {
        const r0 = GR * (0.12 + 0.94 * Math.sqrt(rngF())); // 内界对齐 centerClean 的 0.12GR：核心光球内不留絮
        const th0 = (((slot++) % NSLOTS) + rngF() * 0.9) / NSLOTS * Math.PI * 2;
        const arc = 0.08 + rngF() * 0.38;                   // 弧丝长短差异拉开
        const n = Math.min(N_TOTAL - w, 8 + Math.floor(rngF() * 26));
        const thDir = rngF() > 0.5 ? 1 : -1;
        const jit = 0.12 + rngF() * 0.5;                    // 每条丝自己的松散度（收紧：缕更明确）
        const bow = 0.02 + rngF() * 0.09;                   // 每条丝自己的弯曲度
        // ★ 丝级微色温（治色彩单调）：整丝一色，银为主，淡蓝/淡金/淡玫瑰少量点缀
        const tr = rngF();
        thTint = tr < 0.14 ? new THREE.Color(0xb9c9e6)
               : tr < 0.24 ? new THREE.Color(0xe6d6ae)
               : tr < 0.30 ? new THREE.Color(0xd9bcc6)
               : null;
        for (let i = 0; i < n && w < N_TOTAL; i++, w++) {
          const t = n > 1 ? i / (n - 1) : 0.5;
          const th = th0 + thDir * t * arc;
          const rr = Math.max(r0, GR * 0.12) * (1 + Math.sin(t * Math.PI) * bow * thDir); // 弧丝微弯（沿流向鼓一点）；整体抬到核心光海之外（主星禁入）
          const px = Math.cos(th) * rr;
          const py = Math.sin(th) * rr * 0.9;
          const perp = (rngF() - 0.5) * 2 * jit;             // 细垂直抖动：丝而不绳，宽窄随机
          arrF[w * 3] = px + (-Math.sin(th)) * perp;
          arrF[w * 3 + 1] = py + Math.cos(th) * perp * 0.9;
          arrF[w * 3 + 2] = (rngF() - 0.5) * 1.3;
          const f = 0.34 + rngF() * 0.62;
          const cFx = cFill.clone().lerp(cWarmCore, coreWarmMix(rr) * 0.45); // ★ 絮层暖化减半（原 0.8 配合大暖圈=中心一片脏棕）
          // 臂隙冷银：dw=1 在臂脊（不冷化）、dw=0 在臂隙正中（冷化最强）。
          //   只在 r>0.30GR 生效 —— 内区旋臂缠绕太密，dw 变化快，冷化会斑驳成一团乱色。
          const dwvF = 0.5 + 0.5 * Math.cos(ARMS * (th - SWEEP * rr / GR));
          const gapRad = Math.min(1, Math.max(0, (rr / GR - 0.30) / 0.20));
          const gapK = (1 - dwvF) * gapRad;              // 0=臂脊 1=臂隙正中
          const gapTint = gapK * 0.85;
          if (gapTint > 0.01) cFx.lerp(cGapWarm, gapTint);
          if (thTint) cFx.lerp(thTint, 0.45);
          colF[w * 3] = cFx.r * f; colF[w * 3 + 1] = cFx.g * f; colF[w * 3 + 2] = cFx.b * f;
          szF[w] = (0.2 + rngF() * 0.42) * (1 + gapK * 1.1); // 臂隙多填一点：只染色看不出来，得有星
          phaF[w] = rngF() * Math.PI * 2;
        }
      }
      const geoF = new THREE.BufferGeometry();
      geoF.setAttribute('position', new THREE.BufferAttribute(arrF, 3));
      geoF.setAttribute('aColor', new THREE.BufferAttribute(colF, 3));
      geoF.setAttribute('aSize', new THREE.BufferAttribute(szF, 1));
      geoF.setAttribute('aPhase', new THREE.BufferAttribute(phaF, 1));
      geoF.boundingSphere = new THREE.Sphere(new THREE.Vector3(), GR * 1.7);
      galFill = new THREE.Points(geoF, galaxyMat(0.42, 0.54, 9, { churn: 0.01, warp: 0.7 })); // 絮粒细化；opacity 0.45→0.54 = 抬盘底光
      galFill.material.blending = THREE.AdditiveBlending;
      galaxySpin.add(galFill);
    }

    // ★ 主臂羽毛短刺（spurs/feathers，真实旋臂的次结构；猎户臂就是一条 spur）：
    //   沿两条主臂脊（branch 0/2）每隔一段分出短弧刺，向外下游撇；亮度 ≤ 臂的 55%
    {
      const rngS = mulberry32(20261013);
      const pos: number[] = [];
      const colS: number[] = [];
      const szS: number[] = [];
      const phaS: number[] = [];
      const cSpur = new THREE.Color(0xd9dde3);
      for (const branch of [0, 2]) {
        const baseTh = branch * ((Math.PI * 2) / ARMS);
        for (let rr = GR * 0.38; rr < GR * 0.95; rr += GR * 0.16) {
          if (rngS() < 0.3) continue;
          const th0 = baseTh + SWEEP * (rr / GR) + (rngS() - 0.5) * 0.1;
          const len = GR * (0.14 + rngS() * 0.06);
          const n = 26 + Math.floor(rngS() * 10);
          for (let i = 0; i < n; i++) {
            const t = i / (n - 1);
            // ★ v2 可见性重设计：起点在臂脊外侧 0.03GR，向外侧暗区伸展 ——
            //   在暗背景上才有对比度（贴着亮臂脊的淡丝不可见，已被开关实验证伪）
            const rr2 = rr + GR * 0.03 + t * len * Math.sin(0.75);
            const th = th0 + (t * len * Math.cos(0.75)) / Math.max(rr2, 1);
            const perp = (rngS() - 0.5) * 0.10;
            pos.push(Math.cos(th) * rr2 - Math.sin(th) * perp * rr2 * 0.1,
                     Math.sin(th) * rr2 * 0.9 + Math.cos(th) * perp * rr2 * 0.09,
                     (rngS() - 0.5) * 0.9);
            const f = (0.55 + rngS() * 0.4) * (1 - t * 0.35);
            colS.push(cSpur.r * f, cSpur.g * f, cSpur.b * f);
            szS.push(0.5 + rngS() * 0.4);
            phaS.push(rngS() * Math.PI * 2);
          }
        }
      }
      const geoS = new THREE.BufferGeometry();
      geoS.setAttribute('position', new THREE.BufferAttribute(new Float32Array(pos), 3));
      geoS.setAttribute('aColor', new THREE.BufferAttribute(new Float32Array(colS), 3));
      geoS.setAttribute('aSize', new THREE.BufferAttribute(new Float32Array(szS), 1));
      geoS.setAttribute('aPhase', new THREE.BufferAttribute(new Float32Array(phaS), 1));
      geoS.boundingSphere = new THREE.Sphere(new THREE.Vector3(), GR * 1.2);
      const galSpur = new THREE.Points(geoS, galaxyMat(0.5, 0.85, 9, { churn: 0.01, warp: 0.6 }));
      galSpur.material.blending = THREE.AdditiveBlending;
      dustMats.push(galSpur.material);
      galaxySpin.add(galSpur);
    }
    // ★ 重新点亮（原 3200 且 visible=false）：核球尘埃围绕半透明环状核（用户参考图形态）；
    //   密度不能堆太高——参考图的核周尘埃是「颗粒可辨」的，堆实了就成了金团。
    const galBulge = makeBulge(Math.round(2500 * DN), 0.5, 0.96, 16, 0.6, spinCore); // ★ 金尘再减量调淡（用户：中心周围橘色脏脏的）
    const galCore  = makeCoreGlow(Math.round(70 * DN), GR * 0.10, 6, 0.13, 80, spinCore); // 暖核收敛：提气不抢戏
    // ★ 棒暂不参与渲染：上一版为「臂从棒端长出」改动了旋臂径向分布，把用户调好的内区色彩
    //   结构整段删掉 —— 已回滚。棒只能做【纯叠加层】，绝不许动 makeDisk 的径向/相位。
    // ★ 棒旋星系的「棒」上线（用户点破语义）：盘面内的椭球长条，旋臂从棒端长出。
    //    纯叠加层（教训：绝不许动 makeDisk 的径向/相位）；暖琥珀接核球金尘
    const galBar = makeBar(Math.round(3000 * DN), 0.42, 0.68, 11, 0.6, galaxySpin);
    galBar.rotation.z = SWEEP * 0.26; // ★ 棒端对齐臂根：旋臂在棒端半径的相位角（两主臂从棒端长出，NGC 1300 形态）


    const galSheen = makeDisk(Math.round(400 * DN), 0.075, 1.9, 0.03, 20, 0.55, 1, // 减量：中心白点退场
      { churn: 0.010, warp: 0.6, dw: 0.85 });
    const galHalo  = makeDisk(Math.round(280 * DN), 0.09, 1.30, 0.03, 20, 0.5, 1, // 减量
      { churn: 0.008, warp: 2.4, dw: 0.3, parent: spinOuter });

    // ===== 中心巨星（用户：中间收成一颗发光的巨星）=====
    // 核球/微光/辉光/四芒碎粒全部退场，换成三层叠出的干净发光巨星：
    // 白热核 + 暖光内晕 + 大范围暖色外晕。挂在 galaxyTilt 上（跟随盘心与滚动位移）。
    galCore.visible = false;
    galSheen.visible = false;
    galHalo.visible = false;
    {
      const star = new THREE.Group();
      const mkStar = (tex: THREE.Texture, scale: number, opacity: number, color: number) => {
        const sp = new THREE.Sprite(new THREE.SpriteMaterial({
          map: tex, color: new THREE.Color(color), transparent: true, opacity,
          depthWrite: false, blending: THREE.AdditiveBlending, fog: false,
        }));
        sp.scale.setScalar(scale);
        star.add(sp);
      };
      // 全高斯无平台：任何一层都没有「实心盘」，透明感来自低透明度+平滑衰减
      // ★ 去白（用户：核心球太白）。两个原因叠加：
      //   ① 紫晕 0xc9a6e8 与琥珀 0xfaeed2 是互补色，Additive 相加 → 饱和度互相抵消 → 中性灰
      //      （实测核心 sat 仅 0.043）。紫晕改成同色系金，不再与主体互补。
      //   ② 盘心银白星尘堆积（见 coreWarmMix）—— 已由核球暖化处理。
      //   主体 0xfaeed2 → 0xf0d494（琥珀金），opacity 0.38→0.32 保亮度。
      // ★ 去「黄外圈」（用户：中间核的黄色外圈很丑）：ringGlowTex 是甜甜圈——
      //   中心 alpha 0.02（几乎空心）、0.62 半径处 0.95 最亮 → 叠出来就是一圈空心黄环，
      //   像 UI 描边而不是核球。改成三层高斯：中心最亮、向外平滑衰减（真实核球形态）。
      //   尺寸第一轮偏小（r=0 亮度 40.9→28、r=20 只剩 10.5），放大一档补回体积感。
      // ★ 去「脏/雾」（用户：核心脏脏的、雾雾的）：原方案是两层极低透明度的大范围 haloTex
      //   （中心 alpha 仅 0.42、尾巴拖到 0.5 半径）——低透明度加法混合铺在近黑背景上 = 灰雾。
      //   改法：**减少层数 + 每层提高不透明度 + 换快衰减贴图**，亮度集中在核内而不是摊成雾。
      //   glowHaloTex：100%→50%(0.18)→18%(0.4)→4%(0.7)，衰减远快于 haloTex；
      //   coreTex：0~0.45 实心平台 + 快衰减 → 核是「实的」，不糊。
      // ★ 第二轮（用户：还是脏脏的、雾雾的）：低透明度琥珀叠黑底 = 暗卡其棕，这是「脏」的
      //   本质。发光感 = 亮度集中：小而实的热核（高不透明度）+ 紧凑暖晕，摊开就是雾。
      // ★ 中心 = 半透明环状核（用户参考图：核是近似透明的，内部镂空）：
      //   ringGlowTex 一层、低不透明度、柔和金——不再叠热核星，让环内真正透出黑底。
      mkStar(glowHaloTex, 4.2, 0.024, 0xe8b870); // ★ 大范围暖橘晕：缩小调淡（原 6.5/0.035 外圈发闷）
      mkStar(glowHaloTex, 2.3, 0.055, 0xffc470);  // ★ 紧凑暖橘晕：缩小调淡
      // 环 0.20→0.32、色 #d9b878→#e8c88a（用户：核太淡）；芯尖 0.07 只给镂空区一点底光，仍是透的
      mkStar(ringGlowTex, 2.5, 0.42, 0xf0b860);  // 半透明橘金环核：与光柱同色温
      // ★ 银河之心（方向一：环+心）：环心一颗暖橘主星 —— 环从「空洞」变「轨道」，
      //   星的光晕把环和周围尘「焊」在一起，中心有了焦点。太阳色温（与环/柱同系）
      mkStar(glowHaloTex, 1.05, 0.30, 0xffc46b); // 心之外晕：紧凑暖橘
      mkStar(coreTex, 0.5, 0.75, 0xffe0b0);      // 心之本体：小而实的亮核
      mkStar(dotTex, 0.9, 0.05, 0xffe8b8);       // 镂空区底光：极淡暖橘
      galaxyTilt.add(star);
    }

    // ===== 旋棒 / 光柱：【垂直于银河盘面】穿盘而过（方向不动，只调形状）=====
    // ★ 方向已定稿，不要再改：沿盘面法线（局部 Z）。盘面 = 局部 XY（makeDisk 的 x,y 是盘内
    //   坐标、z 是盘厚），法线 = 局部 Z；galaxyTilt 的 Ry 恒 0 → 法线在屏幕上投影恒为竖直。
    // ★ 本轮只做形状优化：更细（半径 0.022→0.018GR）、更含蓄，保持「针」而不是「柱」。
    {
      const count = Math.round(1800 * DN);
      const arr = new Float32Array(count * 3);
      const col = new Float32Array(count * 3);
      const sz = new Float32Array(count);
      const pha = new Float32Array(count);
      const cHot = new THREE.Color(0xfff6e8);   // 核心：暖白
      const cMid = new THREE.Color(0xffb055);   // 中段：橘黄（太阳色）
      const cTail = new THREE.Color(0xd96a30);  // 远端：橘红渐隐
      const L = GR * 0.34;                      // ★ 半长 0.62→0.34（方向三：只留环上下贴合的一段，
                                                //   出环远端的漏光读成杂乱符号；极轴语义由近段承担）
      for (let i = 0; i < count; i++) {
        const s = rand() < 0.5 ? 1 : -1;        // 双向对称：穿盘而过
        const k = Math.pow(rand(), 0.8);        // 密度略向核心集中
        const z = s * L * k;
        const t = Math.abs(z) / L;
        // 半径：中间略粗、两端收细（像光针而不是圆柱），叠加随机做绒毛感
        const rad = GR * 0.012 * (0.3 + 0.7 * Math.pow(rand(), 0.7)) * (1 + 0.55 * t * t);
        const th = rand() * Math.PI * 2;
        const sway = Math.sin(z / L * Math.PI) * L * 0.045 * t; // 微弯：自然光弧
        arr[i * 3] = Math.cos(th) * rad + sway;
        arr[i * 3 + 1] = Math.sin(th) * rad;
        arr[i * 3 + 2] = z;
        const c = cHot.clone().lerp(cTail, t);
        const f = 0.16 + 1.1 * Math.pow(1 - t, 1.8); // 衰减加陡：远端更快归零
        col[i * 3] = c.r * f; col[i * 3 + 1] = c.g * f; col[i * 3 + 2] = c.b * f;
        sz[i] = (0.3 + 0.7 * Math.pow(rand(), 3)) * 0.38;
        pha[i] = rand() * Math.PI * 2;
      }
      const geoB = new THREE.BufferGeometry();
      geoB.setAttribute('position', new THREE.BufferAttribute(arr, 3));
      geoB.setAttribute('aColor', new THREE.BufferAttribute(col, 3));
      geoB.setAttribute('aSize', new THREE.BufferAttribute(sz, 1));
      geoB.setAttribute('aPhase', new THREE.BufferAttribute(pha, 1));
      geoB.boundingSphere = new THREE.Sphere(new THREE.Vector3(), GR);
      const beam = new THREE.Points(geoB, galaxyMat(0.5, 0.7, 12, { churn: 0.004, warp: 0 }));
      galaxySpin.add(beam);
      beam.visible = false; // ★ 棒旋语义纠正：棒在盘面内（galBar 承担），垂直光针退役
      // 沿轴叠 5 个柔光：点亮柱身（已收窄，保证是「针」不是「柱」）
      const mkBeamGlow = (zFrac: number, scale: number, opacity: number, color: number) => {
        const sp = new THREE.Sprite(new THREE.SpriteMaterial({
          map: dotTex, color: new THREE.Color(color), transparent: true, opacity,
          depthWrite: false, blending: THREE.AdditiveBlending, fog: false,
        }));
        sp.position.set(0, 0, L * zFrac);
        sp.scale.setScalar(scale);
        galaxySpin.add(sp);
      };
      mkBeamGlow(0,     GR * 0.15, 0.18, 0xffe2b0);
      mkBeamGlow(0.4,   GR * 0.11, 0.1, 0xffb055);
      mkBeamGlow(-0.4,  GR * 0.11, 0.1, 0xffb055);
      mkBeamGlow(0.72,  GR * 0.07, 0.05, 0xd96a30);
      mkBeamGlow(-0.72, GR * 0.07, 0.05, 0xd96a30);
    }

    // ===== 中心彩色微尘（用户：穿过中核加点别的颜色，淡淡的）=====
    {
      const N = Math.round(320 * DN);
      const arr = new Float32Array(N * 3);
      const col = new Float32Array(N * 3);
      const sz = new Float32Array(N);
      const pha = new Float32Array(N);
      // 紫金主调（用户：记住是紫金色）：紫 + 金双主色
      const palette = ['#c9a6e8', '#e8c476', '#b892e8', '#f0d080', '#9a6fd0'].map((h) => new THREE.Color(h));
      const rngA = mulberry32(314159);
      for (let i = 0; i < N; i++) {
        const rr = 0.15 + 2.3 * Math.pow(rngA(), 1.2); // 环内：中空区+环带（环径 2.8）
        const th = rngA() * Math.PI * 2;
        arr[i * 3] = Math.cos(th) * rr;
        arr[i * 3 + 1] = Math.sin(th) * rr * 0.9;
        arr[i * 3 + 2] = (rngA() - 0.5) * 0.6;
        const c = palette[Math.floor(rngA() * palette.length)].clone();
        const f = 0.5 + rngA() * 0.45; // 紫金：独立亮点
        col[i * 3] = c.r * f; col[i * 3 + 1] = c.g * f; col[i * 3 + 2] = c.b * f;
        sz[i] = (0.3 + rngA() * 0.4) * (rngA() < 0.14 ? 2.2 : 1); // 14% 金紫亮粒（更大更醒目）
        pha[i] = rngA() * Math.PI * 2;
      }
      const geoA = new THREE.BufferGeometry();
      geoA.setAttribute('position', new THREE.BufferAttribute(arr, 3));
      geoA.setAttribute('aColor', new THREE.BufferAttribute(col, 3));
      geoA.setAttribute('aSize', new THREE.BufferAttribute(sz, 1));
      geoA.setAttribute('aPhase', new THREE.BufferAttribute(pha, 1));
      geoA.boundingSphere = new THREE.Sphere(new THREE.Vector3(), GR);
      const ptsA = new THREE.Points(geoA, galaxyMat(0.6, 0.65, 14, { fadeLo: 0.9 }));
      galaxySpin.add(ptsA);
    }

    // ===== 旋臂金色星尘点缀（用户：金色星尘加到旋臂中）=====
    // 金色细尘沿臂脊撒布（龙散作金尘并入旋臂）：与银色臂星交织成对比色层次
    {
      const N = Math.round(3200 * DN); // 加量（用户：多加一些金色细尘）
      const arr = new Float32Array(N * 3);
      const col = new Float32Array(N * 3);
      const sz = new Float32Array(N);
      const pha = new Float32Array(N);
      const cG1 = new THREE.Color(0xf0d080);
      const cG2 = new THREE.Color(0xfff0c0);
      const rngG = mulberry32(991199);
      for (let i = 0; i < N; i++) {
        const r0 = Math.pow(rngG(), 0.72) * GR;
        const branch = Math.floor(rngG() * ARMS);
        const th = branch * ((Math.PI * 2) / ARMS) + SWEEP * (r0 / GR) + (rngG() - 0.5) * 0.16;
        arr[i * 3] = Math.cos(th) * r0;
        arr[i * 3 + 1] = Math.sin(th) * r0;
        arr[i * 3 + 2] = (rngG() - 0.5) * 1.1;
        const c = (rngG() < 0.3 ? cG2 : cG1).clone();
        const f = 0.45 + rngG() * 0.5;
        col[i * 3] = c.r * f; col[i * 3 + 1] = c.g * f; col[i * 3 + 2] = c.b * f;
        sz[i] = 0.26 + rngG() * 0.4;
        pha[i] = rngG() * Math.PI * 2;
      }
      const geoG = new THREE.BufferGeometry();
      geoG.setAttribute('position', new THREE.BufferAttribute(arr, 3));
      geoG.setAttribute('aColor', new THREE.BufferAttribute(col, 3));
      geoG.setAttribute('aSize', new THREE.BufferAttribute(sz, 1));
      geoG.setAttribute('aPhase', new THREE.BufferAttribute(pha, 1));
      geoG.boundingSphere = new THREE.Sphere(new THREE.Vector3(), GR * 1.7);
      const ptsG = new THREE.Points(geoG, galaxyMat(0.5, 0.55, 9, { fadeLo: 0.9 }));
      galaxySpin.add(ptsG);
    }

    // ===== 臂间金色薄尘（用户：间隙铺些金尘不至于空洞）=====
    // 撒在两臂之间的暗隙方位（臂脊方程 + π/2 中角），极淡——填空不抢戏
    {
      const N = Math.round(2600 * DN); // 密度翻倍
      const arr = new Float32Array(N * 3);
      const col = new Float32Array(N * 3);
      const sz = new Float32Array(N);
      const pha = new Float32Array(N);
      const cG = new THREE.Color(0xa8823c); // 暗金色
      const rngG2 = mulberry32(445566);
      for (let i = 0; i < N; i++) {
        const r0 = Math.pow(rngG2(), 0.72) * GR;
        const half = rngG2() < 0.5 ? 0 : Math.PI;               // 两条隙各分一半
        const th = half + Math.PI / ARMS + SWEEP * (r0 / GR) + (rngG2() - 0.5) * 0.5;
        arr[i * 3] = Math.cos(th) * r0;
        arr[i * 3 + 1] = Math.sin(th) * r0;
        arr[i * 3 + 2] = (rngG2() - 0.5) * 1.2;
        const c = cG.clone();
        const f = 0.38 + rngG2() * 0.4;                          // 暗金：若隐若现但可见
        col[i * 3] = c.r * f; col[i * 3 + 1] = c.g * f; col[i * 3 + 2] = c.b * f;
        sz[i] = 0.22 + rngG2() * 0.34;
        pha[i] = rngG2() * Math.PI * 2;
      }
      const geoG2 = new THREE.BufferGeometry();
      geoG2.setAttribute('position', new THREE.BufferAttribute(arr, 3));
      geoG2.setAttribute('aColor', new THREE.BufferAttribute(col, 3));
      geoG2.setAttribute('aSize', new THREE.BufferAttribute(sz, 1));
      geoG2.setAttribute('aPhase', new THREE.BufferAttribute(pha, 1));
      geoG2.boundingSphere = new THREE.Sphere(new THREE.Vector3(), GR * 1.7);
      const ptsG2 = new THREE.Points(geoG2, galaxyMat(0.45, 0.42, 8, { fadeLo: 0.9 }));
      galaxySpin.add(ptsG2);
    }



    // ===== 前景亮星（画面纵深感）：盘外近景的几颗稍大星 + 小光晕 =====
    {
      const mkFg = (x: number, y: number, z: number, s: number, tint: number) => {
        // ★ v3：去光晕（白色突兀感的主体就是那团软光），只留一颗调暗的银蓝锐核
        const core = new THREE.Sprite(new THREE.SpriteMaterial({
          map: starTex, color: new THREE.Color(tint), transparent: true, opacity: 0.55,
          depthWrite: false, blending: THREE.AdditiveBlending, fog: false,
        }));
        core.scale.setScalar(s);
        core.position.set(x, y, z);
        scene.add(core);
      };
      // ★ v2 自然化散布（原 4 颗对称钉角 = 贴纸感）：种子随机 7 颗、幂律大小
      //   （1 主角 + 2 中 + 4 弱）、色温微差（冷白为主+暖白+淡蓝）、z 三层保视差；
      //   自动让开标语/EXPLORE/页脚带，彼此最小间距 5.5 —— 拒绝采样，确定可复现
      // 3 颗、贴盘缘散布（那里有絮丝给它们做语境），银蓝色 = 与盘同色温
      const spotsFg = [ { x: -14.5, y: 5.8 }, { x: 15.0, y: 2.6 }, { x: -8.5, y: -8.0 } ];
      const Z_FG = [-4, -6, -8];
      spotsFg.forEach((p, i) => {
        mkFg(p.x, p.y, Z_FG[i], i === 0 ? 0.42 : i === 1 ? 0.34 : 0.3, 0xcfd6e4);
      });
    }
    // ★ 球状星团晕（ESA/沙普利：~150 个古老球状团球形散布银晕，老年红、无气体无年轻星）：
    //   盘外围 10 个微型暖红球状团 + 稀薄古老晕星 —— 盘外空间的纵深层次。挂 galaxyTilt
    //   （球状星团独立倾斜轨道，不随盘自转）；亮度克制是关键
    {
      const rngG = mulberry32(20261012);
      for (let g = 0; g < 10; g++) {
        const nStar = 90 + Math.floor(rngG() * 50);
        const dirTh = rngG() * Math.PI * 2;
        const dirPh = Math.acos(rngG() * 2 - 1);
        const dist = GR * (0.95 + rngG() * 0.55);
        const cx = Math.sin(dirPh) * Math.cos(dirTh) * dist;
        const cy = Math.sin(dirPh) * Math.sin(dirTh) * dist * 0.9;
        const cz = Math.cos(dirPh) * dist * 0.75;
        const rad = GR * (0.035 + rngG() * 0.03);
        const arr = new Float32Array(nStar * 3);
        const col = new Float32Array(nStar * 3);
        const sz = new Float32Array(nStar);
        const pha = new Float32Array(nStar);
        const base = new THREE.Color(0xd8a878);
        for (let i = 0; i < nStar; i++) {
          const u = Math.pow(rngG(), 2.2);
          const t1 = rngG() * Math.PI * 2, t2 = Math.acos(rngG() * 2 - 1);
          arr[i * 3] = cx + Math.sin(t2) * Math.cos(t1) * rad * u;
          arr[i * 3 + 1] = cy + Math.sin(t2) * Math.sin(t1) * rad * u;
          arr[i * 3 + 2] = cz + Math.cos(t2) * rad * u;
          const f = (0.45 + rngG() * 0.55) * (1 - u * 0.5) * 1.25;
          col[i * 3] = base.r * f; col[i * 3 + 1] = base.g * f; col[i * 3 + 2] = base.b * f;
          sz[i] = 0.5 + rngG() * 0.5;
          pha[i] = rngG() * Math.PI * 2;
        }
        const geo = new THREE.BufferGeometry();
        geo.setAttribute('position', new THREE.BufferAttribute(arr, 3));
        geo.setAttribute('aColor', new THREE.BufferAttribute(col, 3));
        geo.setAttribute('aSize', new THREE.BufferAttribute(sz, 1));
        geo.setAttribute('aPhase', new THREE.BufferAttribute(pha, 1));
        geo.boundingSphere = new THREE.Sphere(new THREE.Vector3(), GR * 1.7);
        const pts = new THREE.Points(geo, galaxyMat(0.5, 0.75, 9, { fadeLo: 0.5 }));
        pts.material.blending = THREE.AdditiveBlending;
        dustMats.push(pts.material);
        galaxyTilt.add(pts);
      }
      const nHalo = Math.round(700 * DN);
      const arr2 = new Float32Array(nHalo * 3);
      const col2 = new Float32Array(nHalo * 3);
      const sz2 = new Float32Array(nHalo);
      const pha2 = new Float32Array(nHalo);
      const cHalo = new THREE.Color(0xcfc4b0);
      for (let i = 0; i < nHalo; i++) {
        const rr = GR * (0.55 + 1.05 * Math.pow(rngG(), 3));
        const t1 = rngG() * Math.PI * 2, t2 = Math.acos(rngG() * 2 - 1);
        arr2[i * 3] = Math.sin(t2) * Math.cos(t1) * rr;
        arr2[i * 3 + 1] = Math.sin(t2) * Math.sin(t1) * rr * 0.85;
        arr2[i * 3 + 2] = Math.cos(t2) * rr * 0.7;
        const f = 0.32 + rngG() * 0.38;
        col2[i * 3] = cHalo.r * f; col2[i * 3 + 1] = cHalo.g * f; col2[i * 3 + 2] = cHalo.b * f;
        sz2[i] = 0.3 + rngG() * 0.3;
        pha2[i] = rngG() * Math.PI * 2;
      }
      const geoH = new THREE.BufferGeometry();
      geoH.setAttribute('position', new THREE.BufferAttribute(arr2, 3));
      geoH.setAttribute('aColor', new THREE.BufferAttribute(col2, 3));
      geoH.setAttribute('aSize', new THREE.BufferAttribute(sz2, 1));
      geoH.setAttribute('aPhase', new THREE.BufferAttribute(pha2, 1));
      geoH.boundingSphere = new THREE.Sphere(new THREE.Vector3(), GR * 1.7);
      const halo = new THREE.Points(geoH, galaxyMat(0.35, 0.6, 6, { fadeLo: 0.5 }));
      halo.material.blending = THREE.AdditiveBlending;
      dustMats.push(halo.material);
      galaxyTilt.add(halo);
    }

    // ★ 暗尘裂隙（Great Rift 轻量版，维基/S&T：前景冷尘云把亮带劈开——真实银河照片
    //   最标志性的明暗对比）。NormalBlending 暗色粒子条：贴着臂中段、顺流方向的剪影。
    //   ★ 可见度定稿（用户：加的东西起码要能看到）：120 粒/条 + 端尖中鼓的宽度包络 +
    //   深剪影（f 0.09~0.16）+ 大粒降透明颗粒感 —— 扫一眼能认出「亮带被劈开一道暗缝」
    {
      const mkRift = (seed, branch, rrMid, numSeed) => {
        // ★ 贴图暗带（2026-10-15 定稿）：沿臂弯的三角带 mesh + 画布生成软边斑驳暗带贴图。
        //   粒子方案两轮实改均呈「串珠链」（点精灵 = 圆点，间距再密也露珠），已弃。
        //   mesh 方案一次成型：中心深、边缘羽化、走向弯曲，随 galaxySpin 自转。
        const rngR = mulberry32(numSeed);
        const len = GR * (0.44 + rngR() * 0.20);
        const th0 = branch * ((Math.PI * 2) / ARMS) + SWEEP * (rrMid / GR);
        // 中心线（与臂脊同方程）+ 纺锤形半宽
        const SEG = 72;
        const center = (t: number) => {
          const rr = rrMid + (t - 0.5) * len;
          const th = th0 + ((rr - rrMid) / Math.max(rr, 1)) * 1.15;
          return [Math.cos(th) * rr, Math.sin(th) * rr * 0.9];
        };
        const positions: number[] = [];
        const uvs: number[] = [];
        const idx: number[] = [];
        for (let i = 0; i <= SEG; i++) {
          const t = i / SEG;
          const [cx, cy] = center(t);
          const [cx2, cy2] = center(Math.min(1, t + 0.01));
          let dx = cx2 - cx, dy = cy2 - cy;
          const dl = Math.hypot(dx, dy) || 1;
          dx /= dl; dy /= dl;
          const halfW = GR * 0.036 * (0.3 + 0.7 * Math.sin(t * Math.PI));
          positions.push(cx - dy * halfW, cy + dx * halfW * 0.9, 0.35);
          positions.push(cx + dy * halfW, cy - dx * halfW * 0.9, 0.35);
          uvs.push(t, 0, t, 1);
          if (i < SEG) { const a = i * 2; idx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2); }
        }
        const geo = new THREE.BufferGeometry();
        geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(positions), 3));
        geo.setAttribute('uv', new THREE.BufferAttribute(new Float32Array(uvs), 2));
        geo.setIndex(idx);
        // 贴图：暗蓝底 + 横向软边 + 纵向端部渐隐 + 随机斑驳（擦除小块 → 尘絮感）
        const cv = document.createElement('canvas');
        cv.width = 512; cv.height = 96;
        const c2 = cv.getContext('2d')!;
        const imgD = c2.createImageData(512, 96);
        for (let x = 0; x < 512; x++) {
          const u = x / 511;
          const along = Math.pow(Math.sin(u * Math.PI), 0.6); // 端部渐隐
          for (let y = 0; y < 96; y++) {
            const v = Math.abs(y / 95 - 0.5) * 2; // 0 中心 → 1 边
            // ★ 平台+软肩剖面（2026-10-15 实测）：pow 剖面的有效暗芯只有 ~8px 宽 = 细线不可见；
            //   中段全深平台 + 两侧羽化 → 宽~14px 的实心暗缝，肩部自然过渡
            const across = v < 0.45 ? 1 : Math.pow(1 - (v - 0.45) / 0.55, 1.6);
            const a = along * across;
            const p = (y * 512 + x) * 4;
            imgD.data[p] = 10; imgD.data[p + 1] = 11; imgD.data[p + 2] = 20;
            imgD.data[p + 3] = Math.round(a * 245);
          }
        }
        c2.putImageData(imgD, 0, 0);
        // 斑驳：随机擦除/加深小块，边缘出现尘絮状缺口（确定种子，每次加载同一画面）
        const rngT = mulberry32(numSeed + 7);
        for (let i = 0; i < 46; i++) {
          const bx = rngT() * 512, by = 20 + rngT() * 56, br = 4 + rngT() * 16;
          const g2 = c2.createRadialGradient(bx, by, 0, bx, by, br);
          const erase = rngT() > 0.45;
          g2.addColorStop(0, erase ? 'rgba(0,0,0,0)' : 'rgba(8,9,16,0.5)');
          g2.addColorStop(1, erase ? 'rgba(0,0,0,0.55)' : 'rgba(8,9,16,0)');
          c2.globalCompositeOperation = erase ? 'destination-out' : 'source-atop';
          c2.fillStyle = g2;
          c2.beginPath(); c2.arc(bx, by, br, 0, Math.PI * 2); c2.fill();
        }
        c2.globalCompositeOperation = 'source-over';
        const tex = new THREE.CanvasTexture(cv);
        tex.anisotropy = 4;
        // ★ 关 mipmap：暗芯只占贴图高度 ~1/3，缩小采样时 mip 平均会把 alpha 稀释 4 倍
        //   （实测：深色改浅色暗化量几乎不变 = 衰减在采样不在颜色）。软边贴图无高频，线性过滤即可
        tex.minFilter = THREE.LinearFilter;
        tex.generateMipmaps = false;
        const mat = new THREE.MeshBasicMaterial({
          map: tex, transparent: true, opacity: 0.95,
          depthWrite: false, blending: THREE.NormalBlending, side: THREE.DoubleSide,
        });
        const mesh = new THREE.Mesh(geo, mat);
        mesh.name = 'dust-rift';
        mesh.renderOrder = 3; // 尘层之后、内容层之前绘制
        galaxySpin.add(mesh);
      };
      // ★ 落点由投影打分选出（2026-10-15）：三条分别压在左中/右中/上方的亮带上，
      //   b1 会扫过 hero 文字区被排除。branch 互不相同 → 屏幕上方位分散
      mkRift('r1', 0, GR * 0.42, 20261015);
      mkRift('r2', 2, GR * 0.42, 20261016);
      mkRift('r3', 3, GR * 0.36, 20261017);
    }

    // ★ 独立支臂已退役（2026-10-16 用户三次抓包定稿）：支臂弧段必然与某个星团相交
    //   （星团全钉在臂上，臂间弧怎么摆都会扫过团区）——spur1 的 175/180 粒落在 ai 团 7u 内，
    //   就是「白雾斑」本体。任何「在星团附近撒亮粒子」的装饰都已被证伪，不再尝试

    // tracer：少数「能看出在流动」的星。它们不跟图案同步（drift），且被密度波完整调制
    // （dw=1）→ 流入旋臂时被点亮、流出时暗下去。数量少，长期漂移不伤结构。
    const galStream = makeDisk(Math.round(900 * DN), 0.035, 0.42, 0.55, 13, 0.55, 1.4,
      { drift: -0.016, warp: 0.6, dw: 1, armMinor: 0.6, armMajor: 1.3 });

    // 域色增艳：CATEGORIES 色板偏灰（#93a9d6 一类），在星海里辨识度不足。
    // 只提饱和 + 略提亮度，不动色相 —— 与列表页标识色同源，仍是同一色系。
    const vivid = (hex: string) => {
      const c = new THREE.Color(hex);
      const hsl = { h: 0, s: 0, l: 0 };
      c.getHSL(hsl);
      return c.setHSL(hsl.h, Math.min(1, hsl.s * 1.75), Math.min(0.74, hsl.l * 1.18));
    };

    // ===== 内容层：星团（分类）与恒星（文章 / 项目）=====
    // ★ 这是首页真正的导航主体，前面的银河是它的「宇宙背景」。
    // 星团钉在旋臂上：真实星系的疏散星团与电离氢云就是这样分布在臂上，而不是散布在臂间。
    // 恒星位置由 slug 哈希决定（每颗星独立的确定性种子）→ 新文章加入时旧星不会搬家，
    // 且不用跑任何力模拟，首帧即到位。
    const NS = stars.length, NC = clusters.length;
    // 星团可视半径（边界环/背景星群/文章星布点共用的半径基准；必须早于恒星布点定义）。
    // scatter 只比其他团略宽（1.05）——之前 1.28+均匀铺边+多边形尖峰叠加，项目团显得特别大
    // 星团的「空间范围」= 团半径。基准由盘半径与形态决定，再乘【文章数增长系数】：
    //   文章变多 → 团的范围跟着变大（半径按 √n 增长，等价于密度恒定），封顶 1.7×。
    //   它是单一事实来源：密度云 Plummer 半径、文章星散布环带与间距、主星禁入区、
    //   团色范围雾（直径 = 2×团半径）全部由它推导 —— 加文章后整团自动长大，无需手调。
    // 拥挤收缩：团多时每团整体缩一档（NC≤3 原尺寸不动）—— 全尺寸光晕 × 7
    // 在避让 hero/边缘的半环带里放不下，硬摆只会黏成一坨
    const CROWD = NC <= 3 ? 1 : Math.max(0.72, 1 - 0.07 * (NC - 3));
    const clusterBaseRad = (k: number) =>
      Math.max(GR * 0.11, 2.4) * (clusters[k]?.form === 'scatter' ? 1.05 : 0.95) * CROWD;
    const clusterRadOf = (k: number) => {
      const n = Math.max(1, clusters[k]?.count ?? 1);
      // ★ 范围=内容（2026-10-15 用户纠偏）：去掉视觉下限——1~2 篇的团就该小，
      //   随文章数 √n 自动长大（染色盘/雾斑/文章星散布全部由它推导，单一事实来源）
      const grow = Math.min(1.7, 0.8 + 0.2 * Math.sqrt(n / 2));
      return clusterBaseRad(k) * grow;
    };
    // 主星光晕直径（世界单位）——单一事实来源：光晕精灵与文章星禁入区都从它推导，
    // 调整光晕大小后禁入区自动跟随，不需要每次手调布点
    const MAIN_STAR_HALO = 0.78;
    // 每团一条多边形轮廓 r(θ) = 1 + Σ aᵢ·cos(nᵢθ+φᵢ)：3~5 边主边形 + 次谐波破规整，
    // 参数由团 key 哈希决定 —— 团团形态不同。背景星/文章星/边界环共用它，整团剪影就是这一个多边形。
    // 振幅收敛（主 0.14~0.26 / 次 0.06~0.14）：峰值比 ≤1.4，多边形可辨但不把团撑出尖刺
    const shapeCache: { n: number; a: number; ph: number }[][] = [];
    const clusterShape = (k: number) => {
      if (!shapeCache[k]) {
        const rng = mulberry32(hash32('shape:' + clusters[k].key));
        const n0 = 3 + Math.floor(rng() * 3); // 3~5 边
        shapeCache[k] = [
          { n: n0, a: 0.14 + rng() * 0.12, ph: rng() * Math.PI * 2 },
          { n: n0 + 1 + Math.floor(rng() * 2), a: 0.06 + rng() * 0.08, ph: rng() * Math.PI * 2 },
        ];
      }
      return shapeCache[k];
    };
    const clusterShapeR = (k: number, th: number) => {
      let r = 1;
      for (const L of clusterShape(k)) r += L.a * Math.cos(L.n * th + L.ph);
      return Math.max(0.6, r);
    };
    // 文章星所属星团（状态机按团算倍率；必须早于恒星布点，否则 TDZ）
    const starClusterIdx = new Int16Array(NS);
    const golden = Math.PI * (3 - Math.sqrt(5));
    const hash32 = (s: string) => {
      let h = 2166136261;
      for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
      return h >>> 0;
    };

    // ★ 形态发生器：星团结构全部由团 key 哈希派生 —— 新增分类/星团零配置，
    //   自动长出稳定且互不相同的结构。结构 = 核剖面 × 旋臂 × 椭率 × 不对称 × 剪影；
    //   clusters[].form 降级为未来的人工覆盖位，日常不再需要。
    const morphCache: { profile: number; arms: number; armAmp: number; wind: number; flat: number; pa: number; lop: number; core: number }[] = [];
    const clusterMorph = (k: number) => {
      if (!morphCache[k]) {
        // ★ 疏散星团形态 v2（2026-10-15 用户点名「不要双臂螺旋，查真实星团」）：
        //   真实疏散星团（Pleiades 一类）= 不规则松散星堆：King 剖面中心富集 + 整体扁平
        //   有长轴 + 1~2 个次级团块（clumps）+ 链状/纤维状星链（chains，Laverde-Villarreal
        //   2025：「chains and clumpy substructure」）——唯独没有旋臂（那是星系特征）。
        //   与知识库 MiniGalaxy 卡同源同流：FNV(`cat:key`) + LCG，同序消费（卡侧同款改版）
        // ★ 形态覆盖位（2026-10-26 预留）：CATEGORIES.shape 配置时以「key@shape」重新
        //   播种——换字符串=换形状。不配置时输入串与历史逐比特一致（零影响保证）
        let s = 2166136261;
        const mkey = clusters[k].key + (clusters[k].shape ? "@" + clusters[k].shape : "");
        for (let i = 0; i < mkey.length; i++) s = Math.imul(s ^ mkey.charCodeAt(i), 16777619) >>> 0;
        s = s || 88;
        const rng = () => { s = (s * 1103515245 + 12345) % 2147483648; return s / 2147483648; };
        const flat = 0.2 + rng() * 0.45;                       // 椭率（真实星团普遍扁平）
        const pa = rng() * Math.PI;                            // 长轴方向
        const core = 0.3 + rng() * 0.25;                       // King 核半径/潮汐半径
        const thick = 0.35 + rng() * 0.35;                     // ★ 立体厚度（z 半幅/团半径）：真实星团是立体云不是贴纸
        const nClumps = Math.floor(rng() * 2.6);               // 0~2 个次级团块
        const clumps: { th: number; rr: number; s: number; cz: number }[] = [];
        for (let i = 0; i < nClumps; i++) {
          // cz：团块深度（±0.45R）——团块不在同一平面上，立体感的主来源
          clumps.push({ th: rng() * Math.PI * 2, rr: 0.3 + rng() * 0.32, s: 0.16 + rng() * 0.13, cz: (rng() - 0.5) * 0.9 });
        }
        const nChains = Math.floor(rng() * 2.3);               // 0~2 条星链（纤维状次结构）
        const chains: { th0: number; rr0: number; arc: number; w: number; zA: number }[] = [];
        for (let i = 0; i < nChains; i++) {
          chains.push({
            th0: rng() * Math.PI * 2,
            rr0: 0.28 + rng() * 0.3,
            arc: (0.5 + rng() * 0.55) * (rng() < 0.5 ? -1 : 1),
            w: 0.06 + rng() * 0.05,
            zA: (rng() - 0.5) * 1.2,                           // ★ 星链在深度里起伏
          });
        }
        morphCache[k] = { flat, pa, core, thick, clumps, chains };
      }
      return morphCache[k];
    };
    // ★ 团内密度场（无纲坐标，x/y = clusterFrame(th, R 分数)）：基底 + 团块高斯 + 星链胶囊。
    //   文章星/成员散星/知识库卡共用同一套 —— 星向结构聚拢，形状随 key 自动生成。
    //   返回值 0.32~1.2，作拒绝采样接受概率（min 1）
    const clusterDensity = (M: { flat: number; clumps: { th: number; rr: number; s: number }[]; chains: { th0: number; rr0: number; arc: number; w: number }[] }, x: number, y: number) => {
      let v = 0.32;
      const fy = 1 - M.flat;
      for (const c of M.clumps) {
        const cx = Math.cos(c.th) * c.rr, cy = Math.sin(c.th) * c.rr * fy;
        const dx = x - cx, dy = y - cy;
        v += 0.85 * Math.exp(-(dx * dx + dy * dy) / (2 * c.s * c.s));
      }
      for (const ch of M.chains) {
        const cx = Math.cos(ch.th0) * ch.rr0, cy = Math.sin(ch.th0) * ch.rr0 * fy;
        let tx = -Math.sin(ch.th0), ty = Math.cos(ch.th0) * fy;
        const tl = Math.hypot(tx, ty) || 1; tx /= tl; ty /= tl;
        const px = x - cx, py = y - cy;
        const half = ch.arc / 2;
        const al = Math.max(-half, Math.min(half, px * tx + py * ty));
        const dx = px - tx * al, dy = py - ty * al;
        v += 0.8 * Math.exp(-(dx * dx + dy * dy) / (2 * ch.w * ch.w));
      }
      return v;
    };
    // 团内坐标：径向距离 → 盘面压扁(×0.75 继承盘) × 团椭率 → 长轴旋转。背景星/文章星/轨道弧共用
    const clusterFrame = (k: number, th: number, dr: number) => {
      const M = clusterMorph(k);
      const ex = Math.cos(th) * dr;
      const ey = Math.sin(th) * dr * 0.75 * (1 - M.flat);
      const ca = Math.cos(M.pa), sa = Math.sin(M.pa);
      return { x: ex * ca - ey * sa, y: ex * sa + ey * ca };
    };
    // ★ 立体深度（R 单位，世界单位需乘 clusterRadOf）：基础厚度高斯 + 团块深度引力 + 星链起伏。
    //   星团是立体云不是贴纸（2026-10-16 用户「能不能是立体的」）——文章星/成员散星共用，
    //   倾斜视角下星星有前后高低，自转+聚焦拉近时视差让立体感落地
    const clusterZ = (
      M: { flat: number; thick: number; clumps: { th: number; rr: number; s: number; cz: number }[]; chains: { th0: number; rr0: number; arc: number; w: number; zA: number }[] },
      fr: { x: number; y: number },
    ) => {
      const fy = 1 - M.flat;
      let z = gj() * 0.3 * M.thick;
      for (const c of M.clumps) {
        const cx = Math.cos(c.th) * c.rr, cy = Math.sin(c.th) * c.rr * fy;
        const dd = Math.hypot(fr.x - cx, fr.y - cy);
        const wgt = Math.exp(-(dd * dd) / (2 * c.s * c.s));
        z += (c.cz - z) * wgt;
      }
      for (const ch of M.chains) {
        const cx = Math.cos(ch.th0) * ch.rr0, cy = Math.sin(ch.th0) * ch.rr0 * fy;
        const dd = Math.hypot(fr.x - cx, fr.y - cy);
        const wgt = Math.exp(-(dd * dd) / (2 * (ch.arc * 0.5) * (ch.arc * 0.5)));
        z += ch.zA * wgt;
      }
      return z;
    };
    // 星团中心：沿旋臂由内向外摊开，依次落在不同的臂上
    // ★ 内圈下限 0.40→0.56×GR：最内团曾贴着银河中心的核球光海，
    //   密度云/主星被亮区彻底淹没（实测「项目团的文章星在团外」—— 其实是团本身不可见）。
    //   外圈收敛到 0.83×GR：再往外团会贴上视口缘、密度云被裁掉一半。
    const clusPos = new Float32Array(NC * 3);
    clusters.forEach((c, k) => {
      // 三团都收在盘的中部（0.54~0.69×GR）：分布再外，透视会把外圈团推到画面角上，
      // 视觉上就像「这团不属于银河」；同时最内圈仍离核球光海足够远。
      // 径向跨度随团数展宽：团多时窄环带（0.5~0.72）必互相叠压 —— 拉开到 0.9GR，
      // 靠 SWEEP 的径向角差让同臂团自然错开。NC≤3 保持原跨度（已验收布局不动）
      const span = NC <= 3 ? 0.22 : Math.min(0.42, 0.22 + 0.05 * (NC - 3));
      const rr = GR * (0.5 + span * ((k + 0.5) / Math.max(NC, 1)));
      const branch = k % ARMS;
      const th = branch * ((Math.PI * 2) / ARMS) + SWEEP * (rr / GR) + (rand() - 0.5) * 0.24; // 抖动收紧：团心贴臂脊，不落暗隙边缘
      clusPos[k * 3] = Math.cos(th) * rr;
      clusPos[k * 3 + 1] = Math.sin(th) * rr;
      clusPos[k * 3 + 2] = gj() * 0.12; // ★ 压进银道面（原 ×0.5：倾斜视角下星团浮在盘面上方，被用户抓包）
    });
    // ★ 视口安全区适配（自转周期 ~7.5min，任何团都会周期性转到画面边缘；
    //   贴边团的密度云被视口裁掉一半 → 文章星看起来「在团外」）：
    //   布局后按初始相机姿态投影，团中心离视口边缘不足 120/150px 时，该团在盘面内
    //   向安全方向平移（步长 1 世界单位，最多 12 次 —— 保持在原臂附近，不破坏布局语义）。
    {
      const w0 = mount.clientWidth, h0 = mount.clientHeight;
      const safeX = Math.min(140, w0 * 0.16), safeY = Math.min(110, h0 * 0.14);
      // 与渲染时保持一致：主循环不调 lookAt（相机默认朝 -z），这里也不能调，否则投影错位；
      // camera 不是 scene 的子对象，必须自己 updateMatrixWorld()，否则用的是旧矩阵。
      camera.aspect = w0 / Math.max(h0, 1);   // ★ 相机构造默认 aspect=1，resize 回调在布局之后才跑——
      camera.updateProjectionMatrix();        //   不修正则投影 x 被拉伸 ~1.78 倍，避让/安全区全部错位
      camera.position.set(0, 0, camZ);
      camera.updateMatrixWorld();
      scene.updateMatrixWorld();
      const _v = new THREE.Vector3();
      const projOf = (x: number, y: number, z: number) => {
        _v.set(x, y, z).applyMatrix4(galaxyTilt.matrixWorld).project(camera);
        return { x: (_v.x * 0.5 + 0.5) * w0, y: (-_v.y * 0.5 + 0.5) * h0 };
      };
      const core = projOf(0, 0, 0);                       // 银河中心（盘心）的屏幕位置
      const sy = (k: number) => projOf(clusPos[k * 3], clusPos[k * 3 + 1], clusPos[k * 3 + 2]);
      // ★ 直接按【屏幕位置】布局：感知到的「离银河远近」是屏幕距离，不是盘面半径
      //   （盘倾斜 + 自转投影后两者非线性对应，调径向参数治不好）。
      //   目标：团心距银心 260~430px（内不过核球光海、外不飘到画面角），
      //        且不进边缘安全区，彼此屏幕间距 ≥150px。
      const R_MIN = Math.min(260, Math.min(w0, h0) * 0.3);
      const R_MAX = Math.min(430, Math.min(w0, h0) * 0.5);
      // 盘面→屏幕比例尺（用团心位移实测投影），团间距目标 = 两团光晕半径之和 ×0.5：
      // 光晕直径 ~200-260px，固定 150px 目标意味着中心相距 150 时早已叠成一坨
      const pxScale = (() => {
        const q0 = projOf(clusPos[0], clusPos[1], clusPos[2]);
        const q1 = projOf(clusPos[0] + 1, clusPos[1], clusPos[2]);
        return Math.max(4, Math.hypot(q1.x - q0.x, q1.y - q0.y));
      })();
      const sepOf = (k: number, j: number) => {
        const hk = clusterRadOf(k) * 2.5, hj = clusterRadOf(j) * 2.5;
        // 光晕相切 = 中心距等于两半径之和；×0.82 允许光晕边缘轻吻（光晕是加性淡光，
        // 完全不相切在小屏/多团时无解），但密度云主体（半径×0.88 一档）绝不叠。
        // ★ 标签级下限 44px（2026-10-24 避让矩阵实测）：小屏 pxScale 小，NC=6/8 手机端
        //   两团标签会叠字（NC8 实测 0px）。44 = 标签宽 33 + 间隙；NC=3 现有布局最小
        //   团距 210px+，此下限零触发、已验收布局不动。
        return Math.max(44, Math.min(300, (hk + hj) * pxScale * 0.82));
      };
      // hero 文字 / EXPLORE / 标语 / 页脚 / 视图切换的屏幕矩形：团不得压在上面（含光晕外扩）
      const heroRects: { x1: number; y1: number; x2: number; y2: number }[] = [];
      document.querySelectorAll('.hero h1, .hero .origin, .hero .explore, .hero .whisper, footer, .sky-hint, .view-switch').forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.width > 0) heroRects.push({ x1: r.left - 40, y1: r.top - 34, x2: r.right + 40, y2: r.bottom + 52 });
      });
      // ★ 太阳标记也是障碍物（2026-10-23 用户抓包：AI 团贴上太阳标记）。
      //   矩形 = 光点 + 短标注「太阳系 · 猎户臂」（12.5px 字距 0.08em 约 8 字 ≈ 115px，
      //   加点和间隙取 150 封顶）。太阳与团同盘共转 → 屏距自转不变，布局期用与团
      //   一致的 tilt 系投影一次即可。
      {
        const sxx = Math.cos(2.36) * GR * 0.54, syy = Math.sin(2.36) * GR * 0.54 * 0.9;
        const sp = projOf(sxx, syy, 0.15);
        heroRects.push({ x1: sp.x - 12, y1: sp.y - 16, x2: sp.x + Math.min(w0 * 0.5, 150), y2: sp.y + 30 });
      }
      const cost = (k: number) => {
        const p = sy(k);
        const d = Math.hypot(p.x - core.x, p.y - core.y);
        let c = Math.max(0, R_MIN - d) + Math.max(0, d - R_MAX);
        c += Math.max(0, safeY - p.y) + Math.max(0, p.y - (h0 - safeY));
        c += Math.max(0, safeX - p.x) + Math.max(0, p.x - (w0 - safeX));
        // ★ 罚「进入矩形缓冲区的穿透深度」×2（写反了会把团吸进矩形——历史坑）
        for (const hr of heroRects) {
          if (p.x > hr.x1 && p.x < hr.x2 && p.y > hr.y1 && p.y < hr.y2) {
            c += Math.min(p.x - hr.x1, hr.x2 - p.x, p.y - hr.y1, hr.y2 - p.y) * 2;
          }
        }
        for (let j = 0; j < NC; j++) {
          if (j === k) continue;
          const q = sy(j);
          c += Math.max(0, sepOf(k, j) - Math.hypot(p.x - q.x, p.y - q.y));
        }
        // 臂脊吸附：偏离所有臂脊 >0.35rad 开始罚（允许换臂，不许漂进臂间暗隙）
        {
          const thk = Math.atan2(clusPos[k * 3 + 1], clusPos[k * 3]);
          const rrk = Math.hypot(clusPos[k * 3], clusPos[k * 3 + 1]) || 1;
          let armDev = Infinity;
          for (let b = 0; b < ARMS; b++) {
            const d = Math.abs(((thk - (b * ((Math.PI * 2) / ARMS) + SWEEP * rrk / GR)) % (Math.PI * 2) + Math.PI * 3) % (Math.PI * 2) - Math.PI);
            if (d < armDev) armDev = d;
          }
          c += Math.max(0, armDev - 0.35) * 40;
        }
        return c;
      };
      // ★ 高团数加搜索力度（2026-10-24 避让矩阵实测）：NC≤4 保持原参数（已验收布局
      //   一个比特都不动）；NC>4 更多 pass/迭代、更宽径向窗口、更远推离——
      //   否则 NC=8 手机端两团标签 0px 叠字（44px 下限有了也搜不出来）
      for (let pass = 0; pass < (NC > 6 ? 5 : NC > 4 ? 4 : 2); pass++) {
        for (let k = 0; k < NC; k++) {
          const rBase = Math.hypot(clusPos[k * 3], clusPos[k * 3 + 1]) || 1;
          const branch = k % ARMS;
          const baseTh = branch * ((Math.PI * 2) / ARMS);
          for (let it = 0; it < (NC > 4 ? 40 : 24); it++) {
            const c0 = cost(k);
            if (c0 <= 0.5) break;
            const th = Math.atan2(clusPos[k * 3 + 1], clusPos[k * 3]);
            // ★ 候选 = 沿臂滑动：只改角度，半径严格按旋臂方程回算（th = baseTh + SWEEP·r/GR）
            //   —— 团无论怎么调都钉在臂上。旧版的径向/自由切向移动会让团脱离旋臂
            //   （用户：团偏离旋臂很多了）。
            const opts: { dx: number; dy: number }[] = [];
            for (const dTh of [0.05, -0.05, 0.1, -0.1, 0.16, -0.16]) {
              const thN = th + dTh;
              const rrN = ((thN - baseTh) / SWEEP) * GR;
              if (rrN > rBase * (NC > 4 ? 1.35 : 1.25) || rrN < rBase * (NC > 4 ? 0.65 : 0.75)) continue;       // 径向变化限 ±25%（NC>4 放宽到 ±35%）
              opts.push({ dx: Math.cos(thN) * rrN - clusPos[k * 3], dy: Math.sin(thN) * rrN - clusPos[k * 3 + 1] });
            }
            // 跳邻臂：半径不变、角向换到相邻臂脊 —— 拥挤时本臂无处可退的逃逸通道
            for (const hop of [1, -1]) {
              const thH = (branch + hop) * ((Math.PI * 2) / ARMS) + SWEEP * (rBase / GR);
              opts.push({ dx: Math.cos(thH) * rBase - clusPos[k * 3], dy: Math.sin(thH) * rBase - clusPos[k * 3 + 1] });
            }
            // 逃离最近侵犯邻居：沿「邻居→我」方向的世界空间直推（治臂滑/跳臂都解不开的局部极小）
            {
              const pk = sy(k);
              let worst: { j: number; d: number } | null = null;
              for (let j = 0; j < NC; j++) {
                if (j === k) continue;
                const q = sy(j);
                const d = Math.hypot(pk.x - q.x, pk.y - q.y);
                if (d < sepOf(k, j) && (!worst || d < worst.d)) worst = { j, d };
              }
              if (worst) {
                const dxw = clusPos[k * 3] - clusPos[worst.j * 3];
                const dyw = clusPos[k * 3 + 1] - clusPos[worst.j * 3 + 1];
                const L = Math.hypot(dxw, dyw) || 1;
                // NC>6 加 6 单位大步长：手机投影横向压缩后，小步长逃不出堆叠对
                // （NC=8 手机实测 摄影+项目 0px 叠字，3.2 以内无解）
                for (const push of NC > 6 ? [0.9, 1.8, 3.2, 6.0] : NC > 4 ? [0.9, 1.8, 3.2] : [0.9, 1.8]) {
                  opts.push({ dx: (dxw / L) * push, dy: (dyw / L) * push });
                }
              }
            }
            let best: { c: number; dx: number; dy: number } | null = null;
            for (const o of opts) {
              const ox = clusPos[k * 3], oy = clusPos[k * 3 + 1];
              clusPos[k * 3] += o.dx; clusPos[k * 3 + 1] += o.dy;
              const c = cost(k);
              clusPos[k * 3] = ox; clusPos[k * 3 + 1] = oy;
              if (!best || c < best.c) best = { c, dx: o.dx, dy: o.dy };
            }
            if (!best || best.c >= c0) break;
            clusPos[k * 3] += best.dx; clusPos[k * 3 + 1] += best.dy;
          }
        }
      }
      // ★ hero 是硬约束：两轮沿臂优化后若仍有团压在文字/按钮上（臂正好从 UI 底下穿过时
      //   沿臂滑动出不来），先 8 向贪心驱逐；贪心困进 UI 夹缝再沿臂重扫兜底
      const heroPen = (k: number) => {
        const p = sy(k);
        let pen = 0;
        for (const hr of heroRects) {
          const x1 = hr.x1 - 30, y1 = hr.y1 - 30, x2 = hr.x2 + 30, y2 = hr.y2 + 30;
          if (p.x > x1 && p.x < x2 && p.y > y1 && p.y < y2) {
            pen = Math.max(pen, Math.min(p.x - x1, x2 - p.x, p.y - y1, y2 - p.y));
          }
        }
        return pen;
      };
      for (let k = 0; k < NC; k++) {
        for (let it = 0; it < 40; it++) {
          const pen = heroPen(k);
          if (pen <= 0) break;
          const ox = clusPos[k * 3], oy = clusPos[k * 3 + 1];
          let bestDx = 0, bestDy = 0, bestPen = pen;
          for (let a = 0; a < 8; a++) {
            const ang = (a / 8) * Math.PI * 2;
            const nx = ox + Math.cos(ang) * 1.3, ny = oy + Math.sin(ang) * 1.3;
            if (Math.hypot(nx, ny) > GR * 0.95) continue;
            clusPos[k * 3] = nx; clusPos[k * 3 + 1] = ny;
            const pen2 = heroPen(k);
            if (pen2 < bestPen) { bestPen = pen2; bestDx = nx - ox; bestDy = ny - oy; }
          }
          clusPos[k * 3] = ox; clusPos[k * 3 + 1] = oy;
          if (bestPen >= pen) break;   // 8 向都减不了穿透：贪心到顶，交给重扫
          clusPos[k * 3] += bestDx; clusPos[k * 3 + 1] += bestDy;
        }
        if (heroPen(k) > 0 || cost(k) > 40) {
          const branch = k % ARMS, baseTh = branch * ((Math.PI * 2) / ARMS);
          let bestTh = 0, bestRr = 0, bestScore = Infinity;
          for (let i = 0; i < 26; i++) {
            const rr = GR * (0.34 + 0.6 * (i / 25));
            const th = baseTh + SWEEP * (rr / GR);
            clusPos[k * 3] = Math.cos(th) * rr;
            clusPos[k * 3 + 1] = Math.sin(th) * rr;
            const p = heroPen(k);
            const pd = Math.hypot(sy(k).x - core.x, sy(k).y - core.y);
            let sp = 0;
            for (let j2 = 0; j2 < NC; j2++) {
              if (j2 === k) continue;
              const q = sy(j2);
              sp += Math.max(0, 150 - Math.hypot(sy(k).x - q.x, sy(k).y - q.y));
            }
            const score = p * 1000 + Math.max(0, R_MIN - pd) + Math.max(0, pd - R_MAX) + sp;
            if (score < bestScore) { bestScore = score; bestTh = th; bestRr = rr; }
          }
          clusPos[k * 3] = Math.cos(bestTh) * bestRr;
          clusPos[k * 3 + 1] = Math.sin(bestTh) * bestRr;
        }
      }
    }

    // ★ 团色粒子退役（2026-10-15 用户终审：「雾就是主星和文章星之外的团色粒子，
    //   实在不行就减密度，要么就不要这种团色粒子了」）—— 整个满盘染色/退场压暗删除。
    //   小粒子一染色就是彩霾：全景像质感、凑近就是绿粒子云（用户截图实证）。
    //   团色载体收归：主星+文章星（发光）+ 成员散星 + 贴盘光斑（远看身份，凑近淡出）。
    //   aSparse 属性保留恒 2（shader 分支不触发，uClusterDim 无驱动恒 0，均安全）
    {
      const posArr = galFill.geometry.attributes.position.array as Float32Array;
      const spArr = new Float32Array(posArr.length / 3).fill(2.0);
      galFill.geometry.setAttribute('aSparse', new THREE.BufferAttribute(spArr, 1));
      // ★ 团周银尘退场退役（2026-10-15 用户定案「为啥要删银河粒子，只干掉星云粒子就行」）：
      //   银河粒子是银河本身，全域均匀、永不为星团让路——团区亮度与远处完全一致。
      //   彩雾由「运行时脱色」清除（见 nebula 块尾），银河三层尘零修改

      // ★ 桥接丝：每团 2~3 条顺流弧丝真正穿过团心（隐约带团色 55% —— 团色靠大粒子，丝只做衔接）——
      //   密度桥接：絮丝只在团旁绕行时，团脚下是暗的，「浮在银河上」的观感就来自这里。
      //   走向 = 旋臂方程的臂脊线（与布局求解器同一套方程），中心线在高斯权重下贴向团心
      const bridgePos: number[] = [];
      const bridgeCol: number[] = [];
      const cSilverBr = new THREE.Color(0xe3e5e7);
      clusters.forEach((c, k) => {
        const rngBr = mulberry32(hash32('bridge:' + c.key));
        const baseTh = (k % ARMS) * ((Math.PI * 2) / ARMS);
        const rrK = Math.hypot(clusPos[k * 3], clusPos[k * 3 + 1]) || 1;
        const nThreads = 2 + Math.floor(rngBr() * 2);
        for (let tI = 0; tI < nThreads; tI++) {
          const rr0 = rrK * (0.55 + rngBr() * 0.9);
          const arc = 0.16 + rngBr() * 0.22;
          const thDir = rngBr() > 0.5 ? 1 : -1;
          const n = 34 + Math.floor(rngBr() * 26);
          const jit = 0.1 + rngBr() * 0.2;
          const bow = 0.02 + rngBr() * 0.05;
          for (let i = 0; i < n; i++) {
            const t = i / (n - 1);
            const rr = Math.max(rr0 * (1 + Math.sin(t * Math.PI) * bow * thDir), GR * 0.14);
            const th = baseTh + SWEEP * (rr / GR) + thDir * t * arc;
            const pull = Math.exp(-Math.pow(rr - rrK, 2) / (2 * Math.pow(rrK * 0.3, 2)));
            let px = Math.cos(th) * rr, py = Math.sin(th) * rr * 0.9;
            px += (clusPos[k * 3] - px) * pull;
            py += (clusPos[k * 3 + 1] - py) * pull;
            const perp = (rngBr() - 0.5) * 2 * jit;
            const bx = px + (-Math.sin(th)) * perp;
            const by = py + Math.cos(th) * perp * 0.9;
            bridgePos.push(bx, by, (rngBr() - 0.5) * 0.7);
            const f = (0.3 + rngBr() * 0.5) * 0.85;
            bridgeCol.push(cSilverBr.r * f, cSilverBr.g * f, cSilverBr.b * f); // ★ 纯银（团色粒子退役）
          }
        }
      });
      const geoBr = new THREE.BufferGeometry();
      geoBr.setAttribute('position', new THREE.BufferAttribute(new Float32Array(bridgePos), 3));
      geoBr.setAttribute('aColor', new THREE.BufferAttribute(new Float32Array(bridgeCol), 3));
      geoBr.setAttribute('aSize', new THREE.BufferAttribute(new Float32Array(bridgePos.length / 3).fill(0.5), 1));
      geoBr.setAttribute('aPhase', new THREE.BufferAttribute(new Float32Array(bridgePos.length / 3), 1));
      geoBr.boundingSphere = new THREE.Sphere(new THREE.Vector3(), GR * 1.7);
      const bridgePts = new THREE.Points(geoBr, galaxyMat(0.42, 0.6, 9, { churn: 0.01, warp: 0.7 }));
