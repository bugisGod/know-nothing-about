    });

    // ===== 主循环 =====
    // 内容星是静态布点（无力学收敛），首帧即成形：不需要预跑，也不会看到「星星复位地乱飞」
    const t0 = performance.now();
    let labDiag = false;                  // 标签判定诊断（?debug=1 时开启，写 dataset.why）
    const hitBox = (a: Box, g: Box) => !(a.r < g.l || a.l > g.r || a.b < g.t || a.t > g.b); // 矩形相交
    const guard: DOMRect[] = [];          // 静态禁区（hero 文案 / 页脚 / 视图切换）：20 帧刷新一次
    // 统一矩形结构 {l,t,r,b}（此前混用 {l,t,r,b} 与 {left,top,right,bottom}，
    // 字段读不到 → 比较恒 false → 互撞判定恒真，标签被大量误杀）
    type Box = { l: number; t: number; r: number; b: number };
    const dynGuard: Box[] = [];  // 动态禁区（摘要浮层 / 列表 / 锁定信息条 / 探索提示）：每帧刷新
    const guardM: Box[] = [];    // 静态禁区换算到 mount 内坐标（数值每帧刷新，来源 20 帧刷新）
    let hotIdx = -1;  // 星图 / 列表二者任一悬停的文章星（状态机写入，供后续块读取）
    let lastHot = -2; // 列表 ↔ 星图高亮同步的脏检查（悬停切换时才动 DOM）
    function loop() {
      rafId = requestAnimationFrame(loop);
      if (!inView) { cancelAnimationFrame(rafId); rafId = 0; return; }
      const t = (performance.now() - t0) * 0.001;
      const dt = Math.min(0.05, Math.max(0.001, t - ((loop as unknown as { lastT?: number }).lastT ?? t - 0.016)));
      (loop as unknown as { lastT: number }).lastT = t;
      // 自转时钟：聚焦星团时冻结（凝视不追转），返回后从冻结处继续，不跳变
      if (!(reduced || focusIdx >= 0)) spinT += dt;
      if (!dragging && focusT <= 0.02) tRotY += 0.00025; // 松手后极缓的方位漂移（聚焦时停）
      rotX += (tRotX - rotX) * 0.07;
      rotY += (tRotY - rotY) * 0.07;
