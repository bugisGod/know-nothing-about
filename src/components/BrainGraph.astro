      if (!e.ctrlKey && !e.metaKey) return;
      if (focusT > 0.02) return;
      e.preventDefault();
      userZoomed = true;
      camZTarget = Math.max(7.2, Math.min(16, camZTarget + e.deltaY * 0.006));
    }, { passive: false });

    // ===== 尺寸与可见性 =====
    function resize() {
      const w = mount.clientWidth, h = mount.clientHeight;
      renderer.setSize(w, h);
      const pr = renderer.getPixelRatio();
      // uScale/uMax 都是「物理像素」语义：乘 pixelRatio 后真机（dpr 2/3）上的星点尺寸才与桌面观感一致
      // ★ 原来 uScale ∝ h 线性：屏幕越大星点被放大成 2.4px 的圆球 → 全屏「颗粒感/粗糙」。
      //   恒星是点光源，不该随屏幕变大而变大；正确的自适应是【加数量】（见 DN 上限 2.2）。
      //   这里把 h 的指数压到 0.35：900px 高为基准（值不变），1440px 只放大 1.18× 而不是 1.6×。
      const hk = Math.pow(h / 900, 0.2); // ★ 全屏细腻：大屏星点放大更缓（0.35 时 1440p 星径 +18% 读感粗糙），密度由 DN 承担
      dustMats.forEach((m) => {
        m.uniforms.uScale.value = 342 * pr * hk;
        if (m.userData.baseMax !== undefined) {
          m.uniforms.uMax.value = m.userData.baseMax * pr * hk;
          m.userData.sizeMul = pr * hk; // 记住基准乘子，主循环每帧做聚焦压低
        }
      });
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      fitRZ();
      userZoomed = false; // 视口变了：旧的手动缩放失效，重新自适应
      camZTarget = fitZ();
    }
    new ResizeObserver(resize).observe(mount);
    resize();

    // 滚出视口或切走标签页时暂停渲染循环，滚动性能零损耗
    let inView = true, rafId = 0;
    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (inView && !rafId) loop();
    }).observe(mount);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { cancelAnimationFrame(rafId); rafId = 0; }
      else if (inView && !rafId) loop();
    });
    // ★ 浏览器「返回」回到首页时，页面常由 bfcache 恢复（JS 状态原样保留）——
    //   那样会带着「聚焦某团 + 相机拉近」的状态回来（探索态却已退出，观感错乱）。
    //   返回首页应当是干净的默认全景：退出探索、解除聚焦、复位缩放与选中态。
    addEventListener('pageshow', (e) => {
      if (!(e as PageTransitionEvent).persisted) return;
