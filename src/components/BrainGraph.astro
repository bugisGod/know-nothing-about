---
// 银河星图：把首页的装饰银河与导航星图合并为一套系统
//   星团（cluster）= 分类 —— 钉在旋臂上，自带一团淡色星云晕
//   恒星（star）  = 文章 / 项目 —— 由 slug 哈希落在所属星团内，随星系缓缓自转
//   银河中心      = 个人信息（由 about 页承担，此处只留暖核）
// 交互：悬停出毛玻璃信息卡，点击进入；移动端点选后卡片浮到底部。
export interface ClusterDef {
  key: string;
  title: string;
  url: string;
  /** 域色（与分类色一致，在深空里会被降饱和使用） */
  color?: string;
  desc?: string;
  count: number;
  /** 星团形态语义：dense 密集结团 / spiral 规则螺旋 / scatter 分散广布 / natural 随机自然 */
  form?: string;
  /** 分类下不重复话题数（hover 信息用） */
  topics?: number;
  /** 话题标签列表（按文章数排序，tip 卡展示前几个） */
  topicList?: string[];
}
export interface StarDef {
  id: string;
  title: string;
  url: string;
  kind: string;
  group: string;
  tags: string[];
  desc?: string;
  date?: string;
  /** 所属星团 key */
  cluster: string;
  /** 新星：最近发布的文章（更亮更暖 + tip 标注） */
  recent?: boolean;
  /** 置顶 / 精选：银河里的「亮星」（最大最亮 + 光晕） */
  pinned?: boolean;
}

interface LinkDef {
  a: number;
  b: number;
  /** 权重：共享标签数（封顶 2）+ 跨星团 1 */
  w: number;
}

interface Props {
  clusters: ClusterDef[];
  stars: StarDef[];
  /** 星际连线：文章之间共享标签的关联（知识网络） */
  links?: LinkDef[];
  /** 夜空模式：去掉面板边框与底色，融入外部深色区块 */
  bare?: boolean;
  /** 整个星系在竖直方向的偏移（负值 = 下沉），hero 文字悬浮时给上方让出净空 */
  offsetY?: number;
  /** 图下方的说明文字 */
  caption?: string;
  /** 说明文字下的第二行小字提示 */
  captionHint?: string;
}

const { clusters, stars, links = [], bare = false, offsetY = 0, caption, captionHint } = Astro.props;
const dataJson = JSON.stringify({ clusters, stars, links }).replace(/</g, '\\u003c');
---

<section class="graph-sec" id="graph">
  <div class:list={['graph-frame', { bare }]}>
    <div id="brain-graph" class="graph-canvas" role="img" aria-label="银河星图：每个星团是一个分类，每颗恒星是一篇文章或项目。下方列表提供相同的导航。"></div>
    <div id="galaxy-focus" class="galaxy-focus" aria-hidden="true">
      <button type="button" class="gf-back">← 返回全景</button>
      <span class="gf-name"></span>
      <span class="gf-count"></span>
      <a class="gf-open" href="#">打开分类页 →</a>
    </div>
    <div id="explore-border" class="explore-border" aria-hidden="true"></div>
    <!-- 锁定星团后的文章列表（参考图面板 4）：悬停条目 → 星图里对应的星回亮 -->
    <aside id="galaxy-list" class="galaxy-list" aria-hidden="true">
      <div class="gl-head">
        <span class="gl-title"></span>
        <span class="gl-count"></span>
      </div>
      <ul class="gl-items"></ul>
    </aside>
    <!-- （底部摘要浮层 star-sheet 已移除：定位在画面底部会与标语/页脚文字重叠。
         语义改为：悬停看摘要卡（graph-tip），点击直接进文章页） -->
    <button type="button" id="explore-exit" class="explore-exit" aria-hidden="true">✦ EXIT EXPLORE</button>
    <div id="explore-help" class="explore-help" aria-hidden="true">拖动浏览 · 滚轮缩放 · 点击星团 / 恒星查看</div>
    <div id="graph-tip" class="graph-tip" aria-hidden="true">
      <p class="tip-kind"></p>
      <p class="tip-title"></p>
      <p class="tip-meta"></p>
      <p class="tip-desc"></p>
      <span class="tip-go">阅读全文 →</span>
    </div>
  </div>
  {(caption || captionHint) && (
    <p class="graph-caption">
      {caption && <span class="cap-main">{caption}</span>}
      {captionHint && <span class="cap-sub">{captionHint}</span>}
    </p>
  )}
  <script type="application/json" id="graph-data" set:html={dataJson} />
</section>

<style>
  /* 深空面板：两种主题下都是夜空底片 */
  .graph-frame {
    position: relative;
    margin-top: 14px;
    height: 500px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background:
      radial-gradient(52% 42% at 18% 24%, rgba(96, 118, 255, 0.13), transparent 70%),
      radial-gradient(46% 40% at 78% 72%, rgba(168, 122, 255, 0.1), transparent 72%),
      radial-gradient(120% 90% at 50% 0%, #131524 0%, #0b0c15 58%, #07080e 100%);
  }

  .graph-canvas {
    position: absolute;
    inset: 0;
    cursor: grab;
    touch-action: pan-y; /* 手机竖向滑动交给页面滚动，横向拖拽仍可旋转 */
  }

  /* 夜空模式：无框无底，fixed 铺满整个视口——不管页面多长、滚到哪里，星空永远铺底 */
  .graph-frame.bare {
    position: fixed;
    inset: 0;
    z-index: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    height: 100%;
    margin: 0;
  }

  .graph-sec {
    margin-top: 40px;
  }

  .graph-list {
    max-width: 720px;
    margin: 10px auto 0;
    font-size: 13px;
  }

  .graph-list summary {
    cursor: pointer;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--muted);
    text-align: center;
    list-style: none;
  }

  .graph-list summary::-webkit-details-marker {
    display: none;
  }

  .graph-list ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    columns: 2;
  }

  .graph-list a {
    color: var(--text-2);
    line-height: 1.9;
  }

  .graph-list a:hover {
    color: var(--accent);
  }

  .graph-canvas.grabbing {
    cursor: grabbing;
  }

  .graph-canvas.pointing {
    cursor: pointer;
  }

  /* 悬停信息卡：毛玻璃 + 极淡描边，风格与站点深色星空一致（衬线标题 + 琥珀行动语） */
  .graph-tip {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, calc(-100% - 16px));
    background: rgba(13, 15, 25, 0.72);
    border: 1px solid rgba(150, 160, 205, 0.16);
    border-radius: 12px;
    padding: 12px 15px 13px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.16s ease;
    width: max-content;
    max-width: 280px;
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 10px 34px rgba(3, 4, 10, 0.55);
  }

  .graph-tip.show {
    opacity: 1;
  }

  /* 触屏选中态：卡片可点按进入 */
  .graph-tip.tap {
    pointer-events: auto;
    cursor: pointer;
  }

  .tip-kind {
    margin: 0;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8d95b8;
  }

  .tip-go {
    display: inline-block;
    margin: 10px 0 0;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: #ffc46b;
  }

  .tip-title {
    margin: 5px 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15.5px;
    line-height: 1.35;
    color: #f3efe6;
  }

  .tip-meta {
    margin: 4px 0 0;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: #8d95b8;
  }

  .tip-desc {
    margin: 7px 0 0;
    font-size: 12.5px;
    line-height: 1.65;
    color: rgba(232, 230, 223, 0.6);
  }

  .tip-desc:empty {
    display: none;
  }

  /* 星团标签：名字 + 篇数，本身就是进入分类的按钮 */
  .graph-frame :global(.cluster-label) {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: column;   /* 团名在上、篇数在下：两块信息不同级，不该并排挤在一起 */
    align-items: center;
    gap: 3px;
    text-align: center;
    /* 衬线：星团名是这块空间的「地名」，衬线的庄重感让它像星图上的标注而非 UI 控件 */
    font-family: var(--font-display);
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.3; /* ★ 收紧半行距：文字贴住折线 */
    letter-spacing: 0.14em;
    white-space: nowrap;
    color: rgba(236, 234, 228, 0.82);
    text-shadow: 0 1px 10px rgba(7, 8, 14, 0.95), 0 0 16px rgba(120, 150, 220, 0.18);
    opacity: 0;
    pointer-events: none;
    will-change: transform;
    transition: opacity 0.4s ease, color 0.25s ease, font-size 0.25s ease, text-shadow 0.25s ease;
  }
  /* ★ 星图折线标注（用户参考图）：斜线从团升起 → 折成横线 → 标签挂在横线右端。
     盒右移 48 / 斜线 44px@30° 落在团心（JS base -16 配合），全部伪元素纯 CSS */
  .graph-frame :global(.cluster-label) {
    /* 水平偏移由 JS transform 直接给（盒左 = 主星x + 48），margin 会和 -50% 居中打架 */
  }
  /* ★ 标签回归贴近式（折线方案已否）：主星正下方 20px，从属感靠距离而非引线 */
  .graph-frame :global(.cluster-label) {
    line-height: 1.3;
  }

  /* hover 星团：名字明显亮起来 + 篇数浮出 —— 「这一片被指代了」要一眼看出来 */
  .graph-frame :global(.cluster-label[data-state="hover"]) {
    color: #ffe0aa;
    font-size: 17px;
    text-shadow: 0 1px 12px rgba(7, 8, 14, 0.95), 0 0 26px rgba(255, 200, 110, 0.5);
  }
  /* 点击锁定：团名是画面的视觉中心，但仍压得住分寸 —— 再大就成了网页 logo */
  .graph-frame :global(.cluster-label[data-state="focus"]) {
    color: #ffd18a;
    font-size: 22px;
    letter-spacing: 0.08em;
    text-shadow:
      0 1px 14px rgba(7, 8, 14, 0.95),
      0 0 30px rgba(255, 190, 96, 0.55),
      0 0 60px rgba(255, 180, 90, 0.28);
  }
  .graph-frame :global(.cluster-label[data-state="dim"]) {
    color: rgba(232, 230, 223, 0.72);
    font-size: 13.5px;
    text-shadow: 0 1px 8px rgba(7, 8, 14, 0.95);
  }

  /* ★ 太阳位置彩蛋（2026-10-24 定稿）：光点 + 短标注「太阳系 · 猎户臂」。
     原标注的「— 你在这里」按用户要求删除；避让由布局障碍覆盖（矩形含文字宽） */
  .graph-frame :global(.sun-mark) {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    pointer-events: auto;
    cursor: default;
    will-change: transform;
  }
  .graph-frame :global(.sun-mark i) {
    position: relative;
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #cfe4f7;
    box-shadow:
      0 0 6px rgba(190, 222, 248, 0.95),
      0 0 14px rgba(168, 205, 238, 0.55);
    animation: sun-pulse 3.2s ease-in-out infinite;
  }
  /* 十字星芒：太阳是全天空最亮恒星，给两条细芒与普通背景星拉开身份 */
  .graph-frame :global(.sun-mark i::before),
  .graph-frame :global(.sun-mark i::after) {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    background: linear-gradient(90deg, transparent, rgba(207, 228, 247, 0.85), transparent);
    transform: translate(-50%, -50%);
  }
  .graph-frame :global(.sun-mark i::before) {
    width: 15px;
    height: 1px;
  }
  .graph-frame :global(.sun-mark i::after) {
    width: 1px;
    height: 15px;
    background: linear-gradient(180deg, transparent, rgba(207, 228, 247, 0.85), transparent);
  }
  @keyframes sun-pulse {
    0%, 100% { box-shadow: 0 0 6px rgba(190, 222, 248, 0.95), 0 0 14px rgba(168, 205, 238, 0.55); }
    50% { box-shadow: 0 0 9px rgba(190, 222, 248, 1), 0 0 20px rgba(168, 205, 238, 0.8); }
  }
  .graph-frame :global(.sun-mark span) {
    font-family: var(--font-display);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    color: rgba(178, 212, 240, 0.6);
    text-shadow: 0 1px 8px rgba(7, 8, 14, 0.95);
    white-space: nowrap;
    opacity: 1;
    transition: opacity 0.4s ease, color 0.4s ease;
  }
  .graph-frame :global(.sun-mark:hover span) {
    color: rgba(200, 226, 246, 0.95);
  }
  /* ★ 探索态收起标注（与探索面板文字重叠），只留脉冲光点；hover 仍可展开 */
  .graph-frame :global(.sun-mark.sun-quiet span) {
    opacity: 0;
  }
  /* ★ 小高度视口（IAB 534px 一类）标注默认收起：与 hero 文字挤，hover 展开 */
  @media (max-height: 640px) {
    .graph-frame :global(.sun-mark span) {
      opacity: 0;
    }
    .graph-frame :global(.sun-mark:hover span) {
      opacity: 1;
    }
  }

  .graph-frame :global(.cl-count) {
    position: absolute;   /* ★ 脱流：盒子高度=团名，横线能贴到文字正下方 */
    top: calc(100% + 7px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    opacity: 0; /* 默认只显示团名（方案：数量 hover 再出现），hover/锁定浮出 */
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    transition: opacity 0.3s ease, color 0.3s ease;
  }

  /* ★ 整段后代选择器必须一起包进 :global()：.cl-count / .cl-topics 是 JS 动态创建的，
     不带 data-astro-cid；只把父级包 global、子级留在括号外，Astro 会给子级补上 scope
     属性选择器 → 选择器永不匹配（实测：hover 时篇数一直出不来，是个长期失效的隐藏 bug） */
  .graph-frame :global(.cluster-label[data-state="hover"] .cl-count),
  .graph-frame :global(.cluster-label[data-state="focus"] .cl-count) {
    opacity: 1;
    color: #ffc46b;
  }

  /* ★ 描述行（方案 B 第 2 层）：与 .cl-count 同样脱流绝对定位 —— 标签盒子高度仍等于团名，
     避让公式（lh = offsetHeight）不受影响；显隐由主循环按「漫游态 + 屏幕尺度」写 opacity */
  .graph-frame :global(.cl-desc) {
    position: absolute;
    top: calc(100% + 22px);
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    opacity: 0;
    font-family: var(--font-sans);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--text-2);
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  /* ★ 话题词胶囊（方案 B 第 3 层，用户拍板「只 hover 出现」）：与描述行同样脱流，
     纵向错开 16px 不叠字；显隐纯 CSS —— hover 时 data-state 已被主循环写成 "hover" */
  .graph-frame :global(.cl-topics) {
    position: absolute;
    top: calc(100% + 38px);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 5px;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  /* ★ 同上：整段包 global，否则子级被补 scope 属性后选择器不生效 */
  .graph-frame :global(.cluster-label[data-state="hover"] .cl-topics) {
    opacity: 0.85;
  }

  .graph-frame :global(.cl-topic) {
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.03em;
    color: var(--text-2);
    background: rgba(150, 170, 230, 0.14);
    border-radius: 999px;
    padding: 2px 8px;
  }

  /* 聚焦态：团名居中并带上一条极淡的下划隔离线（参考图锁定态的星团标题） */
  .graph-frame :global(.cluster-label[data-state="focus"])::after {
    content: '';
    position: absolute;
    left: 50%;
    top: auto;
    bottom: -12px;
    width: 46px;
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, rgba(255, 196, 107, 0.55), transparent);
  }

  /* ===== P1 探索层：视口边框 + EXIT 按钮 + 操作提示（方案模块 2）===== */
  .graph-frame :global(.explore-border) {
    position: absolute;
    inset: 12px;
    border: 1px solid rgba(185, 200, 235, 0.32);
    border-radius: 8px;
    box-shadow:
      inset 0 0 60px rgba(110, 140, 220, 0.07),
      0 0 30px rgba(110, 140, 220, 0.05);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.9s ease;
    z-index: 4;
  }
  .graph-frame :global(.explore-border.show) {
    opacity: 1;
    animation: explore-border-pulse 3.2s ease-in-out infinite;
  }
  @keyframes explore-border-pulse {
    0%, 100% { border-color: rgba(185, 200, 235, 0.24); box-shadow: inset 0 0 60px rgba(110, 140, 220, 0.05), 0 0 30px rgba(110, 140, 220, 0.04); }
    50% { border-color: rgba(185, 200, 235, 0.48); box-shadow: inset 0 0 60px rgba(110, 140, 220, 0.1), 0 0 30px rgba(110, 140, 220, 0.08); }
  }
  .graph-frame :global(.explore-exit) {
    position: absolute;
    left: 50%;
    bottom: 92px;
    transform: translateX(-50%);
    padding: 11px 30px;
    background: rgba(13, 15, 25, 0.7);
    border: 1px solid rgba(190, 205, 235, 0.42);
    border-radius: 999px;
    color: #e9edf6;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease, border-color 0.2s ease, color 0.2s ease;
    z-index: 4;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    white-space: nowrap;
  }
  .graph-frame :global(.explore-exit.show) {
    opacity: 1;
    pointer-events: auto;
  }
  .graph-frame :global(.explore-exit:hover) {
    border-color: rgba(217, 184, 121, 0.55);
    color: var(--accent);
  }
  .graph-frame :global(.explore-help) {
    position: absolute;
    left: 50%;
    bottom: 60px;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    color: rgba(232, 230, 223, 0.42);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease 0.25s;
    z-index: 4;
    white-space: nowrap;
  }
  .graph-frame :global(.explore-help.show) {
    opacity: 1;
  }
  /* 探索·漫游态：顶部胶囊只当「模式名牌」，不放出口——退出统一走底部 ✦ EXIT EXPLORE，
     避免同一屏两个都写着退出的按钮（原 .galaxy-focus.hidden-for-explore 那条死规则想解决的
     就是这个，但整条隐藏会把聚焦态的「团名 + 篇数」信息一起砍掉，故改为只隐藏按钮） */
  .graph-frame :global(.galaxy-focus.explore .gf-back) {
    display: none;
  }

  /* P1 探索层操作提示：底部居中，进入探索态时短暂浮现 */
  .graph-frame :global(.explore-tip) {
    position: absolute;
    left: 50%;
    top: 168px;
    transform: translateX(-50%);
    display: flex;
    gap: 26px;
    padding: 10px 20px;
    border: 1px solid rgba(150, 160, 205, 0.14);
    border-radius: 999px;
    background: rgba(13, 15, 25, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: rgba(232, 230, 223, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.7s ease;
    z-index: 3;
    white-space: nowrap;
  }
  .graph-frame :global(.explore-tip.show) {
