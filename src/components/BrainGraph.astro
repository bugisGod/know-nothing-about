      geo.setAttribute('aColor', new THREE.Float32BufferAttribute(col, 3));
      geo.setAttribute('aSize', new THREE.Float32BufferAttribute(sz, 1));
      geo.setAttribute('aPhase', new THREE.Float32BufferAttribute(pha, 1));
      geo.boundingSphere = new THREE.Sphere(new THREE.Vector3(), GR * 1.7);
      const mat = galaxyMat(1.4, 1.0, 9, { churn: 0.006 });
