    // Core 尺寸写死在 uMax：软钳公式 uMax*s/(uMax+s) 会让远近视差消失、恒定 ≈uMax px，
    // 这正是规范要的「文章星在任何深度都是恒定的小锐点」。
    // DPR=1 的 headless/低分屏上 2.8px 会没入背景星（2.2px）里 —— 取参数表上限 4px。
    // fadeLo 0.85→0.95：远侧的文章星也不被空气透视压暗（亮度下限抬高 = 整体更亮且稳定）
    // ★ uMax 4→8（2026-10-14 修 bug：拉近星团后看不到文章星）：gl_PointSize 是软钳 uMax·s/(uMax+s)，
    //   uMax=4 意味着无论相机多近，星核都被卡在 ~3.5px —— 团雾放大了、星没放大 → 星星消失在团里。
    //   放宽到 8：远看 6~7px（仍锐利），凑近可长到 ~8px，跟得上团雾的放大。
    const starPts = new THREE.Points(starGeo, galaxyMat(3.2, 1.0, 8, { churn: 0, fadeLo: 0.95, steady: 1 })); // ★ Core 3.2 + churn=0（2026-10-16 用户「星核和光晕不在一起/拉近会抖」）：
    // churn 是绕银心的角向摆动，聚焦拉近后 px/单位放大近十倍 → 星核在光晕里游移 ±5px = 抖动+核晕分离。
    // 文章星是导航锚点必须纹丝不动（亮度微闪由 uSteady 保留）；涌动的生命力交给银河尘埃层
    starPts.material.uniforms.uTex.value = coreTex; // 文章星核心贴图：实核占大头 → 极锐的小亮点
    starPts.material.uniforms.uMouseK.value = 0; // ★ 文章星引力归零（见渲染循环 uMouse 段注释）
    starPts.material.userData.baseMax = 4;
    dustMats.push(starPts.material); // 登记：resize 时跟随 pixelRatio 修正（手机否则偏小）
    galaxySpin.add(starPts);
    // P0 hover 层级：命中的恒星本体放大提亮（方案图「当前选中」级），离开回落
    const starSizeBase = starSize.slice();
    const starPosBase = starPos.slice(); // ★ 聚焦收缩的基准位置（每帧向团心收拢，base 不动）
    // 鼠标视差（默认态）：非拖拽时相机随鼠标微偏 —— 透视自动让远近星产生分层位移
    let mxT = 0, myT = 0, mxS = 0, myS = 0;
