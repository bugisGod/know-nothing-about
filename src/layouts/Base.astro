---
import "@fontsource/instrument-serif";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource-variable/inter";
import "@fontsource/noto-serif-sc/400.css";
import "@fontsource/noto-serif-sc/600.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StarField from "../components/StarField.astro";
import { SITE } from "../config";

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const {
  title,
  description = "个人名片 · 知识库 · 项目复盘",
  home = false,
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/og.png", Astro.site ?? "https://nihilscire.com").href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={[{ "is-home": home }]}>
    <script is:inline>
      // 深空照片轮换：每日把 12 张洗成一个排列，子页面各占不同槽位
      // → 主页面显式占槽（恒不重复），详情页哈希兜底；同日同页固定，隔天全站换血
      // 首页不参与：星空由 3D 星图承担
      (() => {
        let seed = new Date().getDate() * 2654435761 >>> 0;
        const deck = [...Array(12).keys()];
        for (let i = 11; i > 0; i--) {
          seed = (seed * 1664525 + 1013904223) >>> 0;
          const j = seed % (i + 1);
          [deck[i], deck[j]] = [deck[j], deck[i]];
        }
        const FIXED = { '/notes/': 0, '/projects/': 1, '/about/': 2, '/search/': 3 };
        const p = location.pathname;
        if (p === '/') return;
        let slot = FIXED[p];
        if (slot === undefined) {
          let h = 2166136261;
          for (const c of p) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619) >>> 0; }
          slot = h % 12;
        }
        document.body.dataset.sky = String(deck[slot]);
      })();
    </script>
    <StarField />
    <Header />
    <main class="site-main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/meteors.ts';

      // 代码块一键复制
      function initCodeCopy() {
        document.querySelectorAll(".prose pre").forEach((pre) => {
          if (pre.querySelector(".code-copy")) return;
          const btn = document.createElement("button");
          btn.className = "code-copy";
          btn.textContent = "复制";
          btn.addEventListener("click", async () => {
            await navigator.clipboard.writeText(
              pre.querySelector("code")?.textContent ?? pre.textContent,
            );
            btn.textContent = "已复制 ✓";
            btn.classList.add("done");
            setTimeout(() => {
              btn.textContent = "复制";
              btn.classList.remove("done");
            }, 1600);
          });
          pre.appendChild(btn);
        });
      }
      initCodeCopy();
      document.addEventListener("astro:page-load", initCodeCopy);
    </script>
  </body>
</html>
