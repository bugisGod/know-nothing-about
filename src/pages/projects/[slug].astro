---
import Base from "../../layouts/Base.astro";
import SkyBand from "../../components/SkyBand.astro";
import Icon from "../../components/Icon.astro";
import ArticleToc from "../../components/ArticleToc.astro";
import { listProjects, getProject } from "../../lib/posts";

export async function getStaticPaths() {
  return listProjects().map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const entry: any = Astro.props.entry ?? getProject(String(Astro.params.slug));
if (!entry) return Astro.rewrite("/404");
const entryHtml: string = entry.html;
const headings = [...entryHtml.matchAll(/<h([1-6]) id="([^"]*)"/g)].map((m) => ({
  depth: Number(m[1]), slug: m[2], text: '',
}));
const d = entry.data;

const fmt = (date: Date) =>
  `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
---

<Base title={d.title} description={d.description}>
  <SkyBand reading>
    <div class="crumbs">
      <a href="/projects/">项目复盘</a> / {d.status}
    </div>
    <h1>{d.title}</h1>
  </SkyBand>
  <div class="container reading-container article-layout">
    <ArticleToc headings={headings} />
    <article class="prose" data-pagefind-body>
      <div class="page-meta">
        {d.period && <span>{d.period}</span>}
        {d.role && <span>{d.role}</span>}
        <span>更新于 {fmt(d.date)}</span>
      </div>
      <div class="sub-lines">
        <span class="tech">{d.tech.join(" / ")}</span>
        {(d.link || d.repo) && (
          <span class="links">
            {d.link && (
              <a href={d.link} target="_blank" rel="noopener">
                <Icon name="link" size={13} /> 线上地址
              </a>
            )}
            {d.repo && (
              <a href={d.repo} target="_blank" rel="noopener">
                <Icon name="github" size={13} /> 仓库
              </a>
            )}
          </span>
        )}
      </div>
      <div set:html={entryHtml} />
    </article>
  </div>
</Base>

<style>
  .sub-lines {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin: 0 0 10px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--border);
  }

  .tech {
    color: var(--muted);
    font-size: 12.5px;
    font-family: var(--mono);
  }

  .links {
    display: flex;
    gap: 14px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    color: var(--text-2);
  }

  .links a:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
