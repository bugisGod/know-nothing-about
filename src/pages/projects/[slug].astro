---
import ArticlePage from "../../components/ArticlePage.astro";
import { getProject, listProjects } from "../../lib/posts";
import { PROJECT_COLOR } from "../../config";

export async function getStaticPaths() {
  return listProjects().map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const entry: any = Astro.props.entry ?? getProject(String(Astro.params.slug));
if (!entry) return Astro.rewrite("/404");
---

<ArticlePage kind="project" entry={entry} clusterColor={PROJECT_COLOR} />
