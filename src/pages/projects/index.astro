---
import Base from "../../layouts/Base.astro";
import SkyBand from "../../components/SkyBand.astro";
import { PROJECT_COLOR } from "../../config";
import { getCollection } from "astro:content";

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const statusKey = (s: string) =>
  ({ 进行中: "ongoing", 已完成: "done", 已归档: "archived" })[s] ?? "done";
const fmtDate = (d: Date) => {
  const x = new Date(d);
  return `${x.getFullYear()}.${String(x.getMonth() + 1).padStart(2, "0")}`;
};
---

<Base title="项目复盘" description="做过的项目、踩过的坑与沉淀的经验">
  <SkyBand>
    <h1 class="page-title">项目复盘</h1>
    <p class="page-desc">
      每个项目一份复盘：背景与目标、方案、踩坑记录、经验沉淀。
    </p>
  </SkyBand>
  <div class="container">
    <div class="proj-grid">
      {projects.map((p, i) => (
        <a class="proj-card" href={`/projects/${p.id}/`} style={`--tc: ${PROJECT_COLOR}`}>
          <div class="pc-top">
            <span class="pc-num">{String(i + 1).padStart(2, "0")}</span>
            <span class:list={["status", `status--${statusKey(p.data.status)}`]}>
              <i class="dot" />
              {p.data.status}
            </span>
          </div>
          <h3>{p.data.title}</h3>
          <p class="pc-desc">{p.data.description}</p>
          <div class="pc-tech">{p.data.tech.join(" / ")}</div>
          <div class="pc-foot">
            <span>{[p.data.period, p.data.role].filter(Boolean).join(" · ")}</span>
            <span class="pc-arrow" aria-hidden="true">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  /* ===== 项目卡片网格（参考知识库专题卡视觉语言，不带星图）===== */
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 420px));
    gap: 18px;
    padding-bottom: 40px;
  }
  .proj-card {
    display: flex;
    flex-direction: column;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background:
      radial-gradient(ellipse 60% 70% at 12% 0%, color-mix(in srgb, var(--tc) 7%, transparent), transparent),
      linear-gradient(120deg, #141d3088, transparent 65%);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .proj-card:hover {
    border-color: color-mix(in srgb, var(--tc) 45%, transparent);
    transform: translateY(-2px);
  }
  .pc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .pc-num {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--tc) 75%, transparent);
  }
  .proj-card h3 {
    margin: 0 0 8px;
    font: 400 19px var(--font-display);
    color: var(--text);
  }
  .pc-desc {
    margin: 0 0 14px;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--muted);
    flex: 1;
  }
  .pc-tech {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    color: color-mix(in srgb, var(--text) 55%, transparent);
    margin-bottom: 12px;
  }
  .pc-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  .pc-arrow {
    color: var(--muted);
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .proj-card:hover .pc-arrow {
    color: var(--tc);
    transform: translateX(4px);
  }
  .proj-card:hover h3 {
    color: color-mix(in srgb, var(--tc) 30%, var(--text));
  }
  .proj-card h3 { transition: color 0.25s ease; }
  @media (max-width: 760px) {
    .proj-grid { grid-template-columns: 1fr; }
  }
</style>
