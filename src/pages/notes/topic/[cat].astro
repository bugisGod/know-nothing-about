---
import Base from "../../../layouts/Base.astro";
import NebulaBand from "../../../components/NebulaBand.astro";
import MiniGalaxy from "../../../components/MiniGalaxy.astro";
import { SERIES, PROJECT_COLOR, assignClusterColors } from "../../../config";
import { categoryRegistry } from "../../../lib/category-meta";
import { listNotes } from "../../../lib/posts";

export async function getStaticPaths() {
  const notes = listNotes();
  const catOf = (id: string) => (id.includes("/") ? id.split("/")[0] : "");
  // ★ 双写对齐（2026-10-26 审查 P2）：这里原用「未分类」而 SSR 分支用 ""，兜底语义不一致；
  //   SSR 模式 getStaticPaths 不参与，纯对齐。空 cat 在 galaxy-data 已有防护。
  //   catOf 取到的 id 段已由 posts.toNote 统一小写，此处不再可能出现大写
  const cats = new Map<string, typeof notes>();
  for (const n of notes) {
    const cat = catOf(n.id);
    if (!cats.has(cat)) cats.set(cat, []);
    cats.get(cat)!.push(n);
  }
  return [...cats.entries()].map(([cat, entries]) => {
    const sorted = entries.sort(
      (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
    );
    // 专栏（series）分组：专题内部的子集合（如学习笔记下的「深入理解 AI Agent」）
    const seriesMap = new Map<string, { id: string; entries: typeof sorted }>();
    const loose: typeof sorted = [];
    for (const n of sorted) {
      const sid = n.data.series;
      if (sid && SERIES[sid]) {
        if (!seriesMap.has(sid)) seriesMap.set(sid, { id: sid, entries: [] });
        seriesMap.get(sid)!.entries.push(n);
      } else {
        loose.push(n);
      }
    }
    return {
      params: { cat },
      props: {
        entries: sorted,
        seriesList: [...seriesMap.values()],
        loose,
      },
    };
  });
}

// ★ 分类元信息（2026-10-26）：label/desc/color/shape 走「代码默认 + 后台注册表」合并，
//   新分类的中文名与一句话描述可在后台填，不必再改 config.ts
const CATS = categoryRegistry();
const { cat } = Astro.params;
// ★ 大小写归一（2026-10-26 审查 P2-1）：分类 key 一律小写。非规范 URL（/notes/topic/AI/）
//   301 到小写版，避免同一专题两个地址（SEO 重复内容）；
//   未知分类不再渲染空壳 banner（实测 /notes/topic/AI/ 曾返回 200 + 0 篇 + 默认雾蓝），改走 404。
const norm = (cat ?? "").toLowerCase();
if (norm !== cat) return Astro.redirect(`/notes/topic/${norm}/`, 301);
// SSR：无 props 时（直接 URL 访问）就地构建与 getStaticPaths 同构的数据
let { entries, seriesList, loose } = Astro.props as any;
if (!entries) {
  const all = listNotes();
  const sorted = all
    .filter((n) => (n.id.includes("/") ? n.id.split("/")[0] : "") === norm)
    .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
  const seriesMap = new Map();
  const looseArr = [];
  for (const n of sorted) {
    const sid = n.data.series;
    if (sid && SERIES[sid]) {
      if (!seriesMap.has(sid)) seriesMap.set(sid, { id: sid, entries: [] });
      seriesMap.get(sid).entries.push(n);
    } else looseArr.push(n);
  }
  entries = sorted;
  seriesList = [...seriesMap.values()];
  loose = looseArr;
}
// ★ 未知分类 → 404（此处 entries 已定：props 走 getStaticPaths 参数，或上面按 norm 过滤）
if (!entries.length) return Astro.rewrite("/404");
// ★ P0 修复（2026-10-26 审查报告实锤）：此前 color = Astro.props.color，但 props 从未传过
//   color（SSR 模式 getStaticPaths 也不参与）→ 恒 undefined → 所有专题页塌成默认雾蓝。
//   正确做法不是只给本团单独配色（会与全局分配结果不一致），而是与知识库列表页
//   完全同款：全量分类 + 相同 births 语义 + reserved=[PROJECT_COLOR]，再取本团色。
const _births: Record<string, string> = {};
const _cats = new Set<string>();
for (const _n of listNotes()) {
  const _c = _n.id.split("/")[0] || "未分类";
  _cats.add(_c);
  const _b = _n.data.date ? new Date(_n.data.date).toISOString().slice(0, 10) : "9999-99-99";
  if (!_births[_c] || _b < _births[_c]) _births[_c] = _b;
}
const _assigned = assignClusterColors(
  [..._cats].map((c0) => ({ key: `cat:${c0}`, color: CATS[c0]?.color ?? "", birth: _births[c0] })),
  [PROJECT_COLOR],
);
const meta = CATS[norm];
const color = _assigned[`cat:${norm}`] ?? meta?.color ?? "#9db8ff";
const label = meta?.label ?? norm;
const desc = meta?.desc ?? "";
const fmt = (date?: Date) =>
  date?.toISOString().slice(0, 10).replaceAll("-", ".") ?? "";
---
<Base title={`${label} · 知识库`} description={desc || `${label} 专题下的全部文章。`}>
  <div class="tp-hero">
    <div class="tp-nebula" aria-hidden="true">
      <NebulaBand height={360} />
    </div>
    <div class="container tp-hero-inner">
      <a class="tp-back" href="/notes/">← 返回知识库</a>
      <div class="tp-banner" style={`--tc: ${color}`}>
        <div class="tp-galaxy">
          <MiniGalaxy size={130} color={color} seed={`cat:${norm}`} shape={meta?.shape} />
        </div>
        <div class="tp-head">
          <small>⭐ 专题</small>
          <h1>{label}</h1>
          {desc && <p class="tp-desc">{desc}</p>}
          <span class="tp-count">{entries.length} 篇文章</span>
        </div>
      </div>
    </div>
  </div>

  <div class="container tp-body">
    {seriesList.map((sr) => {
      const sm = SERIES[sr.id];
      return (
        <section class="sr-sec" aria-label={`专栏：${sm.title}`}>
          <h2 class="sr-h2">
            <span class="sr-badge">专栏</span>{sm.title}
            <small class="sr-cnt">{sr.entries.length} 篇</small>
          </h2>
          {sm.desc && <p class="sr-desc">{sm.desc}</p>}
          <ol class="kb-timeline">
            {sr.entries.map((n) => (
              <li class="kb-entry">
                <a href={`/notes/${n.id}/`}>
                  <p class="kb-meta"><time datetime={n.data.date?.toISOString()}>{fmt(n.data.date)}</time></p>
                  <h2>{n.data.title}</h2>
                  {n.data.description && <p class="kb-desc">{n.data.description}</p>}
                  <span class="kb-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      );
    })}
    {loose.length > 0 && (
      <section class="sr-sec" aria-label="其他文章">
        {seriesList.length > 0 && <h2 class="sr-h2">其他文章</h2>}
        <ol class="kb-timeline">
            {loose.map((n) => (
              <li class="kb-entry">
                <a href={`/notes/${n.id}/`}>
                  <p class="kb-meta">
                    <time datetime={n.data.date?.toISOString()}>{fmt(n.data.date)}</time>
                    <span class="kb-pill">{label}</span>
                  </p>
                  <h2>{n.data.title}</h2>
                  {n.data.description && <p class="kb-desc">{n.data.description}</p>}
                  <span class="kb-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ol>
      </section>
    )}
    {entries.length === 0 && <p class="empty">该专题下暂无文章</p>}
  </div>
</Base>

<style>
  .tp-hero { position: relative; padding: 84px 0 30px; }
  .tp-nebula { position: absolute; inset: 0 0 auto 0; pointer-events: none; }
  .tp-nebula :global(.nebula-band) { height: auto !important; }
  .tp-nebula :global(canvas) { width: 100% !important; }
  .tp-hero-inner { position: relative; z-index: 1; }
  .tp-back {
    display: inline-block;
    margin-bottom: 22px;
    font-size: 12.5px;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .tp-back:hover { color: var(--text); }
  .tp-banner {
    display: flex;
    align-items: center;
    gap: 30px;
    padding: 26px 34px;
    border: 1px solid color-mix(in srgb, var(--tc) 28%, var(--border));
    border-radius: 14px;
    background:
      radial-gradient(ellipse 60% 100% at 14% 50%, color-mix(in srgb, var(--tc) 10%, transparent), transparent),
      linear-gradient(120deg, #141d3088, transparent 70%);
  }
  .tp-galaxy {
    flex-shrink: 0;
    filter: drop-shadow(0 0 20px color-mix(in srgb, var(--tc) 35%, transparent));
  }
  .tp-head small {
    display: block;
    font-size: 10.5px;
    color: var(--tc);
    letter-spacing: 0.2em;
    margin-bottom: 8px;
  }
  .tp-head h1 {
    margin: 0 0 8px;
    font: 400 30px var(--font-display);
  }
  .tp-desc { margin: 0 0 10px; font-size: 13px; line-height: 1.8; color: var(--muted); }
  .tp-count { font-family: var(--mono); font-size: 12px; color: var(--tc); letter-spacing: 0.04em; }

  .tp-body { padding-top: 8px; }
  .sr-sec { margin-bottom: 36px; }
  .sr-h2 {
    margin: 0 0 6px;
    font: 400 19px var(--font-display);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sr-badge {
    font: 400 10px var(--font-sans, sans-serif);
    color: var(--tc, var(--accent));
    border: 1px solid color-mix(in srgb, var(--tc) 45%, transparent);
    border-radius: 999px;
    padding: 2px 10px;
    letter-spacing: 0.14em;
  }
  .sr-cnt { font: 400 11px var(--mono); color: var(--muted); margin-left: 2px; }
  .sr-desc { margin: 0 0 14px; font-size: 12.5px; line-height: 1.7; color: var(--muted); max-width: 640px; }
  .kb-timeline {
    list-style: none;
    margin: 0;
    padding: 4px 0 4px 34px;
    position: relative;
  }
  .kb-timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 14px;
    bottom: 14px;
    width: 1px;
    background: linear-gradient(180deg, rgba(150, 170, 230, 0.3), rgba(150, 170, 230, 0.08));
  }
  .kb-entry { position: relative; margin-bottom: 14px; }
  .kb-entry::before {
    content: '';
    position: absolute;
    left: -33px;
    top: 22px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--tc, var(--accent));
    box-shadow: 0 0 8px color-mix(in srgb, var(--tc) 60%, transparent);
  }
  .kb-entry > a {
    display: block;
    position: relative;
    padding: 16px 44px 18px 4px;
    border-bottom: 1px solid rgba(150, 170, 230, 0.09);
  }
  .kb-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 9px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.05em;
  }
  .kb-pill {
    font-family: var(--font-sans, sans-serif);
    color: var(--tc, var(--accent));
    border: 1px solid color-mix(in srgb, var(--tc) 40%, transparent);
    border-radius: 999px;
    padding: 2px 10px;
  }
  .kb-entry h2 { margin: 0 0 8px; font: 400 21px var(--font-display); transition: color 0.25s ease; }
  .kb-entry > a:hover h2 { color: var(--accent); }
  .kb-desc { margin: 0; font-size: 13.5px; line-height: 1.8; color: var(--muted); max-width: 720px; }
  .kb-arrow {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .kb-entry > a:hover .kb-arrow {
    opacity: 1;
    transform: translateY(-50%) translateX(3px);
    color: var(--accent);
  }
  .empty { color: var(--muted); }
</style>
