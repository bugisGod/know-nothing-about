---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../config';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));

// 按年分组
const groups = new Map<number, typeof notes>();
for (const n of notes) {
  const y = n.data.date?.getFullYear() ?? 0;
  if (!groups.has(y)) groups.set(y, []);
  groups.get(y)!.push(n);
}
const years = [...groups.keys()].sort((a, b) => b - a);

const fmtMD = (d?: Date) =>
  d ? `${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}` : '';
---

<Base title="知识库" description="scio 的知识库">
  <div class="container">
    <header class="head">
      <h1>知识库</h1>
      <p class="sub">{notes.length} 篇 · 持续生长</p>
    </header>

    {
      years.map((y) => (
        <section class="year-group">
          <h2>{y}</h2>
          <div class="entries">
            {groups.get(y)!.map((n) => (
              <a class="row" href={`/notes/${n.id}/`}>
                <span class="t">{n.data.title}</span>
                {n.data.tags.length > 0 && (
                  <span class="tags">{n.data.tags.map((t) => `#${t}`).join(' ')}</span>
                )}
                <span class="d">{fmtMD(n.data.date)}</span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .head {
    margin: 12px 0 24px;
  }

  .head h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(34px, 4.5vw, 44px);
    letter-spacing: 0.01em;
    margin: 0 0 8px;
  }

  .sub {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin: 0;
  }

  .year-group {
    margin-top: 34px;
  }

  .year-group h2 {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.3em;
    color: var(--accent);
    margin: 0 0 4px;
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 13px 0;
    border-bottom: 1px solid var(--border);
  }

  .t {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18.5px;
    letter-spacing: 0.01em;
    color: var(--text);
    line-height: 1.5;
    min-width: 0;
  }

  .row:hover .t {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    text-decoration-color: var(--accent);
  }

  .tags {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    min-width: 0;
  }

  .d {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    margin-left: auto;
  }

  @media (max-width: 640px) {
    .head {
      margin-top: 4px;
    }

    .row {
      gap: 10px;
      padding: 12px 0;
    }

    .t {
      font-size: 17px;
    }

    .tags {
      display: none;
    }
  }
</style>
