---
import Base from "../../layouts/Base.astro";
import SkyBand from "../../components/SkyBand.astro";
import { CATEGORIES, SERIES } from "../../config";
import { getCollection } from "astro:content";
const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const catOf = (id: string) => id.split("/")[0];
const cats = [...new Set(notes.map((n) => catOf(n.id)))].sort();
const series = Object.entries(SERIES)
  .map(([id, s]) => ({
    ...s,
    id,
    entries: notes.filter((n) => n.data.series === id),
  }))
  .filter((s) => s.entries.length);
const fmt = (date?: Date) =>
  date?.toISOString().slice(0, 10).replaceAll("-", ".") ?? "";
---

<Base title="知识库" description="笔记与学习记录">
  <SkyBand>
    <h1>知识库</h1>
  </SkyBand>
  <div class="container library">
    {series.length > 0 && (
      <section class="series-list" aria-label="专栏">
        {series.map((s) => (
          <details class="series">
            <summary>
              <span>
                <small>专栏</small>
                <strong>{s.title}</strong>
              </span>
              <span class="series-count">
                {s.entries.length} 篇 <span aria-hidden="true">＋</span>
              </span>
            </summary>
            <div class="series-entries">
              {s.entries.map((n) => (
                <a href={`/notes/${n.id}/`}>
                  {n.data.title}
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </details>
        ))}
      </section>
    )}
    <nav class="filters" aria-label="笔记分类">
      <a href="/notes/" data-category="" aria-current="true">
        全部 <small>{notes.length}</small>
      </a>
      {cats.map((cat) => (
        <a href={`?category=${encodeURIComponent(cat)}`} data-category={cat}>
          {CATEGORIES[cat]?.label ?? cat}
          <small>{notes.filter((n) => catOf(n.id) === cat).length}</small>
        </a>
      ))}
    </nav>
    <div class="library-list">
      {notes.map((n) => (
        <article class="library-entry" data-note-category={catOf(n.id)}>
          <a href={`/notes/${n.id}/`}>
            <div class="entry-top">
              <span class="entry-category">
                {CATEGORIES[catOf(n.id)]?.label ?? catOf(n.id)}
              </span>
              <time datetime={n.data.date?.toISOString()}>
                {fmt(n.data.date)}
              </time>
            </div>
            <h2>{n.data.title}</h2>
            {n.data.description && <p>{n.data.description}</p>}
            <div class="entry-bottom">
              <span>{n.data.tags.slice(0, 3).join(" / ")}</span>
              <span aria-hidden="true">↗</span>
            </div>
          </a>
        </article>
      ))}
    </div>
    {notes.length === 0 && <p class="empty">暂无笔记</p>}
  </div>
</Base>
<style>
  .library {
    max-width: 1120px;
  }
  .series-list {
    margin-bottom: 44px;
    display: grid;
    gap: 16px;
  }
  .series {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: linear-gradient(120deg, #19243655, transparent);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 28px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary small {
    display: block;
    font-size: 10px;
    font-weight: 400;
    color: var(--accent);
    margin-bottom: 8px;
    letter-spacing: 0.15em;
  }
  summary strong {
    font: 400 24px var(--font-display);
  }
  .series-count {
    flex-shrink: 0;
    font-size: 11px;
    color: var(--muted);
  }
  .series-count span {
    margin-left: 16px;
  }
  .series-entries {
    padding: 0 28px 16px;
  }
  .series-entries a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    font-size: 14px;
    border-top: 1px solid var(--border);
  }
  .series-entries a:hover {
    color: var(--accent);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .filters a {
    font-size: 13px;
    color: var(--muted);
    padding: 10px 0;
  }
  .filters a[aria-current] {
    color: var(--text);
  }
  .filters small {
    font: 10px var(--mono);
    margin-left: 8px;
    color: var(--muted);
  }
  .library-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 56px;
  }
  .library-entry {
    min-width: 0;
    border-bottom: 1px solid var(--border);
  }
  .library-entry a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px 0;
  }
  .entry-top,
  .entry-bottom {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-size: 11px;
    color: var(--muted);
  }
  time {
    font: 10px var(--mono);
    white-space: nowrap;
  }
  h2 {
    font: 400 22px/1.5 var(--font-display);
    margin: 14px 0 10px;
  }
  .library-entry p {
    font-size: 14px;
    color: var(--text-2);
    margin: 0 0 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .entry-bottom {
    margin-top: auto;
    font-size: 10px;
  }
  .library-entry a:hover h2 {
    color: var(--accent);
  }
  .empty {
    color: var(--muted);
    padding: 40px 0;
  }
  @media (max-width: 760px) {
    .library-list {
      grid-template-columns: minmax(0, 1fr);
    }
    summary {
      padding: 20px;
      gap: 12px;
    }
    summary strong {
      font-size: 21px;
    }
    .series-count span {
      margin-left: 4px;
    }
    .series-entries {
      padding-inline: 20px;
    }
    .series-list {
      margin-bottom: 28px;
    }
    h2 {
      font-size: 21px;
    }
    .library-entry a {
      padding: 24px 0;
    }
  }
</style>
<script>
  const filters = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-category]"),
  ];
  const entries = [
    ...document.querySelectorAll<HTMLElement>("[data-note-category]"),
  ];
  function filter() {
    const requested = new URL(location.href).searchParams.get("category") ?? "";
    const category = filters.some((a) => a.dataset.category === requested)
      ? requested
      : "";
    entries.forEach(
      (entry) =>
        (entry.hidden = !!category && entry.dataset.noteCategory !== category),
    );
    filters.forEach((a) => {
      if (a.dataset.category === category)
        a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    });
  }
  filters.forEach((a) =>
    a.addEventListener("click", (e) => {
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      history.pushState(null, "", a.href);
      filter();
    }),
  );
  window.addEventListener("popstate", filter);
  filter();
</script>
