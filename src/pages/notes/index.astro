---
import Base from '../../layouts/Base.astro';
import SkyBand from '../../components/SkyBand.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../config';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));

const catOf = (id: string) => (id.includes('/') ? id.split('/')[0] : '未分类');
const catLabel = (c: string) => CATEGORIES[c]?.label ?? c;

const fmtMD = (d?: Date) =>
  d ? `${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}` : '';

// 专栏：同系列文章归组（featured 置顶展示）
const FEATURED = { id: 'ai-agent-book', title: '深入理解 AI Agent' };
const seriesNotes = notes.filter((n) => n.data.series === FEATURED.id);
const otherNotes = notes.filter((n) => n.data.series !== FEATURED.id);

// 恒星生长阶段：按文章年龄自动标注（星辰宇宙的时间观）
function stageOf(d?: Date) {
  if (!d) return { glyph: '✦', label: '新星', cls: 'new' };
  const days = (Date.now() - d.getTime()) / 86400000;
  if (days <= 45) return { glyph: '✦', label: '新星', cls: 'new' };
  if (days <= 365) return { glyph: '✧', label: '亮星', cls: 'bright' };
  return { glyph: '★', label: '恒星', cls: 'stable' };
}
---

<Base title="知识库" description="scio 的知识库：笔记与学习记录，持续生长">
  <SkyBand>
    <div class="container">
      <header class="head">
        <h1>知识库</h1>
        <p class="sub">{notes.length} 篇 · 持续生长</p>
      </header>
    </div>
  </SkyBand>

  <div class="container">
    <!-- 专栏特色卡：深入理解 AI Agent -->
    {
      seriesNotes.length > 0 && (
        <section class="column-card" aria-label={`专栏：${FEATURED.title}`}>
          <header class="cc-head">
            <div class="cc-title-wrap">
              <span class="cc-kicker">✦ 专栏</span>
              <h2 class="cc-title">{FEATURED.title}</h2>
            </div>
            <span class="cc-count">{seriesNotes.length} 篇 · 进行中</span>
          </header>
          <div class="cc-list">
            {
              seriesNotes.map((n) => (
                <a class="cc-row" href={`/notes/${n.id}/`}>
                  <span class="cc-t">{n.data.title}</span>
                  <span class="cc-d">{fmtMD(n.data.date)}</span>
                </a>
              ))
            }
          </div>
        </section>
      )
    }

    <!-- 全部笔记：卡片网格 -->
    <section class="sec">
      <h2 class="sec-h">全部笔记</h2>
      <div class="card-grid">
        {
          otherNotes.map((n) => {
            const st = stageOf(n.data.date);
            const cc = CATEGORIES[catOf(n.id)]?.color;
            return (
              <a class="card note-card" href={`/notes/${n.id}/`}>
                <span class={`stage ${st.cls}`} aria-hidden="true">
                  {st.glyph} {st.label}
                </span>
                <h3 class="t">{n.data.title}</h3>
                {n.data.description && <p class="desc">{n.data.description}</p>}
                <div class="meta">
                  <span class="tags">{n.data.tags.map((t) => `#${t}`).join('  ')}</span>
                  <span class="d">
                    <i class="cdot" style={`--c:${cc ?? '#d9a920'}`} aria-hidden="true" />
                    {catLabel(catOf(n.id))} · {fmtMD(n.data.date)}
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
    </section>
  </div>
</Base>

<style>
  /* 内容轴收紧：列表页与标题共用 880px 一条中轴，行不再横铺整屏 */
  .container {
    max-width: 880px;
  }

  :global(.sky-band .container) {
    max-width: 880px;
  }

  /* 统一垂直节奏：主间距一律 30px */
  .sec {
    margin-top: 30px;
  }

  .sec-h {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 12px;
  }

  /* ===== 专栏特色卡 ===== */
  .column-card {
    margin: 0;
    padding: 22px 26px 16px;
    border: 1px solid rgba(232, 230, 223, 0.14);
    border-radius: 13px;
    /* 实底深空色：卡片「浮」在星空上，而不是融进去（磨砂已去） */
    background:
      radial-gradient(120% 100% at 0% 0%, rgba(96, 118, 255, 0.07), transparent 55%),
      #12141d;
  }

  .cc-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 8px;
  }

  .cc-kicker {
    display: block;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--accent);
    margin-bottom: 4px;
  }

  .cc-title {
    font-family: var(--font-sans);
    font-weight: 650;
    font-size: 20px;
    letter-spacing: 0.01em;
    color: var(--text);
    margin: 0;
  }

  .cc-count {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .cc-list {
    display: flex;
    flex-direction: column;
  }

  .cc-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 2px;
    border-bottom: 1px solid var(--border);
  }

  .cc-row:last-child {
    border-bottom: none;
  }

  .cc-t {
    font-family: var(--font-sans);
    font-weight: 550;
    font-size: 15px;
    color: var(--text);
    line-height: 1.55;
  }

  .cc-row:hover .cc-t {
    color: var(--accent);
  }

  .cc-d {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* ===== 全部笔记：卡片网格 ===== */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 16px;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 19px 21px;
    border: 1px solid rgba(232, 230, 223, 0.14);
    border-radius: 13px;
    /* 实底深空色 + 亮 1px 边：卡片浮在星空上 */
    background:
      radial-gradient(120% 90% at 20% 0%, rgba(96, 118, 255, 0.05), transparent 60%),
      #12141d;
    transition: border-color 0.2s ease, transform 0.25s ease;
  }

  .card:hover {
    border-color: rgba(232, 230, 223, 0.22);
    transform: translateY(-3px);
  }

  .stage {
    position: absolute;
    top: 13px;
    right: 15px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .stage.new {
    color: var(--accent);
  }

  .t {
    font-family: var(--font-sans);
    font-weight: 650;
    font-size: 17.5px;
    letter-spacing: 0.01em;
    line-height: 1.5;
    color: var(--text);
    margin: 0;
    padding-right: 52px;
  }

  .card:hover .t {
    color: var(--accent);
  }

  .desc {
    margin: 0;
    max-width: 62ch;
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 4px;
  }

  .tags {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .d {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* 分类恒星色温点：学习=蓝白 / 前端=暖白，色彩从一颗小星开始 */
  .cdot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 6px var(--c);
    margin-right: 7px;
    vertical-align: 1px;
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .column-card {
      padding: 16px 15px 12px;
    }

    .cc-title {
      font-size: 18px;
    }

    .cc-row {
      padding: 9px 2px;
    }

    .cc-t {
      font-size: 14.5px;
    }

    .sec {
      margin-top: 22px;
    }

    .card {
      padding: 15px 16px;
      gap: 8px;
    }

    .t {
      font-size: 16.5px;
      padding-right: 48px;
    }

    .desc {
      font-size: 12.5px;
    }
  }
</style>
