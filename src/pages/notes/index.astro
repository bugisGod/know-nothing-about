---
import Base from "../../layouts/Base.astro";
import NebulaBand from "../../components/NebulaBand.astro";
import MiniGalaxy from "../../components/MiniGalaxy.astro";
import { SERIES } from "../../config";
import { getCollection } from "astro:content";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);

// 专题（知识星团）：series → 条目
const series = Object.entries(SERIES)
  .map(([id, s]) => ({
    ...s,
    id,
    entries: notes.filter((n) => n.data.series === id),
  }))
  .filter((s) => s.entries.length)
  .sort((a, b) => b.entries.length - a.entries.length);

// 标签聚合：全站笔记标签按热度排序（分类筛选已废除，标签是唯一组织维度）
const tagCount = new Map<string, number>();
for (const n of notes) for (const t of n.data.tags ?? []) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
const hotTags = [...tagCount.entries()].sort((a, b) => b[1] - a[1]).map(([t]) => t);

const fmt = (date?: Date) =>
  date?.toISOString().slice(0, 10).replaceAll("-", ".") ?? "";
---
<Base title="知识库" description="记录我学习、阅读与思考留下的东西。">
  <div class="kb-hero">
    <div class="kb-nebula" aria-hidden="true">
      <NebulaBand height={430} />
    </div>
    <div class="container kb-hero-inner">
      <div class="kb-head">
        <div class="kb-head-main">
          <h1>知识库</h1>
          <p class="kb-sub">
            记录我学习、阅读与思考留下的东西。<br />
            在这里，你可以找到我积累的知识、笔记和思考。
          </p>
        </div>
        <span class="kb-motto" aria-hidden="true">Knowledge<br />is a galaxy.</span>
      </div>
    </div>
  </div>
  <div class="container library">
    {series.length > 0 && (
      <section class="series-list" aria-label="专题（知识星团）">
        {series.map((s) => (
          <a class="series" href={`/notes/series/${s.id}/`}>
            <div class="series-galaxy">
              <MiniGalaxy size={150} color={s.color ?? '#9db8ff'} />
            </div>
            <div class="series-info">
              <small>专题</small>
              <strong>{s.title}</strong>
              {s.desc && <p class="series-desc">{s.desc}</p>}
              <span class="series-count">{s.entries.length} 篇文章 <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </section>
    )}

    <div class="kb-toolbar">
      <nav class="tag-nav" aria-label="按标签筛选">
        <button type="button" class="tag-pill" data-tag="" aria-pressed="true">全部</button>
        {hotTags.map((t) => (
          <button type="button" class="tag-pill" data-tag={t} aria-pressed="false">{t}</button>
        ))}
      </nav>
      <label class="sort-box">
        <select id="kb-sort" aria-label="排序">
          <option value="latest">最新发布</option>
          <option value="earliest">最早发布</option>
        </select>
      </label>
    </div>

    <ol class="kb-timeline" id="kb-list">
      {notes.map((n) => (
        <li
          class="kb-entry"
          data-date={n.data.date?.toISOString() ?? ""}
          data-tags={(n.data.tags ?? []).join(",")}
        >
          <a href={`/notes/${n.id}/`}>
            <p class="kb-meta">
              <time datetime={n.data.date?.toISOString()}>{fmt(n.data.date)}</time>
              {(n.data.tags ?? []).slice(0, 2).map((t) => (
                <span class="kb-meta-tag">{t}</span>
              ))}
            </p>
            <h2>{n.data.title}</h2>
            {n.data.description && <p class="kb-desc">{n.data.description}</p>}
            <p class="kb-tags">
              {(n.data.tags ?? []).slice(0, 3).map((t) => (
                <span class="kb-tag-pill">{t}</span>
              ))}
            </p>
            <span class="kb-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
    {notes.length === 0 && <p class="empty">暂无笔记</p>}
  </div>
</Base>

<script>
  // 标签筛选 + 排序（客户端，无框架）
  const list = document.getElementById('kb-list') as HTMLElement | null;
  const pills = [...document.querySelectorAll<HTMLButtonElement>('.tag-pill')];
  const sort = document.getElementById('kb-sort') as HTMLSelectElement | null;
  const entries = list ? [...list.querySelectorAll<HTMLElement>('.kb-entry')] : [];
  let curTag = new URLSearchParams(location.search).get('tag') ?? '';

  const apply = () => {
    for (const el of entries) {
      const tags = (el.dataset.tags ?? '').split(',');
      const show = !curTag || tags.includes(curTag);
      el.style.display = show ? '' : 'none';
    }
    for (const b of pills) b.setAttribute('aria-pressed', String(b.dataset.tag === curTag));
    if (list) {
      const order = sort?.value === 'earliest' ? 1 : -1;
      [...list.children]
        .sort((a, b) =>
          order * (((a as HTMLElement).dataset.date ?? '').localeCompare((b as HTMLElement).dataset.date ?? '')))
        .forEach((el) => list.appendChild(el));
    }
  };
  for (const b of pills) b.addEventListener('click', () => {
    curTag = b.dataset.tag ?? '';
    const url = new URL(location.href);
    if (curTag) url.searchParams.set('tag', curTag); else url.searchParams.delete('tag');
    history.replaceState(null, '', url);
    apply();
  });
  sort?.addEventListener('change', apply);
  if (curTag && pills.some((b) => b.dataset.tag === curTag)) apply();
</script>

<style>
  /* ===== 页头：星云银河带 + 标题压在其上 ===== */
  .kb-hero {
    position: relative;
    padding: 84px 0 26px;
  }
  .kb-nebula {
    position: absolute;
    inset: 0 0 auto 0;
    pointer-events: none;
  }
  .kb-nebula :global(.nebula-band) {
    height: auto !important;
  }
  .kb-nebula :global(canvas) {
    width: 100% !important;
  }
  .kb-hero-inner {
    position: relative;
    z-index: 1;
  }
  /* ===== 页头：标题 + 副标题 + 英文点缀 ===== */
  .kb-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }
  .kb-head h1 {
    margin: 0 0 14px;
    font-size: clamp(34px, 4vw, 52px);
  }
  .kb-sub {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--muted);
  }
  .kb-motto {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    opacity: 0.75;
    transform: rotate(-6deg);
    text-align: right;
    letter-spacing: 0.04em;
  }
  @media (max-width: 760px) {
    .kb-motto { display: none; }
  }

  /* ===== 专题入口（知识星团）===== */
  .series-list {
    margin-bottom: 48px;
    display: grid;
    gap: 18px;
  }
  .series {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 22px 30px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background:
      radial-gradient(ellipse 60% 90% at 18% 50%, rgba(120, 140, 220, 0.07), transparent),
      linear-gradient(120deg, #141d3088, transparent 65%);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .series:hover {
    border-color: rgba(150, 170, 230, 0.35);
    transform: translateY(-2px);
  }
  .series-galaxy {
    flex-shrink: 0;
    filter: drop-shadow(0 0 18px rgba(120, 150, 230, 0.25));
  }
  .series-info small {
    display: block;
    font-size: 10px;
    font-weight: 400;
    color: var(--accent);
    letter-spacing: 0.18em;
    margin-bottom: 7px;
  }
  .series-info strong {
    display: block;
    font: 400 25px var(--font-display);
    margin-bottom: 8px;
  }
  .series-desc {
    margin: 0 0 12px;
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
    max-width: 560px;
  }
  .series-count {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .series-count span {
    margin-left: 8px;
    transition: transform 0.25s ease;
  }
  .series:hover .series-count span {
    transform: translateX(4px);
  }

  /* ===== 工具栏：标签筛选 + 排序 ===== */
  .kb-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 34px;
    flex-wrap: wrap;
  }
  .tag-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
  }
  .tag-pill {
    font: 400 13px var(--font-sans, sans-serif);
    color: var(--muted);
    background: none;
    border: none;
    padding: 6px 13px;
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.25s ease, background 0.25s ease;
  }
  .tag-pill:hover {
    color: var(--text);
  }
  .tag-pill[aria-pressed="true"] {
    color: var(--text);
    background: rgba(150, 170, 230, 0.14);
  }
  .sort-box select {
    font: 400 12.5px var(--font-sans, sans-serif);
    color: var(--muted);
    background: none;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 7px 10px;
    cursor: pointer;
  }
  .sort-box select:hover {
    color: var(--text);
  }

  /* ===== 时间线列表 ===== */
  .kb-timeline {
    list-style: none;
    margin: 0;
    padding: 4px 0 4px 34px;
    position: relative;
  }
  .kb-timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 14px;
    bottom: 14px;
    width: 1px;
    background: linear-gradient(180deg, rgba(150, 170, 230, 0.3), rgba(150, 170, 230, 0.08));
  }
  .kb-entry {
    position: relative;
    margin-bottom: 14px;
  }
  .kb-entry::before {
    content: '';
    position: absolute;
    left: -33px;
    top: 22px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px rgba(150, 170, 230, 0.6);
  }
  .kb-entry > a {
    display: block;
    position: relative;
    padding: 16px 44px 18px 4px;
    border-bottom: 1px solid rgba(150, 170, 230, 0.09);
  }
  .kb-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 9px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.05em;
  }
  .kb-meta-tag::before {
    content: '·';
    margin-right: 10px;
  }
  .kb-entry h2 {
    margin: 0 0 8px;
    font: 400 21px var(--font-display);
    transition: color 0.25s ease;
  }
  .kb-entry > a:hover h2 {
    color: var(--accent);
  }
  .kb-desc {
    margin: 0 0 12px;
    font-size: 13.5px;
    line-height: 1.8;
    color: var(--muted);
    max-width: 720px;
  }
  .kb-tags {
    display: flex;
    gap: 6px;
    margin: 0;
  }
  .kb-tag-pill {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .kb-arrow {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .kb-entry > a:hover .kb-arrow {
    opacity: 1;
    transform: translateY(-50%) translateX(3px);
    color: var(--accent);
  }
  .empty {
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .series {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 20px;
    }
    .kb-entry > a {
      padding-right: 20px;
    }
  }
</style>
