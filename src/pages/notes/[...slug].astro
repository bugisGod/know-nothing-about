---
import Base from '../../layouts/Base.astro';
import SkyBand from '../../components/SkyBand.astro';
import { CATEGORIES, SERIES } from '../../config';
import { getCollection, render } from 'astro:content';

const catLabel = (c: string) => CATEGORIES[c]?.label ?? c;

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
// 目录：只收 h2（章节级），240px 宽栏单行放得下不再折行
const toc = (headings ?? []).filter((h) => h.depth === 2);

const notes = await getCollection('notes', ({ data }) => !data.draft);
const catOf = (id: string) => (id.includes('/') ? id.split('/')[0] : '未分类');

const groups = new Map<string, typeof notes>();
for (const n of notes) {
  const cat = catOf(n.id);
  if (!groups.has(cat)) groups.set(cat, []);
  groups.get(cat)!.push(n);
}
for (const items of groups.values()) {
  items.sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh'));
}
const cats = [...groups.keys()].sort((a, b) => a.localeCompare(b));

// 上一篇/下一篇（按日期倒序：newer 为上一篇）
const sortedNotes = [...notes].sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);
const idx = sortedNotes.findIndex((n) => n.id === entry.id);
const newer = idx > 0 ? sortedNotes[idx - 1] : null;
const older = idx >= 0 && idx < sortedNotes.length - 1 ? sortedNotes[idx + 1] : null;

const currentCat = catOf(entry.id);
const currentCatLabel = catLabel(currentCat);

// 专栏：同 series 的文章按日期排序，标注归属与序号
const seriesName = entry.data.series;
const seriesMates = seriesName
  ? [...notes].filter((n) => n.data.series === seriesName)
      .sort((a, b) => (a.data.date?.getTime() ?? 0) - (b.data.date?.getTime() ?? 0))
  : [];
const seriesIdx = seriesMates.findIndex((n) => n.id === entry.id);

const fmt = (d?: Date) =>
  d ? `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}` : '';

// 阅读时长：中文字符约 380/分钟，拉丁词约 500/分钟
const cjkCount = (entry.body?.match(/[一-鿿]/g) ?? []).length;
const latinWords = (entry.body?.match(/[A-Za-z]+/g) ?? []).length;
const minutes = Math.max(1, Math.round(cjkCount / 380 + latinWords / 500));
---

<Base title={entry.data.title} description={entry.data.description ?? entry.data.title}>
  <SkyBand wide>
    <div class="container wide">
      <div class="crumbs"><a href="/notes/">知识库</a> / <span class="cur-cat">{currentCatLabel}</span></div>
      <h1>{entry.data.title}</h1>
      <div class="page-meta">
        <span>更新于 {fmt(entry.data.date)}</span>
        <span>约 {minutes} 分钟</span>
        <span class="tags-inline">{entry.data.tags.map((t) => `#${t}`).join('  ')}</span>
      </div>
    </div>
  </SkyBand>
  <div class="container wide">
  <div class="notes-layout">
    <aside class="sidebar" aria-label="知识库目录">
      {
        [...cats].map((cat) => (
          <div class="cat-group">
            <div class="cat">{catLabel(cat)}</div>
            {groups.get(cat)!.map((n) => (
              <a href={`/notes/${n.id}/`} class:list={[{ current: n.id === entry.id }]} title={n.data.title}>
                {n.data.title}
              </a>
            ))}
          </div>
        ))
      }
    </aside>


    <article class="prose" data-pagefind-body>
      {seriesName && (
        <div class="series-badge">专栏 · {SERIES[seriesName]?.title ?? seriesName} · {String(seriesIdx + 1).padStart(2, '0')}/{String(seriesMates.length).padStart(2, '0')}</div>
      )}
      <Content />
      <nav class="pn">
        {older ? <a class="pn-box" href={`/notes/${older.id}/`}><span>← 上一篇</span><b>{older.data.title}</b></a> : <span />}
        {newer ? <a class="pn-box" href={`/notes/${newer.id}/`}><span>下一篇 →</span><b>{newer.data.title}</b></a> : <span />}
      </nav>
    </article>

    {
      toc.length > 1 && (
        <aside class="toc" aria-label="本文目录">
          <div class="toc-title">目录</div>
          <ul>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`} title={h.text}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
  </div>
</Base>

<script>
  // 目录滚动高亮：当前章节的 h2 可见时，点亮对应目录项
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  if (tocLinks.length) {
    const byHeading = new Map<Element, HTMLAnchorElement>();
    for (const a of tocLinks) {
      const id = (a.getAttribute('href') ?? '').slice(1);
      const h = document.getElementById(id);
      if (h) byHeading.set(h, a);
    }
    const setCurrent = (link: HTMLAnchorElement | undefined) => {
      for (const l of tocLinks) l.classList.toggle('current', l === link);
    };
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) setCurrent(byHeading.get(e.target));
        }
      },
      { rootMargin: '-76px 0px -68% 0px', threshold: 0 }
    );
    for (const h of byHeading.keys()) spy.observe(h);
  }
</script>

<style>
  .notes-layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  /* 本文目录（TOC）：宽屏右侧 sticky */
  .toc {
    display: none;
  }

  @media (min-width: 1200px) {
    .notes-layout {
      grid-template-columns: 200px minmax(0, 1fr) 240px;
      gap: 40px;
    }

    .toc {
      display: block;
      position: sticky;
      top: var(--sticky-top);
      max-height: calc(100vh - 140px);
      overflow-y: auto;
      font-size: 12.5px;
    }

    .toc-title {
      font-family: var(--mono);
      font-size: 10.5px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 12px;
    }

    .toc ul {
      list-style: none;
      margin: 0;
      padding: 0;
      border-left: 1px solid var(--border);
    }

    .toc li a {
      display: block;
      padding: 4px 0 4px 12px;
      color: var(--muted);
      line-height: 1.6;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .toc li a:hover {
      color: var(--text);
    }

    .toc li a.current {
      color: var(--accent);
    }

    /* 正文阅读宽度：46em ≈ 71 个半角 / 46 个汉字，三栏下正文占约 60% */
    .prose {
      max-width: 46em;
    }
  }

  .sidebar {
    position: sticky;
    top: var(--sticky-top);
    max-height: calc(100vh - 110px);
    overflow-y: auto;
  }

  .cat {
    margin: 22px 0 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .cat-group:first-child .cat {
    margin-top: 4px;
  }

  .sidebar a {
    display: block;
    padding: 6px 0 6px 13px;
    margin: 1px 0;
    border-left: 2px solid var(--border);
    color: var(--text-2);
    font-size: 13.5px;
    line-height: 1.6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sidebar a:hover {
    color: var(--text);
    border-left-color: var(--border-strong);
  }

  .sidebar a.current {
    color: var(--accent);
    font-weight: 500;
    border-left-color: var(--accent);
  }

  .tags {
    letter-spacing: 0.02em;
  }

  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 52px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
  }

  .pn-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .pn-box:last-child {
    text-align: right;
    align-items: flex-end;
  }

  .pn-box span {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .pn-box b {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15.5px;
    color: var(--text);
  }

  .pn-box:hover {
    border-color: var(--border-strong);
  }

  .pn-box:hover b {
    color: var(--accent);
  }

  @media (max-width: 1199px) and (min-width: 921px) {
    .prose {
      max-width: 42em;
    }
  }

  @media (max-width: 920px) {
    .notes-layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .prose {
      max-width: none;
    }

    .sidebar {
      position: static;
      max-height: none;
    }
  }
</style>
