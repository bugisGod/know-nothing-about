---
import ArticlePage from "../../components/ArticlePage.astro";
import { getNote, listNotes } from "../../lib/posts";
import { clusterColorMap } from "../../lib/galaxy-data";

export async function getStaticPaths() {
  // SSR：库中笔记即合法参数（新发布自动出现，无需构建）
  return listNotes().map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const entry: any = Astro.props.entry ?? getNote(String(Astro.params.slug));
if (!entry) return Astro.rewrite("/404");
const category = entry.id.split("/")[0];
// 域色与首页银河同源（同一份 assignClusterColors 结果）
const clusterColor = (await clusterColorMap())[`cat:${category}`];
---

<ArticlePage kind="note" entry={entry} clusterColor={clusterColor} />
