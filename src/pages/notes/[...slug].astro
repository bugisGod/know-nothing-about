---
import Base from "../../layouts/Base.astro";
import SkyBand from "../../components/SkyBand.astro";
import ArticleToc from "../../components/ArticleToc.astro";
import { SERIES, CATEGORIES } from "../../config";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  return notes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const seriesName = entry.data.series;
const peers = seriesName
  ? notes.filter((n) => n.data.series === seriesName)
  : notes;
const idx = peers.findIndex((n) => n.id === entry.id);
const newer = idx > 0 ? peers[idx - 1] : null;
const older = idx < peers.length - 1 ? peers[idx + 1] : null;
const cjkCount = (entry.body?.match(/[\u4e00-\u9fff]/g) ?? []).length;
const latinWords = (entry.body?.match(/[A-Za-z]+/g) ?? []).length;
const minutes = Math.max(1, Math.round(cjkCount / 380 + latinWords / 500));
const category = entry.id.split("/")[0];
const fmt = (date?: Date) =>
  date?.toISOString().slice(0, 10).replaceAll("-", ".") ?? "";
---

<Base
  title={entry.data.title}
  description={entry.data.description ?? entry.data.title}
>
  <SkyBand reading>
    <div class="crumbs">
      <a href="/notes/">知识库</a>
      <span> / </span>
      <a href={`/notes/?category=${encodeURIComponent(category)}`}>
        {CATEGORIES[category]?.label ?? category}
      </a>
    </div>
    <h1>{entry.data.title}</h1>
    <div class="page-meta">
      {entry.data.date && (
        <time datetime={entry.data.date.toISOString()}>
          {fmt(entry.data.date)}
        </time>
      )}
      <span>{minutes} 分钟阅读</span>
      <span>{entry.data.tags.join(" / ")}</span>
    </div>
  </SkyBand>
  <div class="container reading-container article-layout">
    <ArticleToc headings={headings} />
    <article class="prose" data-pagefind-body>
      {seriesName && (
        <div class="series-badge">
          {SERIES[seriesName]?.title ?? seriesName}
        </div>
      )}
      <Content />
      {(older || newer) && (
        <nav
          class="article-pagination"
          aria-label="相邻笔记"
          data-pagefind-ignore
        >
          {older && (
            <a href={`/notes/${older.id}/`}>
              <span>← 更早一篇</span>
              <b>{older.data.title}</b>
            </a>
          )}
          {newer && (
            <a href={`/notes/${newer.id}/`}>
              <span>更新一篇 →</span>
              <b>{newer.data.title}</b>
            </a>
          )}
        </nav>
      )}
    </article>
  </div>
</Base>
