---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const notes = await getCollection('notes', ({ data }) => !data.draft);
const catOf = (id: string) => (id.includes('/') ? id.split('/')[0] : '未分类');

const groups = new Map<string, typeof notes>();
for (const n of notes) {
  const cat = catOf(n.id);
  if (!groups.has(cat)) groups.set(cat, []);
  groups.get(cat)!.push(n);
}
for (const items of groups.values()) {
  items.sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh'));
}
const cats = [...groups.keys()].sort((a, b) => a.localeCompare(b));

const currentCat = catOf(entry.id);

const fmt = (d?: Date) =>
  d ? `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}` : '';
---

<Base title={entry.data.title} description={entry.data.description ?? entry.data.title}>
  <div class="container">
  <div class="notes-layout">
    <aside class="sidebar" aria-label="知识库目录">
      {
        [...cats].map((cat) => (
          <div class="cat-group">
            <div class="cat">{cat}</div>
            {groups.get(cat)!.map((n) => (
              <a href={`/notes/${n.id}/`} class:list={[{ current: n.id === entry.id }]}>
                {n.data.title}
              </a>
            ))}
          </div>
        ))
      }
    </aside>

    <article class="prose" data-pagefind-body>
      <div class="crumbs"><a href="/notes/">知识库</a> / {currentCat}</div>
      <h1>{entry.data.title}</h1>
      <div class="page-meta">
        {entry.data.date && <span>更新于 {fmt(entry.data.date)}</span>}
        <span class="tags">{entry.data.tags.map((t) => `#${t}`).join('  ')}</span>
      </div>
      <Content />
    </article>
  </div>
  </div>
</Base>

<style>
  .notes-layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .sidebar {
    position: sticky;
    top: 84px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
  }

  .cat {
    margin: 22px 0 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .cat-group:first-child .cat {
    margin-top: 4px;
  }

  .sidebar a {
    display: block;
    padding: 6px 0 6px 13px;
    margin: 1px 0;
    border-left: 2px solid var(--border);
    color: var(--text-2);
    font-size: 13.5px;
    line-height: 1.6;
  }

  .sidebar a:hover {
    color: var(--text);
    border-left-color: var(--border-strong);
  }

  .sidebar a.current {
    color: var(--text);
    font-weight: 500;
    border-left-color: var(--text);
  }

  .tags {
    letter-spacing: 0.02em;
  }

  @media (max-width: 920px) {
    .notes-layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .sidebar {
      position: static;
      max-height: none;
    }
  }
</style>
