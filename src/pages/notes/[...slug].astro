---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry, headings } = Astro.props;
const { Content } = await render(entry);
// 目录：只取 h2/h3，忽略代码块内的假标题
const toc = (headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);

const notes = await getCollection('notes', ({ data }) => !data.draft);
const catOf = (id: string) => (id.includes('/') ? id.split('/')[0] : '未分类');

const groups = new Map<string, typeof notes>();
for (const n of notes) {
  const cat = catOf(n.id);
  if (!groups.has(cat)) groups.set(cat, []);
  groups.get(cat)!.push(n);
}
for (const items of groups.values()) {
  items.sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh'));
}
const cats = [...groups.keys()].sort((a, b) => a.localeCompare(b));

// 上一篇/下一篇（按日期倒序：newer 为上一篇）
const sortedNotes = [...notes].sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);
const idx = sortedNotes.findIndex((n) => n.id === entry.id);
const newer = idx > 0 ? sortedNotes[idx - 1] : null;
const older = idx >= 0 && idx < sortedNotes.length - 1 ? sortedNotes[idx + 1] : null;

const currentCat = catOf(entry.id);

const fmt = (d?: Date) =>
  d ? `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}` : '';
---

<Base title={entry.data.title} description={entry.data.description ?? entry.data.title}>
  <div class="container">
  <div class="notes-layout">
    <aside class="sidebar" aria-label="知识库目录">
      {
        [...cats].map((cat) => (
          <div class="cat-group">
            <div class="cat">{cat}</div>
            {groups.get(cat)!.map((n) => (
              <a href={`/notes/${n.id}/`} class:list={[{ current: n.id === entry.id }]}>
                {n.data.title}
              </a>
            ))}
          </div>
        ))
      }
    </aside>

    {
      toc.length > 1 && (
        <aside class="toc" aria-label="本文目录">
          <div class="toc-title">目录</div>
          <ul>
            {toc.map((h) => (
              <li class:list={[`lv${h.depth}`]}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <article class="prose" data-pagefind-body>
      <div class="crumbs"><a href="/notes/">知识库</a> / {currentCat}</div>
      <h1>{entry.data.title}</h1>
      <div class="page-meta">
        {entry.data.date && <span>更新于 {fmt(entry.data.date)}</span>}
        <span class="tags">{entry.data.tags.map((t) => `#${t}`).join('  ')}</span>
      </div>
      <Content />
      <nav class="pn">
        {older ? <a class="pn-box" href={`/notes/${older.id}/`}><span>← 下一篇</span><b>{older.data.title}</b></a> : <span />}
        {newer ? <a class="pn-box" href={`/notes/${newer.id}/`}><span>上一篇 →</span><b>{newer.data.title}</b></a> : <span />}
      </nav>
    </article>
  </div>
  </div>
</Base>

<style>
  .notes-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  /* 本文目录（TOC）：宽屏右侧 sticky */
  .toc {
    display: none;
  }

  @media (min-width: 1200px) {
    .notes-layout {
      grid-template-columns: 220px minmax(0, 1fr) 200px;
      gap: 56px;
    }

    .toc {
      display: block;
      position: sticky;
      top: 96px;
      max-height: calc(100vh - 140px);
      overflow-y: auto;
      font-size: 12.5px;
    }

    .toc-title {
      font-family: var(--mono);
      font-size: 10.5px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 12px;
    }

    .toc ul {
      list-style: none;
      margin: 0;
      padding: 0;
      border-left: 1px solid var(--border);
    }

    .toc li a {
      display: block;
      padding: 4px 0 4px 12px;
      color: var(--muted);
      line-height: 1.6;
    }

    .toc li.lv3 a {
      padding-left: 26px;
    }

    .toc li a:hover {
      color: var(--text);
    }

    /* 正文阅读宽度限制：42em ≈ 38-42 个汉字 */
    .prose {
      max-width: 42em;
    }
  }

  .sidebar {
    position: sticky;
    top: 84px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
  }

  .cat {
    margin: 22px 0 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .cat-group:first-child .cat {
    margin-top: 4px;
  }

  .sidebar a {
    display: block;
    padding: 6px 0 6px 13px;
    margin: 1px 0;
    border-left: 2px solid var(--border);
    color: var(--text-2);
    font-size: 13.5px;
    line-height: 1.6;
  }

  .sidebar a:hover {
    color: var(--text);
    border-left-color: var(--border-strong);
  }

  .sidebar a.current {
    color: var(--text);
    font-weight: 500;
    border-left-color: var(--text);
  }

  .tags {
    letter-spacing: 0.02em;
  }

  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 52px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
  }

  .pn-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .pn-box:last-child {
    text-align: right;
    align-items: flex-end;
  }

  .pn-box span {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .pn-box b {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15.5px;
    color: var(--text);
  }

  .pn-box:hover {
    border-color: var(--border-strong);
  }

  .pn-box:hover b {
    color: var(--accent);
  }

  @media (max-width: 1199px) and (min-width: 921px) {
    .prose {
      max-width: 42em;
    }
  }

  @media (max-width: 920px) {
    .notes-layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .prose {
      max-width: none;
    }

    .sidebar {
      position: static;
      max-height: none;
    }
  }
</style>
