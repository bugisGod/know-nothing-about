---
// 专栏（系列）页 → 跳转到所属专题页
// 层级（用户定稿）：知识库 → 专题（= 首页星团，按目录分类）→ 专栏（专题内部的系列子集合）
// 「深入理解 AI Agent」= 学习笔记专题下的专栏，不再有独立顶级页面
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  const sids = new Set<string>();
  for (const n of notes) if (n.data.series) sids.add(n.data.series);
  return [...sids].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
// 找该系列任一文章所属分类，跳到对应专题页
const notes = await getCollection("notes", ({ data }) => !data.draft);
const one = notes.find((n) => n.data.series === slug);
const cat = one ? (one.id.includes("/") ? one.id.split("/")[0] : "ai") : "ai";
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=/notes/topic/${cat}/`} />
    <title>专栏 · 跳转中</title>
  </head>
  <body>
    <p style="font-family: sans-serif; color: #8899bb; padding: 40px">
      该专栏已归入专题，正在跳转…<a href={`/notes/topic/${cat}/`} style="color:#aabbff">手动进入</a>
    </p>
  </body>
</html>
