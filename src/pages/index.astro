---
import Base from '../layouts/Base.astro';
import BrainGraph from '../components/BrainGraph.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';

const catOf = (id: string) => (id.includes('/') ? id.split('/')[0] : '未分类');


// ===== 知识图谱数据：节点 = 文章，边 = 共享标签 / 同分类 =====
const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const allProjects = await getCollection('projects', ({ data }) => !data.draft);

const gNodes = [
  ...allNotes.map((n) => ({
    id: n.id,
    title: n.data.title,
    url: `/notes/${n.id}/`,
    kind: '笔记',
    group: catOf(n.id),
    tags: n.data.tags,
    desc: n.data.description ?? '',
  })),
  ...allProjects.map((p) => ({
    id: p.id,
    title: p.data.title,
    url: `/projects/${p.id}/`,
    kind: '项目',
    group: p.data.status,
    tags: p.data.tags.length > 0 ? p.data.tags : p.data.tech,
    desc: p.data.description,
  })),
];

const edgeMap = new Map<string, number>();
const addEdge = (a: number, b: number, w: number) => {
  if (a === b) return;
  const key = `${Math.min(a, b)}-${Math.max(a, b)}`;
  edgeMap.set(key, Math.max(edgeMap.get(key) ?? 0, w));
};
for (let i = 0; i < gNodes.length; i++)
  for (let j = i + 1; j < gNodes.length; j++) {
    const shared = gNodes[i].tags.filter((t) => gNodes[j].tags.includes(t)).length;
    if (shared > 0) addEdge(i, j, Math.min(shared, 3));
    else if (gNodes[i].kind === '笔记' && gNodes[j].kind === '笔记' && gNodes[i].group === gNodes[j].group)
      addEdge(i, j, 0.7);
  }

const gEdges = [...edgeMap.entries()].map(([key, w]) => {
  const [a, b] = key.split('-').map(Number);
  return [a, b, w] as [number, number, number];
});

---

<Base>
  <!-- 首页顶部：整块夜空（银河 + 太阳系线稿 + 星图） -->
  <section class="night">
    <i class="tw" style="top:6%;left:12%;animation:tw 2.6s ease-in-out .3s infinite alternate" />
    <i class="tw" style="top:14%;left:58%;animation:tw 3.8s ease-in-out 1.4s infinite alternate" />
    <i class="tw" style="top:9%;left:82%;animation:tw 3.1s ease-in-out 2.2s infinite alternate" />
    <i class="tw" style="top:26%;left:40%;animation:tw 2.4s ease-in-out .9s infinite alternate" />
    <i class="tw" style="top:55%;left:8%;animation:tw 4.2s ease-in-out 1.9s infinite alternate" />
    <i class="tw" style="top:68%;left:46%;animation:tw 2.9s ease-in-out 2.8s infinite alternate" />
    <i class="tw" style="top:60%;left:70%;animation:tw 3.4s ease-in-out .6s infinite alternate" />
    <i class="tw" style="top:80%;left:30%;animation:tw 2.6s ease-in-out 1.7s infinite alternate" />

    

    <div class="container">
      <section class="hero">
        <h1>{SITE.tagline}</h1>
        <p class="origin">— SCIO ME NIHIL SCIRE</p>
      </section>

      <BrainGraph nodes={gNodes} edges={gEdges} bare />
    </div>
  </section>

</Base>

<style>
  /* ===== 夜空区：Hero + 星图共处一块深空（星空基调的核心场景）===== */
  /* 无实底：透出全局深空星野（body::before 的银河），仅叠顶部微晕 */
  .night {
    margin-top: -40px; /* 抵消 main 顶边距，夜空直通页头 */
    padding: 64px 0 40px;
    background:
      radial-gradient(60% 50% at 50% 0%, rgba(96, 118, 255, 0.06), transparent 70%);
    position: relative;
    overflow: hidden;
  }

  /* 夜空无缝过渡到页面底色；页脚换成夜色发丝线 */
  :global(main.site-main) {
    padding-bottom: 24px;
  }

  :global(.site-footer) {
    border-top: 1px solid rgba(232, 230, 223, 0.08);
  }

  /* 闪烁星 */
  .tw {
    position: absolute;
    width: 1.5px;
    height: 1.5px;
    border-radius: 50%;
    background: #fff;
    animation: tw 3s ease-in-out infinite alternate;
  }

  @keyframes tw {
    from { opacity: 0.12; }
    to { opacity: 0.85; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tw { animation: none; opacity: 0.5; }
  }



  .night :global(.graph-frame) {
    border: none;
    border-radius: 0;
    background: transparent;
    height: 540px;
    margin-inline: calc(50% - 50vw); /* 星空铺满整屏宽 */
  }

  .night :global(.graph-caption) {
    max-width: 932px;
    margin-inline: auto;
  }

  /* ===== Hero：名言即主角 ===== */
  .hero {
    padding: 88px 0 0;
    text-align: center;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(40px, 5.5vw, 58px);
    line-height: 1.22;
    margin: 0 auto 20px;
    max-width: 18ch;
    text-wrap: balance;
    color: var(--text);
  }

  .origin {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.28em;
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 640px) {
    .night {
      padding-top: 40px;
    }
    .hero {
      padding-top: 48px;
    }
  }
</style>
