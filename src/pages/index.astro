---
import Base from "../layouts/Base.astro";
import StarMap from "../components/StarMap.astro";
import { getCollection } from "astro:content";
import { SITE, CATEGORIES } from "../config";
const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const categories = [...new Set(notes.map((n) => n.id.split("/")[0]))].sort();
const domains = categories.map((id) => ({
  id,
  title: CATEGORIES[id]?.label ?? id,
  url: `/notes/?category=${encodeURIComponent(id)}`,
  entries: notes
    .filter((n) => n.id.split("/")[0] === id)
    .map((n) => ({ title: n.data.title, url: `/notes/${n.id}/` })),
}));
if (projects.length)
  domains.push({
    id: "projects",
    title: "项目",
    url: "/projects/",
    entries: projects.map((p) => ({
      title: p.data.title,
      url: `/projects/${p.id}/`,
    })),
  });
const fmt = (date?: Date) =>
  date?.toISOString().slice(0, 10).replaceAll("-", ".") ?? "";
---

<Base home>
  <section class="observatory container" aria-label="知识星图">
    <div class="hero">
      <h1>{SITE.tagline}</h1>
      <p class="origin">SCIO ME NIHIL SCIRE</p>
    </div>
    <StarMap domains={domains} />
  </section>
  {notes.length > 0 && (
    <section class="recent container" aria-labelledby="recent-title">
      <div class="section-heading">
        <h2 id="recent-title">最近记录</h2>
        <a href="/notes/">
          全部笔记 <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="recent-list">
        {notes.slice(0, 3).map((n) => (
          <a href={`/notes/${n.id}/`}>
            <span>{n.data.title}</span>
            <time datetime={n.data.date?.toISOString()}>
              {fmt(n.data.date)}
            </time>
            <span class="row-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>
<style>
  .observatory {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    min-height: min(680px, 76svh);
    gap: 24px;
    padding-top: 44px;
    padding-bottom: 44px;
  }
  .hero {
    padding: 0 0 60px 32px;
  }
  h1 {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(48px, 5.4vw, 78px);
    font-weight: 400;
    line-height: 1.08;
    max-width: 12ch;
    margin: 0 0 30px;
    text-wrap: balance;
    letter-spacing: -0.025em;
  }
  .origin {
    font: 10px var(--mono);
    letter-spacing: 0.25em;
    color: var(--muted);
    margin: 0;
  }
  .recent {
    max-width: 900px;
    padding-bottom: 64px;
  }
  .recent-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 12px;
    gap: 24px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }
  .recent-list a:last-child {
    border-bottom: 0;
  }
  .recent-list a:hover {
    color: var(--accent);
  }
  .recent-list time {
    font: 11px var(--mono);
    color: var(--muted);
  }
  .row-arrow {
    font-size: 13px;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .observatory {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 6px;
      padding-top: 52px;
      padding-bottom: 24px;
    }
    .hero {
      padding: 0 12px;
    }
    h1 {
      font-size: clamp(42px, 9vw, 60px);
      max-width: 17ch;
      margin-bottom: 20px;
    }
    .origin {
      font-size: 9px;
      letter-spacing: 0.2em;
    }
    .recent {
      padding-bottom: 32px;
    }
    .recent-list a {
      gap: 12px;
      font-size: 14px;
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .recent-list time {
      font-size: 10px;
    }
    .row-arrow {
      display: none;
    }
  }
</style>
