---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BrainGraph from '../components/BrainGraph.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../config';

const catOf = (id: string) => (id.includes('/') ? id.split('/')[0] : '未分类');


// ===== 知识图谱数据：节点 = 文章，边 = 共享标签 / 同分类 =====
const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const allProjects = await getCollection('projects', ({ data }) => !data.draft);

const gNodes = [
  ...allNotes.map((n) => ({
    id: n.id,
    title: n.data.title,
    url: `/notes/${n.id}/`,
    kind: '笔记',
    group: catOf(n.id),
    tags: n.data.tags,
    desc: n.data.description ?? '',
  })),
  ...allProjects.map((p) => ({
    id: p.id,
    title: p.data.title,
    url: `/projects/${p.id}/`,
    kind: '项目',
    group: p.data.status,
    tags: p.data.tags.length > 0 ? p.data.tags : p.data.tech,
    desc: p.data.description,
  })),
];

const edgeMap = new Map<string, number>();
const addEdge = (a: number, b: number, w: number) => {
  if (a === b) return;
  const key = `${Math.min(a, b)}-${Math.max(a, b)}`;
  edgeMap.set(key, Math.max(edgeMap.get(key) ?? 0, w));
};
for (let i = 0; i < gNodes.length; i++)
  for (let j = i + 1; j < gNodes.length; j++) {
    const shared = gNodes[i].tags.filter((t) => gNodes[j].tags.includes(t)).length;
    if (shared > 0) addEdge(i, j, Math.min(shared, 3));
    else if (gNodes[i].kind === '笔记' && gNodes[j].kind === '笔记' && gNodes[i].group === gNodes[j].group)
      addEdge(i, j, 0.7);
  }

const gEdges = [...edgeMap.entries()].map(([key, w]) => {
  const [a, b] = key.split('-').map(Number);
  return [a, b, w] as [number, number, number];
});

---

<Base>
  <!-- 首页顶部：整块夜空（银河 + 太阳系线稿 + 星图） -->
  <section class="night">
    <i class="tw" style="top:6%;left:12%;animation-delay:.4s" />
    <i class="tw" style="top:14%;left:58%;animation-delay:.4s" />
    <i class="tw" style="top:9%;left:82%;animation-delay:.4s" />
    <i class="tw" style="top:26%;left:40%;animation-delay:.4s" />
    <i class="tw" style="top:55%;left:8%;animation-delay:.4s" />
    <i class="tw" style="top:68%;left:46%;animation-delay:.4s" />
    <i class="tw" style="top:60%;left:70%;animation-delay:.4s" />
    <i class="tw" style="top:80%;left:30%;animation-delay:.4s" />

    

    <div class="container">
      <section class="hero">
        <h1>{SITE.author}<span class="hero-dot" aria-hidden="true">.</span></h1>
        <p class="lede">{SITE.tagline}</p>
        <div class="socials">
          {
            SITE.socials.map((s) => (
              <a
                class="social-link"
                href={s.url}
                target={s.url.startsWith('http') ? '_blank' : undefined}
                rel="noopener"
                aria-label={s.label}
                title={s.label}
              >
                <Icon name={s.icon} size={16} />
              </a>
            ))
          }
        </div>
      </section>

      <BrainGraph nodes={gNodes} edges={gEdges} bare />
    </div>
  </section>

</Base>

<style>
  /* ===== 夜空区：Hero + 星图共处一块深空（星空基调的核心场景）===== */
  .night {
    margin-top: -40px; /* 抵消 main 顶边距，夜空直通页头 */
    padding: 64px 0 40px;
    background:
      radial-gradient(1.5px 1.5px at 12% 16%, rgba(255, 255, 255, 0.6), transparent 100%),
      radial-gradient(1px 1px at 30% 38%, rgba(255, 255, 255, 0.4), transparent 100%),
      radial-gradient(1px 1px at 52% 10%, rgba(255, 255, 255, 0.45), transparent 100%),
      radial-gradient(1.5px 1.5px at 68% 52%, rgba(255, 255, 255, 0.5), transparent 100%),
      radial-gradient(1px 1px at 84% 24%, rgba(255, 255, 255, 0.4), transparent 100%),
      radial-gradient(1px 1px at 22% 66%, rgba(255, 255, 255, 0.3), transparent 100%),
      radial-gradient(1.5px 1.5px at 90% 80%, rgba(255, 255, 255, 0.35), transparent 100%),
      radial-gradient(60% 50% at 50% 0%, rgba(96, 118, 255, 0.06), transparent 70%),
      linear-gradient(to bottom, #10121e 0%, #0c0d17 45%, #0b0c12 85%);
    position: relative;
    overflow: hidden;
  }

  /* 夜空无缝过渡到页面底色；页脚换成夜色发丝线 */
  :global(main.site-main) {
    padding-bottom: 24px;
  }

  :global(.site-footer) {
    border-top: 1px solid rgba(232, 230, 223, 0.08);
  }

  /* 闪烁星 */
  .tw {
    position: absolute;
    width: 1.5px;
    height: 1.5px;
    border-radius: 50%;
    background: #fff;
    animation: tw 3s ease-in-out infinite alternate;
  }

  @keyframes tw {
    from { opacity: 0.12; }
    to { opacity: 0.85; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tw { animation: none; opacity: 0.5; }
  }



  .night :global(.graph-frame) {
    border: none;
    border-radius: 0;
    background: transparent;
    height: 540px;
    margin-inline: calc(50% - 50vw); /* 星空铺满整屏宽 */
  }

  .night :global(.graph-caption) {
    max-width: 932px;
    margin-inline: auto;
  }

  /* ===== Hero：居中海报式 ===== */
  .hero {
    padding: 48px 0 0;
    text-align: center;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(58px, 8.5vw, 88px);
    letter-spacing: -0.005em;
    line-height: 1.1;
    margin: 0 0 20px;
  }

  .hero-dot {
    color: var(--accent);
  }

  .lede {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(19px, 2.6vw, 23px);
    letter-spacing: 0.02em;
    color: var(--text-2);
    margin: 0 0 30px;
    text-wrap: balance;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
  }

  .social-link {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--text-2);
  }

  .social-link:hover {
    color: var(--text);
    background: var(--wash, rgba(255, 255, 255, 0.06));
  }

  @media (max-width: 640px) {
    .night {
      padding-top: 40px;
    }
    .hero {
      padding-top: 24px;
    }
  }
</style>
