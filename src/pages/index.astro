---
import Base from '../layouts/Base.astro';
import BrainGraph from '../components/BrainGraph.astro';
import { getCollection } from 'astro:content';
import { SITE, SERIES, CATEGORIES } from '../config';

const catOf = (id: string) => (id.includes('/') ? id.split('/')[0] : '未分类');

// ===== 知识星图：节点 = 锚星（系列/分类星域中心）+ 文章星，边 = 归属 / 共享标签 =====
// 同系列的文章向锚星凝聚成星座；文章越多，星座越大、星域越多
const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const allProjects = await getCollection('projects', ({ data }) => !data.draft);

type GNode = {
  id: string; title: string; url: string; kind: string; group: string;
  tags: string[]; desc: string; anchor?: boolean; color?: string; count?: number;
  parent?: number;
};

const gNodes: GNode[] = [];
const gEdges: [number, number, number][] = [];
const edgeMap = new Map<string, number>();
const addEdge = (a: number, b: number, w: number) => {
  if (a === b) return;
  const key = `${Math.min(a, b)}-${Math.max(a, b)}`;
  edgeMap.set(key, Math.max(edgeMap.get(key) ?? 0, w));
};

// 锚星索引：系列优先，无系列的文章归到分类锚星
const anchorOf = new Map<string, number>();
const ensureAnchor = (key: string, title: string, color?: string) => {
  let idx = anchorOf.get(key);
  if (idx === undefined) {
    idx = gNodes.length;
    anchorOf.set(key, idx);
    gNodes.push({
      id: `anchor:${key}`, title, url: '', kind: '星域', group: title,
      tags: [], desc: title, anchor: true, color, count: 0,
    });
  }
  return idx;
};

for (const n of allNotes) {
  const series = n.data.series;
  const cat = catOf(n.id);
  const domainColor = series
    ? SERIES[series]?.color ?? CATEGORIES[cat]?.color
    : CATEGORIES[cat]?.color;
  const anchorTitle = series ? (SERIES[series]?.title ?? series) : (CATEGORIES[cat]?.label ?? cat);
  const aIdx = ensureAnchor(series ? `series:${series}` : `cat:${cat}`, anchorTitle, domainColor);
  const i = gNodes.length;
  gNodes.push({
    id: n.id, title: n.data.title, url: `/notes/${n.id}/`, kind: '笔记',
    group: anchorTitle, tags: n.data.tags, desc: n.data.description ?? '',
    color: domainColor, parent: aIdx,
  });
  gNodes[aIdx].count!++;
  addEdge(aIdx, i, 2.2); // 归属边：把成员星拉向锚星
}

for (const p of allProjects) {
  gNodes.push({
    id: p.id, title: p.data.title, url: `/projects/${p.id}/`, kind: '项目',
    group: p.data.status, tags: p.data.tags.length > 0 ? p.data.tags : p.data.tech,
    desc: p.data.description,
  });
}

// 共享标签的连线（跨星域的引力）
for (let i = 0; i < gNodes.length; i++) {
  if (gNodes[i].anchor) continue;
  for (let j = i + 1; j < gNodes.length; j++) {
    if (gNodes[j].anchor) continue;
    const shared = gNodes[i].tags.filter((t) => gNodes[j].tags.includes(t)).length;
    if (shared > 0) addEdge(i, j, Math.min(shared, 2));
  }
}

gEdges.push(...[...edgeMap.entries()].map(([key, w]) => {
  const [a, b] = key.split('-').map(Number);
  return [a, b, w] as [number, number, number];
}));

// 列表视图数据：按星域（锚星）分组的文章清单，与星图同源
const domainsData = gNodes
  .filter((n) => n.anchor)
  .map((a) => ({
    title: a.title,
    entries: gNodes
      .filter((n) => !n.anchor && n.parent === gNodes.indexOf(a))
      .map((n) => ({ title: n.title, url: n.url })),
  }));
// 游离星（项目等，无锚星归属）归入「项目」组
const freeNodes = gNodes.filter((n) => !n.anchor && n.parent === undefined);
if (freeNodes.length)
  domainsData.push({
    title: '项目',
    entries: freeNodes.map((n) => ({ title: n.title, url: n.url })),
  });
---

<Base>
  <!-- 首页顶部：整块夜空（银河 + 星图）。星层克制：全站仅星图 + 远景星野两层 -->
  <section class="night">
    <div class="container">
      <section class="hero">
        <h1>{SITE.tagline}</h1>
        <p class="origin">— SCIO ME NIHIL SCIRE</p>
      </section>

      <div class="view-switch" role="group" aria-label="浏览方式">
        <button type="button" data-view="map" aria-pressed="true">星图</button>
        <span aria-hidden="true">/</span>
        <button type="button" data-view="list" aria-pressed="false">列表</button>
      </div>

      <BrainGraph
        nodes={gNodes}
        edges={gEdges}
        bare
        caption={`已点亮 ${gNodes.filter((n) => !n.anchor).length} 颗 · 余下皆是未知`}
        captionHint="拖拽旋转 · 点击星体进入"
      />

      <!-- 列表视图：按星域分组的全部文章（与星图同一份数据） -->
      <div class="domain-index" hidden>
        {domainsData.map((d) => (
          <section class="di-group">
            <h2 class="di-title">{d.title}<small>{d.entries.length}</small></h2>
            <ul>
              {d.entries.map((e) => (
                <li><a href={e.url}>{e.title}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

</Base>

<script>
  // 星图 / 列表视图切换（借鉴新版首页的浏览模式）
  const night = document.querySelector<HTMLElement>('.night');
  if (night) {
    const graphSec = night.querySelector<HTMLElement>('#graph');
    const domainIndex = night.querySelector<HTMLElement>('.domain-index');
    const buttons = night.querySelectorAll<HTMLButtonElement>('.view-switch [data-view]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const map = btn.dataset.view === 'map';
        if (graphSec) graphSec.hidden = !map; // 星图：map 视图显示
        if (domainIndex) domainIndex.hidden = map; // 列表：map 视图隐藏
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      }),
    );
  }
</script>

<style>
  /* ===== 夜空区：Hero + 星图共处一块深空（星空基调的核心场景）===== */
  /* 无实底：透出全局深空星野（body::before 的银河），仅叠顶部微晕 */
  .night {
    margin-top: -40px; /* 抵消 main 顶边距，夜空直通页头 */
    padding: 64px 0 40px;
    background:
      radial-gradient(60% 50% at 50% 0%, rgba(96, 118, 255, 0.06), transparent 70%);
    position: relative;
    overflow: hidden;
  }

  /* 夜空无缝过渡到页面底色；页脚换成夜色发丝线 */
  :global(main.site-main) {
    padding-bottom: 24px;
  }

  :global(.site-footer) {
    border-top: 1px solid rgba(232, 230, 223, 0.08);
  }

  .night :global(.graph-frame) {
    border: none;
    border-radius: 0;
    background: transparent;
    height: 540px;
    margin-top: 0; /* 星图贴紧 hero，页眉与星群之间不留空档 */
    margin-inline: calc(50% - 50vw); /* 星空铺满整屏宽 */
  }

  .night :global(.graph-sec) {
    margin-top: 16px;
  }

  .night :global(.graph-caption) {
    max-width: 932px;
    margin-inline: auto;
  }

  /* ===== Hero：名言即主角 ===== */
  .hero {
    padding: 88px 0 0;
    text-align: center;
  }

  .hero h1 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(34px, 5.5vw, 58px);
    line-height: 1.22;
    margin: 0 auto 14px;
    max-width: none;
    text-wrap: balance;
    color: var(--text);
  }

  .origin {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.28em;
    color: var(--muted);
    margin: 0;
  }

  /* ===== 星图 / 列表切换（借鉴新版）===== */
  .view-switch {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    margin: 26px 20px 0;
    font-size: 11px;
    color: var(--muted);
  }

  .view-switch button {
    background: none;
    border: 0;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
    padding: 6px 4px;
  }

  .view-switch button:hover {
    color: var(--text);
  }

  .view-switch button[aria-pressed='true'] {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  .domain-index {
    max-width: 720px;
    margin: 30px auto 0;
    padding: 0 20px;
  }

  .di-group {
    margin-bottom: 34px;
  }

  .di-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.04em;
    color: var(--text);
    margin: 0 0 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .di-title small {
    font: 10px var(--mono);
    color: var(--muted);
    margin-left: 10px;
    letter-spacing: 0.1em;
  }

  .di-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .di-group a {
    display: block;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13.5px;
    color: var(--text-2);
    line-height: 1.6;
  }

  .di-group a:hover {
    color: var(--accent);
  }

  .domain-index[hidden],
  .night :global(.graph-sec[hidden]) {
    display: none;
  }

  @media (max-width: 640px) {
    .view-switch {
      margin-top: 14px;
    }
  }

  @media (max-width: 640px) {
    .night {
      padding-top: 40px;
    }
    .hero {
      padding-top: 48px;
    }
  }
</style>
