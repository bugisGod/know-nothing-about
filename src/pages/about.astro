---
import Base from '../layouts/Base.astro';
import SkyBand from '../components/SkyBand.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';

const facts = SITE.bio.split('\n');
---

<Base title="关于" description={`关于 ${SITE.author} 与这个站点`}>
  <SkyBand reading>
    <h1>关于</h1>
  </SkyBand>
  <div class="container reading-container about-body">

    <!-- 名片：这个人是谁（头像 + 签名 + 社交入口） -->
    <section class="idcard" aria-label="个人信息">
      <img class="avatar" src="/avatar.svg" alt="" width="48" height="48" />
      <div class="id-main">
        <p class="id-name">{SITE.author}<span class="id-dot">.</span></p>
        <p class="id-tag">{SITE.tagline}</p>
      </div>
      <div class="id-social">
        {
          SITE.socials.map((s) => (
            <a
              href={s.url}
              target={s.url.startsWith('http') ? '_blank' : undefined}
              rel="noopener"
              aria-label={s.label}
              title={s.label}
            >
              <Icon name={s.icon} size={15} />
            </a>
          ))
        }
      </div>
    </section>
    <ul class="facts">
      {facts.map((f) => <li>{f}</li>)}
    </ul>

    <!-- 散文区：导语放大直接开场，不加节标题 -->
    <section class="essay">
      <p class="lede">
        五六年，回头看时如白驹过隙——你还站在原地，它已经跑完了。
      </p>
      <p>
        我时常在某个瞬间突然惊醒：可能是深夜下班的路上，可能是编译跑到一半盯着屏幕发呆的时候。
        会觉得光阴虚度，心里一紧——想抓住些什么，环顾四周，又仿佛什么都抓不住。
      </p>
      <figure class="quote">
        <span class="q-star" aria-hidden="true">✦</span>
        <blockquote>
          <p>当他回首往事的时候，不因虚度年华而悔恨，也不因碌碌无为而羞愧。</p>
        </blockquote>
        <figcaption>—— 尼古拉·奥斯特洛夫斯基《钢铁是怎样炼成的》</figcaption>
      </figure>
      <p>
        担心是常有的：担心技术迭代太快，担心积累得太慢，担心多年以后再回望，依然两手空空。
        迷茫也是常有的：不知道脚下的路通向哪里，不知道此刻的坚持，最后值不值得。
      </p>
      <p>
        后来慢慢想明白：时间本来就抓不住，能抓住的只有记录。
        与其焦虑地张望，不如把当下过好——学会的东西写下来，踩过的坑记下来，做过的东西存起来。
      </p>
      <p>
        就从这个网站开始吧。做好记录，做好当下。
        希望某天再回望时，这些零散的星星能连成一片；
        也希望心里的迷茫，能一天比一天少一点。
      </p>
    </section>

    <!-- 关于本站：词源单独成块，与首页名言互为首尾 -->
    <section class="siteinfo">
      <h2 class="sec-title">关于本站<span class="sec-dot">.</span></h2>
      <div class="ety">
        <p class="ety-latin">Scio me nihil scire.</p>
        <p class="ety-zh">我知道我一无所知。</p>
      </div>
      <p>
        这里是我的第二大脑：笔记按主题汇入星图，在探索中慢慢连成自己的知识脉络。
        由 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 构建，
        托管在自己的服务器上。
      </p>
    </section>
  </div>
</Base>

<style>
  .about-body > * { max-width: 720px; }
  /* ===== 名片 ===== */
  .idcard {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
  }

  .avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
  }

  .id-name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 22px;
    letter-spacing: 0.01em;
    color: var(--text);
    margin: 0;
  }

  .id-dot {
    color: var(--accent);
  }

  .id-tag {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin: 4px 0 0;
  }

  .id-social {
    margin-left: auto;
    display: flex;
    gap: 8px;
  }

  .id-social a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--border);
    color: var(--muted);
  }

  .id-social a:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  /* 事实行：星点做记号，与名片左对齐（头像 48 + 间距 16） */
  .facts {
    list-style: none;
    margin: 16px 0 0;
    padding: 0 0 0 64px;
  }

  .facts li {
    position: relative;
    padding-left: 18px;
    color: var(--text-2);
    font-size: 14px;
    line-height: 2;
  }

  .facts li::before {
    content: '✦';
    position: absolute;
    left: 0;
    top: 0;
    font-size: 9px;
    line-height: 3.2;
    color: var(--accent);
    opacity: 0.7;
  }

  /* ===== 节标题：衬线 + 琥珀句点，与页头「关于.」同一语言 ===== */
  .essay,
  .siteinfo {
    margin-top: 68px;
    max-width: 38em;
  }

  .sec-title {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--text);
    margin: 0 0 26px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .sec-dot {
    color: var(--accent);
  }

  /* ===== 散文 ===== */
  .essay p,
  .siteinfo p {
    font-size: 15.5px;
    line-height: 2.05;
    color: var(--text);
    margin: 1.3em 0;
  }

  .essay .lede {
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.8;
  }

  /* 引用：全页情绪高点，居中 + 衬线 + 小星点 */
  .quote {
    margin: 3em 0;
    text-align: center;
  }

  .q-star {
    color: var(--accent);
    font-size: 11px;
    opacity: 0.8;
  }

  .quote blockquote {
    margin: 16px 0 0;
    padding: 0;
    border: none;
    font-family: var(--font-display);
    font-size: 20px;
    line-height: 1.9;
    color: var(--text);
  }

  .quote figcaption {
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  /* ===== 词源块 ===== */
  .ety {
    text-align: center;
    margin: 2.6em 0;
  }

  .ety-latin {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 30px;
    letter-spacing: 0.01em;
    color: var(--text);
    margin: 0;
  }

  .ety-zh {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.24em;
    color: var(--muted);
    margin: 10px 0 0;
  }

  .siteinfo a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }

  .siteinfo a:hover {
    text-decoration-color: var(--text);
  }

  @media (max-width: 640px) {
    .idcard {
      flex-wrap: wrap;
    }

    .id-social {
      margin-left: 64px; /* 与名字左对齐（头像 48 + 间距 16） */
    }

    .id-tag {
      letter-spacing: 0.12em;
    }

    .facts {
      padding-left: 0;
    }

    .ety-latin {
      font-size: 24px;
    }
  }
</style>
