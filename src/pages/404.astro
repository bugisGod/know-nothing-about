---
import Base from '../layouts/Base.astro';
---

<Base title="404">
  <div class="container">
    <div class="notfound">
      <p class="code">404</p>
      <p class="hint">这个页面还不存在——也许正是该写篇笔记的时候。</p>
      <a href="/">← 回到首页</a>
    </div>
  </div>
</Base>

<style>
  .notfound {
    text-align: center;
    padding: 120px 0;
  }

  .code {
    font-family: var(--font-display);
    font-size: 96px;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--border-strong);
    margin: 0 0 20px;
  }

  .hint {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 34px;
    text-wrap: balance;
  }

  .notfound a {
    color: var(--text-2);
    font-size: 14px;
  }

  .notfound a:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
